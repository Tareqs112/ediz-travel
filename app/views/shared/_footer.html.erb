<!-- Global Footer -->
<footer class="bg-brand-charcoal-900 text-white mt-auto">
  <div class="container-main py-10 md:py-14 lg:py-16">

    <%# Top: Brand + Link Columns %>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 lg:gap-12">

      <%# Brand — spans 2 cols on mobile, full first col on lg %>
      <div class="col-span-2 lg:col-span-2 mb-4 md:mb-0">
        <%= link_to root_path, class: "block mb-4" do %>
          <%= image_tag "ediz-travel-logo.png", alt: "61 EDİZ TRAVEL", class: "h-10 md:h-14 w-auto object-contain" %>
        <% end %>
        <p class="text-sm text-white/60 mb-5 max-w-xs leading-relaxed font-light">
          <%= t("footer.tagline") %>
        </p>
        <div class="inline-flex items-center gap-3 text-sm">
          <svg class="w-5 h-5 text-brand-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          <div>
            <span class="text-white/80 font-medium"><%= t("common.tursab_licensed") %></span>
            <span class="text-white/50 mx-1">·</span>
            <span class="text-white/70"><%= current_business_setting&.tursab_number.presence || t("common.tursab_document_no") %></span>
          </div>
        </div>
      </div>

      <%# Explore %>
      <div>
        <h3 class="text-sm font-semibold mb-4 text-white/90 uppercase tracking-wider"><%= t("footer.explore") %></h3>
        <ul class="space-y-2.5 text-sm">
          <li><%= link_to t("nav.tours"), tours_path, class: "text-white/60 hover:text-white transition-colors" %></li>
          <li><%= link_to t("nav.services"), services_path, class: "text-white/60 hover:text-white transition-colors" %></li>
          <li><%= link_to t("nav.travel_guide"), travel_guides_path, class: "text-white/60 hover:text-white transition-colors" %></li>
        </ul>
      </div>

      <%# Services %>
      <div>
        <h3 class="text-sm font-semibold mb-4 text-white/90 uppercase tracking-wider"><%= t("footer.services") %></h3>
        <ul class="space-y-2.5 text-sm">
          <li><%= link_to t("services.airport_transfer"), airport_transfer_path, class: "text-white/60 hover:text-white transition-colors" %></li>
          <li><%= link_to t("services.car_rental"), car_rental_path, class: "text-white/60 hover:text-white transition-colors" %></li>
          <li><%= link_to t("services.chauffeured_car"), chauffeured_car_path, class: "text-white/60 hover:text-white transition-colors" %></li>
          <li><%= link_to t("services.accommodation"), accommodations_path, class: "text-white/60 hover:text-white transition-colors" %></li>
        </ul>
      </div>

      <%# Company %>
      <div>
        <h3 class="text-sm font-semibold mb-4 text-white/90 uppercase tracking-wider"><%= t("footer.company") %></h3>
        <ul class="space-y-2.5 text-sm">
          <li><%= link_to t("footer.about_us"), about_path, class: "text-white/60 hover:text-white transition-colors" %></li>
          <li><%= link_to t("footer.contact"), contact_path, class: "text-white/60 hover:text-white transition-colors" %></li>
          <li><%= link_to t("footer.faq"), faq_path, class: "text-white/60 hover:text-white transition-colors" %></li>
        </ul>
      </div>

    </div>

    <%# Bottom bar %>
    <div class="border-t border-white/10 mt-10 pt-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-3 text-xs text-white/40">
      <p>&copy; <%= Time.current.year %> 61 EDİZ TRAVEL · <%= current_business_setting&.company_name.presence || "LAZ TUR TURİZM İNŞAAT TİCARET LİMİTED ŞİRKETİ." %></p>
      <p><%= current_business_setting&.address.presence || t("footer.location") %></p>
    </div>
  </div>
</footer>
