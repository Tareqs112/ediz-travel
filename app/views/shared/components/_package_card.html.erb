<div class="snap-start flex-none w-[85%] sm:w-[60%] md:w-auto h-auto">
  <div class="group flex flex-col h-full border border-brand-gray-200/60 p-4">
    <div class="relative w-full aspect-[16/9] md:aspect-[4/3] bg-brand-gray-100 overflow-hidden mb-6 flex items-center justify-center border border-brand-gray-200/50">
      <% if package.image.attached? %>
        <%= image_tag package.image, alt: package.title, loading: "lazy", class: "absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" %>
      <% else %>
        <div class="text-brand-gray-300 flex flex-col items-center">
          <svg class="w-10 h-10 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
        </div>
      <% end %>
    </div>
    <div class="flex-grow flex flex-col">
      <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-2"><%= package.duration %></span>
      <h3 class="text-lg md:text-2xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= package.title %></h3>
      <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm mb-6 line-clamp-3">
        <%= package.short_description.presence || package.description.to_s.truncate(100) %>
      </p>
      <div class="mt-auto pt-4 border-t border-brand-gray-200/60">
        <%= link_to package_path(package), class: "inline-block font-medium text-brand-charcoal-900 hover:text-brand-green-700 transition-colors uppercase tracking-widest text-sm" do %>
          <%= t("packages.card.view_package") %> <span class="inline-block rtl:rotate-180">&rarr;</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
