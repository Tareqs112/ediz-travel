<div class="w-full py-20 border border-brand-gray-200/60 bg-[#faf9f6] flex flex-col items-center justify-center text-center px-4">
  <span class="text-brand-gray-400 mb-4">
    <%= icon if local_assigns[:icon] %>
    <% unless local_assigns[:icon] %>
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
      </svg>
    <% end %>
  </span>
  <h3 class="text-xl font-medium text-brand-charcoal-900 mb-2"><%= title %></h3>
  <p class="text-brand-charcoal-600 font-light max-w-md mb-6"><%= message %></p>
  
  <% if local_assigns[:action_text] && local_assigns[:action_path] %>
    <%= link_to action_text, action_path, class: "inline-block px-8 py-3 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors" %>
  <% end %>
</div>
