<%= link_to tour_path(tour), class: "group flex flex-col h-full border border-brand-gray-200/60 hover:border-brand-gold-400 transition-colors duration-300 bg-white" do %>
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-charcoal-50">
    <% if tour.image.attached? && tour.image.variable? %>
      <%= image_tag tour.image.variant(resize_to_fill: [800, 600], format: :webp),
          class: "w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700",
          alt: tour.title, loading: "lazy" %>
    <% else %>
      <div class="w-full h-full flex flex-col items-center justify-center text-brand-gray-300 transition-transform duration-700 group-hover:scale-[1.03]">
        <svg class="w-6 h-6 md:w-8 md:h-8 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
      </div>
    <% end %>

    <div class="absolute top-2 start-2 md:top-3 md:start-3 bg-white/90 backdrop-blur px-1.5 py-0.5 md:px-2.5 md:py-1 text-[9px] md:text-[10px] font-semibold tracking-wider uppercase text-brand-charcoal-700 shadow-sm">
      <% if tour.tour_type.present? %>
        <%= tour.tour_type %>
      <% else %>
        <%= t("tours.card.private", default: "Private") %>
      <% end %>
    </div>
    
    <% if tour.featured? %>
      <div class="absolute top-2 end-2 md:top-3 md:end-3 bg-brand-gold-500 text-white px-1.5 py-0.5 md:px-2.5 md:py-1 text-[9px] md:text-[10px] font-semibold tracking-wider uppercase shadow-sm flex items-center gap-1">
        <svg class="w-2.5 h-2.5 md:w-3 md:h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span class="hidden sm:inline"><%= t("tours.card.featured", default: "Featured") %></span>
      </div>
    <% end %>
  </div>
  
  <div class="p-3 md:p-6 flex flex-col flex-grow">
    <% if tour.destination.present? %>
      <span class="text-[9px] md:text-[10px] font-bold text-brand-gold-500 uppercase tracking-[0.15em] block mb-1.5 md:mb-2"><%= tour.destination.name %></span>
    <% end %>
    
    <h3 class="text-sm md:text-lg font-medium text-brand-charcoal-900 mb-0 md:mb-3 group-hover:text-brand-green-700 transition-colors line-clamp-2 md:line-clamp-2 leading-snug"><%= tour.title %></h3>
    
    <p class="hidden md:block text-sm text-brand-charcoal-600 font-light leading-relaxed mb-4 flex-grow line-clamp-2">
      <%= tour.description.sub(/\A\[DEVELOPMENT PLACEHOLDER\]\s*/, "") %>
    </p>

    <div class="mt-2 md:mt-auto pt-2 md:pt-4 flex flex-row flex-wrap gap-x-2 gap-y-1 items-center justify-between border-t border-brand-gray-100">
      <% if tour.duration.present? %>
        <span class="text-[10px] md:text-sm text-brand-charcoal-600 flex items-center gap-1 md:gap-1.5">
          <svg class="w-3 h-3 md:w-4 md:h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <%= tour.duration %>
        </span>
      <% else %>
        <span></span>
      <% end %>
      
      <% if tour.price_from.present? && tour.price_from > 0 %>
        <div class="text-end">
          <span class="text-[9px] md:text-[11px] text-brand-charcoal-500 block leading-none mb-0.5"><%= t("tours.card.from", default: "From") %></span>
          <span class="text-[11px] md:text-sm font-semibold text-brand-charcoal-900"><%= number_to_currency(tour.price_from, unit: tour.currency.present? ? tour.currency + " " : "$", precision: 0) %></span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
