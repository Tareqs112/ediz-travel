<div class="group flex flex-col h-full bg-white overflow-hidden shadow-sm hover:shadow-md border border-brand-gray-200/50 hover:border-brand-gray-300 transition-all duration-300">
  <!-- Image Area -->
  <div class="relative w-full aspect-[16/10] bg-[#faf9f6] overflow-hidden border-b border-brand-gray-100">
    <% if tour.image.attached? %>
      <%= image_tag tour.image, alt: tour.title, loading: "lazy", class: "w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" %>
    <% else %>
      <!-- Tasteful neutral placeholder -->
      <div class="w-full h-full flex flex-col items-center justify-center text-brand-gray-300 transition-transform duration-700 group-hover:scale-105">
        <svg class="w-8 h-8 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
      </div>
    <% end %>
  </div>

  <!-- Content Area -->
  <div class="p-4 md:p-8 flex flex-col flex-grow">
    <div class="mb-3">
      <span class="text-[10px] font-bold text-brand-gold-500 uppercase tracking-[0.15em] block mb-2"><%= tour.destination&.name %></span>
      <h3 class="text-lg md:text-2xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors duration-300 leading-tight"><%= tour.title %></h3>
    </div>
    
    <p class="text-sm md:text-base text-brand-charcoal-600 font-light leading-relaxed mb-4 md:mb-6 flex-grow line-clamp-3">
      <%= tour.description.sub(/\A\[DEVELOPMENT PLACEHOLDER\]\s*/, "") %>
    </p>
    
    <div class="mt-auto pt-4 md:pt-5 border-t border-brand-gray-100 flex items-center justify-between">
      <% if tour.price_from.present? %>
        <div class="flex flex-col">
          <span class="text-[10px] text-brand-charcoal-500 uppercase tracking-wider">From</span>
          <span class="font-medium text-brand-charcoal-900 text-sm"><%= number_to_currency(tour.price_from, unit: tour.currency.present? ? tour.currency + " " : "$", precision: 0) %></span>
        </div>
      <% end %>
      <div class="flex items-center ml-auto">
        <%= link_to tour_path(tour), class: "inline-flex items-center text-xs font-semibold text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors uppercase tracking-widest" do %>
          <%= t("tours.card.explore_tour") %>
        <% end %>
        <span class="text-brand-gold-500 transition-transform duration-300 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 rtl:rotate-180 ml-2">&rarr;</span>
      </div>
    </div>
  </div>
</div>
