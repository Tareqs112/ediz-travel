                  <% else %>
                    <div class="absolute inset-0 flex items-center justify-center text-brand-gray-300 bg-brand-gray-50">
                      <svg class="w-12 h-12 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
