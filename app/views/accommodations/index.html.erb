<%
  content_for :title, t("accommodations.page_title")
  content_for :meta_description, t("accommodations.meta_description")

  # WhatsApp URL resolution (Direct CTA)
  # Uses business setting number or approved default +905540171890
  raw_whatsapp = current_business_setting&.whatsapp_number.presence || "+905540171890"
  clean_whatsapp = raw_whatsapp.to_s.gsub(/[^0-9]/, "")
  encoded_wa_general = ERB::Util.url_encode(t("accommodations.whatsapp_message"))
  whatsapp_accommodation_url = "https://wa.me/#{clean_whatsapp}?text=#{encoded_wa_general}"
%>

<div class="bg-white min-h-screen">

  <!-- 1. Hero Section -->
  <section class="relative bg-gradient-to-b from-[#fbfaf8] via-white to-white border-b border-brand-gray-200/50 pt-16 md:pt-24 lg:pt-32 pb-14 md:pb-20">
    <div class="container-main max-w-4xl mx-auto text-center">
      <div class="mb-5 inline-flex items-center justify-center gap-3">
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-70"></span>
        <span class="text-brand-gold-600 font-semibold tracking-[0.2em] text-xs uppercase"><%= t("accommodations.eyebrow") %></span>
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-70"></span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.18] mb-6">
        <%= t("accommodations.heading_default") %>
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-brand-charcoal-600 font-light leading-relaxed max-w-2xl mx-auto mb-10">
        <%= t("accommodations.subtitle") %>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#available-stays"
           class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 sm:px-10 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-xs sm:text-sm tracking-widest uppercase transition-all duration-300 shadow-sm hover:shadow">
          <span><%= t("accommodations.explore_stays_btn") %></span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>

        <a href="<%= whatsapp_accommodation_url %>"
           target="_blank"
           rel="noopener noreferrer"
           class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 border border-brand-gray-300 hover:border-brand-charcoal-900 text-brand-charcoal-900 font-medium text-xs sm:text-sm tracking-widest uppercase transition-all duration-300 bg-white">
          <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          <span><%= t("accommodations.whatsapp_cta") %></span>
        </a>
      </div>

      <div class="mt-4 text-center">
        <span class="text-xs text-brand-charcoal-400 font-light"><%= t("accommodations.available_note") %></span>
      </div>
    </div>
  </section>

  <!-- 2. Why Accommodation Choice Matters -->
  <section class="py-14 md:py-20 lg:py-24 bg-[#faf9f6] border-b border-brand-gray-200/60">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("accommodations.matters_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("accommodations.matters_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("accommodations.matters_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <div class="bg-white p-6 md:p-8 border border-brand-gray-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-full bg-brand-gray-100 flex items-center justify-center text-brand-gold-600 mb-6">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2.5"><%= t("accommodations.matter_1_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("accommodations.matter_1_desc") %></p>
          </div>
        </div>

        <div class="bg-white p-6 md:p-8 border border-brand-gray-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-full bg-brand-gray-100 flex items-center justify-center text-brand-gold-600 mb-6">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2.5"><%= t("accommodations.matter_2_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("accommodations.matter_2_desc") %></p>
          </div>
        </div>

        <div class="bg-white p-6 md:p-8 border border-brand-gray-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-full bg-brand-gray-100 flex items-center justify-center text-brand-gold-600 mb-6">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2.5"><%= t("accommodations.matter_3_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("accommodations.matter_3_desc") %></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Types of Stays -->
  <section class="py-14 md:py-20 lg:py-24 border-b border-brand-gray-200/60 bg-white">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("accommodations.types_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("accommodations.types_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("accommodations.types_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Hotels -->
        <div class="p-6 md:p-8 bg-[#faf9f6] border border-brand-gray-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-brand-gold-600 bg-brand-gold-50/80 px-2.5 py-1 border border-brand-gold-200/60">
                <%= t("accommodations.type_hotels_badge") %>
              </span>
              <span class="text-xs font-medium text-brand-charcoal-400">01</span>
            </div>
            <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("accommodations.type_hotels_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed mb-6"><%= t("accommodations.type_hotels_desc") %></p>
          </div>
          <div class="pt-4 border-t border-brand-gray-200/80 text-xs text-brand-charcoal-500 font-medium">
            <%= t("accommodations.type_hotels_suit") %>
          </div>
        </div>

        <!-- Bungalows -->
        <div class="p-6 md:p-8 bg-[#faf9f6] border border-brand-gray-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-brand-green-700 bg-brand-green-50/80 px-2.5 py-1 border border-brand-green-200/60">
                <%= t("accommodations.type_bungalows_badge") %>
              </span>
              <span class="text-xs font-medium text-brand-charcoal-400">02</span>
            </div>
            <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("accommodations.type_bungalows_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed mb-6"><%= t("accommodations.type_bungalows_desc") %></p>
          </div>
          <div class="pt-4 border-t border-brand-gray-200/80 text-xs text-brand-charcoal-500 font-medium">
            <%= t("accommodations.type_bungalows_suit") %>
          </div>
        </div>

        <!-- Chalets -->
        <div class="p-6 md:p-8 bg-[#faf9f6] border border-brand-gray-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-brand-charcoal-800 bg-brand-charcoal-50 px-2.5 py-1 border border-brand-charcoal-200/60">
                <%= t("accommodations.type_chalets_badge") %>
              </span>
              <span class="text-xs font-medium text-brand-charcoal-400">03</span>
            </div>
            <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("accommodations.type_chalets_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed mb-6"><%= t("accommodations.type_chalets_desc") %></p>
          </div>
          <div class="pt-4 border-t border-brand-gray-200/80 text-xs text-brand-charcoal-500 font-medium">
            <%= t("accommodations.type_chalets_suit") %>
          </div>
        </div>

        <!-- Apartments -->
        <div class="p-6 md:p-8 bg-[#faf9f6] border border-brand-gray-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-brand-gold-600 bg-brand-gold-50/80 px-2.5 py-1 border border-brand-gold-200/60">
                <%= t("accommodations.type_apartments_badge") %>
              </span>
              <span class="text-xs font-medium text-brand-charcoal-400">04</span>
            </div>
            <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("accommodations.type_apartments_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed mb-6"><%= t("accommodations.type_apartments_desc") %></p>
          </div>
          <div class="pt-4 border-t border-brand-gray-200/80 text-xs text-brand-charcoal-500 font-medium">
            <%= t("accommodations.type_apartments_suit") %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Where to Stay in the Region -->
  <section class="py-14 md:py-20 lg:py-24 bg-[#faf9f6] border-b border-brand-gray-200/60">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("accommodations.where_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("accommodations.where_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("accommodations.where_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        <div class="bg-white p-6 md:p-8 border border-brand-gray-200 shadow-xs">
          <span class="text-[11px] font-bold text-brand-gold-600 tracking-widest uppercase block mb-1"><%= t("accommodations.loc_1_tag") %></span>
          <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("accommodations.loc_1_name") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("accommodations.loc_1_desc") %></p>
        </div>

        <div class="bg-white p-6 md:p-8 border border-brand-gray-200 shadow-xs">
          <span class="text-[11px] font-bold text-brand-green-700 tracking-widest uppercase block mb-1"><%= t("accommodations.loc_2_tag") %></span>
          <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("accommodations.loc_2_name") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("accommodations.loc_2_desc") %></p>
        </div>

        <div class="bg-white p-6 md:p-8 border border-brand-gray-200 shadow-xs">
          <span class="text-[11px] font-bold text-brand-charcoal-700 tracking-widest uppercase block mb-1"><%= t("accommodations.loc_3_tag") %></span>
          <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("accommodations.loc_3_name") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("accommodations.loc_3_desc") %></p>
        </div>

        <div class="bg-white p-6 md:p-8 border border-brand-gray-200 shadow-xs">
          <span class="text-[11px] font-bold text-brand-gold-600 tracking-widest uppercase block mb-1"><%= t("accommodations.loc_4_tag") %></span>
          <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("accommodations.loc_4_name") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("accommodations.loc_4_desc") %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. City Stay vs Nature Stay Comparison -->
  <section class="py-14 md:py-20 lg:py-24 border-b border-brand-gray-200/60 bg-white">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("accommodations.vs_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("accommodations.vs_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("accommodations.vs_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- City Base -->
        <div class="p-6 md:p-8 bg-[#faf9f6] border border-brand-gray-200 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-brand-charcoal-600 bg-white px-2.5 py-1 border border-brand-gray-200 inline-block mb-4">
              <%= t("accommodations.vs_city_badge") %>
            </span>
            <h3 class="text-xl font-medium text-brand-charcoal-900 mb-4"><%= t("accommodations.vs_city_title") %></h3>
            <ul class="space-y-3.5">
              <li class="flex items-start gap-3 text-sm text-brand-charcoal-700 font-light">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold-500 mt-2 shrink-0"></span>
                <span><%= t("accommodations.vs_city_point_1") %></span>
              </li>
              <li class="flex items-start gap-3 text-sm text-brand-charcoal-700 font-light">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold-500 mt-2 shrink-0"></span>
                <span><%= t("accommodations.vs_city_point_2") %></span>
              </li>
              <li class="flex items-start gap-3 text-sm text-brand-charcoal-700 font-light">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold-500 mt-2 shrink-0"></span>
                <span><%= t("accommodations.vs_city_point_3") %></span>
              </li>
              <li class="flex items-start gap-3 text-sm text-brand-charcoal-700 font-light">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold-500 mt-2 shrink-0"></span>
                <span><%= t("accommodations.vs_city_point_4") %></span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Nature Base -->
        <div class="p-6 md:p-8 bg-[#faf9f6] border border-brand-gray-200 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-brand-green-800 bg-white px-2.5 py-1 border border-brand-green-200 inline-block mb-4">
              <%= t("accommodations.vs_nature_badge") %>
            </span>
            <h3 class="text-xl font-medium text-brand-charcoal-900 mb-4"><%= t("accommodations.vs_nature_title") %></h3>
            <ul class="space-y-3.5">
              <li class="flex items-start gap-3 text-sm text-brand-charcoal-700 font-light">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-green-600 mt-2 shrink-0"></span>
                <span><%= t("accommodations.vs_nature_point_1") %></span>
              </li>
              <li class="flex items-start gap-3 text-sm text-brand-charcoal-700 font-light">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-green-600 mt-2 shrink-0"></span>
                <span><%= t("accommodations.vs_nature_point_2") %></span>
              </li>
              <li class="flex items-start gap-3 text-sm text-brand-charcoal-700 font-light">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-green-600 mt-2 shrink-0"></span>
                <span><%= t("accommodations.vs_nature_point_3") %></span>
              </li>
              <li class="flex items-start gap-3 text-sm text-brand-charcoal-700 font-light">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-green-600 mt-2 shrink-0"></span>
                <span><%= t("accommodations.vs_nature_point_4") %></span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Existing Stays Filter & Catalog -->
  <section id="available-stays" class="py-14 md:py-20 lg:py-24 bg-[#faf9f6] border-b border-brand-gray-200/60 scroll-mt-20">
    <div class="container-main max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("accommodations.eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("accommodations.all_stays") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("accommodations.subtitle") %></p>
      </div>

      <!-- Filter Bar -->
      <div class="flex overflow-x-auto hide-scrollbar justify-center py-4 mb-8 gap-2 lg:gap-3">
        <%= link_to t("accommodations.all_stays"), accommodations_path(anchor: "available-stays"), class: "px-5 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition-colors #{ @type.blank? ? 'bg-brand-charcoal-900 text-white' : 'bg-white border border-brand-gray-200 text-brand-charcoal-700 hover:bg-brand-gray-100' }" %>
        <%= link_to t("accommodations.hotels"), accommodations_path(type: "hotel", anchor: "available-stays"), class: "px-5 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition-colors #{ @type == 'hotel' ? 'bg-brand-charcoal-900 text-white' : 'bg-white border border-brand-gray-200 text-brand-charcoal-700 hover:bg-brand-gray-100' }" %>
        <%= link_to t("accommodations.bungalows"), accommodations_path(type: "bungalow", anchor: "available-stays"), class: "px-5 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition-colors #{ @type == 'bungalow' ? 'bg-brand-charcoal-900 text-white' : 'bg-white border border-brand-gray-200 text-brand-charcoal-700 hover:bg-brand-gray-100' }" %>
