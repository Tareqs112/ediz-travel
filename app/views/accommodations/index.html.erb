    <div class="container-main max-w-4xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("accommodations.faq_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("accommodations.faq_title") %></h2>
      </div>

      <div class="space-y-4">
        <% (1..8).each do |i| %>
          <details class="group bg-white border border-brand-gray-200/80 p-5 md:p-6 transition-colors">
            <summary class="flex justify-between items-center cursor-pointer list-none font-medium text-base sm:text-lg text-brand-charcoal-900 group-hover:text-brand-gold-600 transition-colors">
              <span><%= t("accommodations.faq_#{i}_q") %></span>
              <span class="ms-4 shrink-0 transition duration-300 group-open:-rotate-180 text-brand-charcoal-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </span>
            </summary>
            <div class="mt-4 pt-4 border-t border-brand-gray-100 text-sm sm:text-base text-brand-charcoal-600 font-light leading-relaxed">
              <%= t("accommodations.faq_#{i}_a") %>
            </div>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <!-- 13. Final Editorial CTA Section -->
  <section class="py-16 md:py-24 lg:py-28 bg-brand-charcoal-900 text-white">
    <div class="container-main max-w-3xl mx-auto text-center">
      <div class="mb-5 inline-flex items-center justify-center gap-3">
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-60"></span>
        <span class="text-brand-gold-400 font-semibold tracking-[0.2em] text-xs uppercase"><%= t("accommodations.final_eyebrow") %></span>
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-60"></span>
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-sans font-medium tracking-tight mb-6 leading-tight">
        <%= t("accommodations.final_title") %>
      </h2>

      <p class="text-base sm:text-lg text-white/70 font-light leading-relaxed mb-10 max-w-xl mx-auto">
        <%= t("accommodations.final_subtitle") %>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="<%= whatsapp_accommodation_url %>"
           target="_blank"
           rel="noopener noreferrer"
           class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 bg-brand-gold-500 hover:bg-brand-gold-600 text-white font-medium text-xs sm:text-sm tracking-widest uppercase transition-all duration-300 shadow-md">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          <span><%= t("accommodations.whatsapp_cta") %></span>
        </a>
      </div>

      <div class="mt-5 text-center">
        <span class="text-xs text-white/50 font-light"><%= t("accommodations.available_note") %></span>
      </div>
    </div>
  </section>

</div>
