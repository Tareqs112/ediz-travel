<% content_for :title, "#{@accommodation.name} - 61 EDİZ TRAVEL" %>

<div class="bg-white min-h-screen">
  
  <!-- Hero Section -->
  <div class="relative w-full h-[40vh] lg:h-[65vh] bg-brand-charcoal-900 overflow-hidden">
    <% if @accommodation.image.attached? %>
      <%= image_tag @accommodation.image, alt: @accommodation.name, class: "absolute inset-0 w-full h-full object-cover opacity-70" %>
    <% else %>
      <div class="absolute inset-0 flex items-center justify-center bg-brand-charcoal-800 text-white/20">
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.75a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21" />
        </svg>
      </div>
    <% end %>
    
    <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal-900 via-brand-charcoal-900/40 to-transparent"></div>
    
    <div class="absolute bottom-0 inset-x-0 pb-12 lg:pb-20">
      <div class="container-main">
        <div class="max-w-4xl">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-brand-gold-500 text-white px-3 py-1 text-xs font-bold uppercase tracking-wider">
              <%= @accommodation.accommodation_type %>
            </span>
            <% if @accommodation.location.present? %>
              <span class="text-white/90 text-sm font-medium flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <%= @accommodation.location %>
              </span>
            <% end %>
          </div>
          
          <h1 class="text-3xl lg:text-6xl font-sans font-medium text-white tracking-tight leading-[1.1] mb-6">
            <%= @accommodation.name %>
          </h1>
          
          <% if @accommodation.short_description.present? %>
            <p class="text-base lg:text-xl text-white/90 font-light leading-relaxed max-w-2xl">
              <%= @accommodation.short_description %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="container-main py-10 lg:py-24">
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-24">
      
      <!-- Main Content -->
      <div class="w-full lg:w-2/3">
        <%= link_to accommodations_path, class: "inline-flex items-center gap-2 text-sm font-medium text-brand-charcoal-500 hover:text-brand-green-700 uppercase tracking-widest transition-colors mb-10" do %>
          <svg class="w-4 h-4 inline-block rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          <%= t("accommodations.show.back_to_stays") %>
        <% end %>

        <h2 class="text-3xl font-medium text-brand-charcoal-900 mb-8 tracking-tight"><%= t("accommodations.show.about_stay", type: @accommodation.accommodation_type) %></h2>
        
        <div class="prose prose-lg prose-brand max-w-none text-brand-charcoal-600 font-light leading-relaxed">
          <% if @accommodation.description.present? %>
            <%= simple_format(@accommodation.description) %>
          <% else %>
            <p><%= t("accommodations.show.default_desc", name: @accommodation.name) %></p>
          <% end %>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="w-full lg:w-1/3">
        <div class="sticky top-32">
          <div class="bg-[#faf9f6] border border-brand-gray-200/60 p-5 lg:p-10 flex flex-col">
            <h3 class="text-xl font-medium text-brand-charcoal-900 mb-2"><%= t("accommodations.show.request_availability") %></h3>
            <p class="text-brand-charcoal-600 font-light text-sm leading-relaxed mb-8">
              <%= t("accommodations.show.interested_in", name: @accommodation.name) %>
            </p>
            
            <%= link_to plan_your_trip_path(accommodation_id: @accommodation.id, notes: "I am interested in booking: #{@accommodation.name}"), class: "w-full text-center px-8 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors mb-6" do %>
              <%= t("accommodations.request_accommodation") %>
            <% end %>
            
            <div class="border-t border-brand-gray-200/60 pt-6">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 block mb-2"><%= t("cta_common.have_question") %></span>
              <p class="text-sm text-brand-charcoal-500 font-light"><%= t("cta_common.have_question_desc") %></p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
  
  <!-- Mobile Fixed CTA -->
  <div class="lg:hidden fixed bottom-0 inset-x-0 w-full bg-white border-t border-brand-gray-200 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-[0_-8px_15px_-3px_rgba(0,0,0,0.1)] z-40">
    <%= link_to plan_your_trip_path(accommodation_id: @accommodation.id, notes: "I am interested in booking: #{@accommodation.name}"), class: "w-full flex justify-center items-center bg-brand-green-700 text-white font-semibold py-3.5 px-4 rounded-xl shadow-sm active:bg-brand-green-800 transition-colors" do %>
      <%= t("accommodations.request_accommodation") %>
    <% end %>
  </div>

</div>
