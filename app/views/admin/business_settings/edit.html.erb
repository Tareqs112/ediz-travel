<% content_for :title, "Business Information" %>

<div class="max-w-4xl">
  <%= form_with(model: @business_setting, url: admin_business_setting_path, class: "bg-white shadow rounded-lg p-6") do |f| %>

    <% if @business_setting.errors.any? %>
      <div class="bg-red-50 text-red-800 p-4 rounded-md mb-6">
        <h4 class="font-semibold text-sm">Please fix the following errors:</h4>
        <ul class="list-disc ps-5 text-sm mt-2">
          <% @business_setting.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-8">
      <h3 class="text-lg font-medium text-gray-900 mb-4 border-b pb-2">General Details</h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <%= f.label :company_name, class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :company_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :tursab_number, "TÜRSAB Document Number", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :tursab_number, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
        </div>
      </div>
    </div>

    <div class="mb-8">
      <h3 class="text-lg font-medium text-gray-900 mb-4 border-b pb-2">Contact Information</h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <%= f.label :whatsapp_number, "WhatsApp / Official Phone", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :whatsapp_number, placeholder: "+905540171890", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">Include country code (e.g. +90)</p>
        </div>

        <div>
          <%= f.label :contact_email, "Contact Email", class: "block text-sm font-medium text-gray-700" %>
          <%= f.email_field :contact_email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :address, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_area :address, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
      </div>

      <div class="mb-4">
        <%= f.label :google_maps_url, "Google Maps URL", class: "block text-sm font-medium text-gray-700" %>
        <%= f.url_field :google_maps_url, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
      </div>
    </div>

    <div class="mb-8">
      <h3 class="text-lg font-medium text-gray-900 mb-4 border-b pb-2">Policies</h3>

      <div class="mb-4">
        <%= f.label :booking_policies, "Booking & Cancellation Policies (Default)", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_area :booking_policies, rows: 5, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
        <p class="mt-1 text-xs text-gray-500">This will be shown on public pages when a specific tour doesn't have its own policy.</p>
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <%= f.submit "Save Changes", class: "px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-medium hover:bg-gray-800 cursor-pointer" %>
    </div>
  <% end %>
</div>
