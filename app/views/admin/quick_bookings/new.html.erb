<% content_for :title, "⚡ Quick Booking" %>

<div class="max-w-4xl mx-auto">
  <div class="mb-6 flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">New Quick Booking</h1>
    <%= link_to "Cancel", admin_bookings_path, class: "text-gray-500 hover:text-gray-700 font-medium" %>
  </div>

  <%= form_with(model: @quick_booking_form, url: admin_quick_bookings_path, class: "space-y-8") do |f| %>
    <% if @quick_booking_form.errors.any? %>
      <div class="bg-red-50 text-red-800 p-4 rounded-md shadow-sm border border-red-200">
        <h4 class="font-semibold text-sm">Please fix the following errors:</h4>
        <ul class="list-disc ps-5 text-sm mt-2">
          <% @quick_booking_form.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# SECTION 1 - CUSTOMER %>
    <section class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
      <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-800">1. Customer Info</h2>
        <p class="text-sm text-gray-500 mt-1">We will reuse an existing customer if the phone number matches.</p>
      </div>
      <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :customer_phone, "Phone Number *", class: "block text-sm font-bold text-gray-700" %>
          <%= f.text_field :customer_phone, autofocus: true, placeholder: "+90 555 123 4567", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3", required: true %>
        </div>
        <div>
          <%= f.label :customer_name, "Customer Name *", class: "block text-sm font-bold text-gray-700" %>
          <%= f.text_field :customer_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3", required: true %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :customer_email, "Email Address (Optional)", class: "block text-sm font-medium text-gray-700" %>
          <%= f.email_field :customer_email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
        </div>
      </div>
    </section>

    <%# SECTION 2 - BOOKING %>
    <section class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
      <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-800">2. Booking Details</h2>
      </div>
      <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :source, "Booking Source *", class: "block text-sm font-bold text-gray-700" %>
          <%= f.select :source, Booking::VALID_SOURCES.map { |s| [s.titleize, s] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
        </div>
        <div>
          <%= f.label :status, "Overall Status *", class: "block text-sm font-bold text-gray-700" %>
          <%= f.select :status, Booking::VALID_STATUSES.map { |s| [s.titleize, s] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :total_price, "Total Price", class: "block text-sm font-medium text-gray-700" %>
            <%= f.number_field :total_price, step: "0.01", min: "0", placeholder: "e.g. 150.00", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
          </div>
          <div>
            <%= f.label :currency, "Currency", class: "block text-sm font-medium text-gray-700" %>
            <%= f.select :currency, ["USD", "EUR", "TRY", "SAR", "GBP", "AED"], {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :start_date, "Overall Start Date (Optional)", class: "block text-sm font-medium text-gray-700 text-xs truncate" %>
            <%= f.date_field :start_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
          </div>
          <div>
            <%= f.label :end_date, "Overall End Date (Optional)", class: "block text-sm font-medium text-gray-700 text-xs truncate" %>
            <%= f.date_field :end_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
          </div>
        </div>
      </div>
    </section>

    <%# SECTION 3 - FIRST TRIP SERVICE %>
    <section class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
      <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-800">3. Primary Trip Service</h2>
        <p class="text-sm text-gray-500 mt-1">Create the first operational service for this booking.</p>
      </div>
      <div class="p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :service_type, "Service Type *", class: "block text-sm font-bold text-gray-700" %>
            <%= f.select :service_type, TripService::VALID_SERVICE_TYPES.map { |s| [s.titleize, s] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div class="col-span-1">
              <%= f.label :service_date, "Date *", class: "block text-sm font-bold text-gray-700" %>
              <%= f.date_field :service_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm py-2 px-2", required: true %>
            </div>
            <div class="col-span-1">
              <%= f.label :start_time, "Start Time", class: "block text-sm font-medium text-gray-700 truncate" %>
              <%= f.time_field :start_time, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm py-2 px-2" %>
            </div>
            <div class="col-span-1">
              <%= f.label :end_time, "End Time", class: "block text-sm font-medium text-gray-700 truncate" %>
              <%= f.time_field :end_time, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm py-2 px-2" %>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :pickup_location, "Pickup Location", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_field :pickup_location, placeholder: "e.g. TZX Airport / Hotel name", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
          </div>
          <div>
            <%= f.label :dropoff_location, "Dropoff Location", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_field :dropoff_location, placeholder: "e.g. Uzungöl", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :driver_id, "Driver (Optional)", class: "block text-sm font-medium text-gray-700" %>
            <%= f.select :driver_id, Driver.where(active: true).order(:name).map { |d| [d.is_external ? "#{d.name} (External)" : d.name, d.id] }, { include_blank: "Unassigned" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
          </div>
          <div>
            <%= f.label :vehicle_id, "Vehicle (Optional)", class: "block text-sm font-medium text-gray-700" %>
            <%= f.collection_select :vehicle_id, Vehicle.where(active: true).order(:name), :id, :name, { include_blank: "Unassigned" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
          </div>
        </div>

        <div>
          <%= f.label :notes, "Operational Notes (Optional)", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_area :notes, rows: 2, placeholder: "Flight number, special requests...", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-base py-2 px-3" %>
        </div>
      </div>
    </section>

    <div class="flex justify-end gap-4 pb-12">
      <%= link_to "Cancel", admin_bookings_path, class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-md font-bold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-brand-green-500" %>
      <%= f.submit "Create Quick Booking", class: "px-6 py-3 bg-brand-green-600 hover:bg-brand-green-700 text-white rounded-md font-bold text-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-green-500 cursor-pointer" %>
    </div>
  <% end %>
</div>
