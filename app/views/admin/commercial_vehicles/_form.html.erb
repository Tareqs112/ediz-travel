<%= form_with(model: [:admin, commercial_vehicle], class: "space-y-8 divide-y divide-gray-200") do |f| %>
  <% if commercial_vehicle.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-6">
      <div class="flex">
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800"><%= pluralize(commercial_vehicle.errors.count, "error") %> prohibited this vehicle from being saved:</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul role="list" class="list-disc space-y-1 pl-5">
              <% commercial_vehicle.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-8 divide-y divide-gray-200 sm:space-y-5">
    <div class="space-y-6 sm:space-y-5">
      <div>
        <h3 class="text-base font-semibold leading-6 text-gray-900">Vehicle Information</h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">Public marketing details for this vehicle.</p>
      </div>

      <div class="space-y-6 sm:space-y-5">
        <% [ ['en', 'English'], ['ar', 'Arabic'], ['tr', 'Turkish'] ].each do |loc, loc_name| %>
          <div class="mt-6 <%= loc == 'en' ? '' : 'border-t border-gray-200 pt-6' %>">
            <h4 class="text-sm font-semibold text-gray-900 mb-4"><%= loc_name %> Content <%= loc == 'en' ? '(Required)' : '(Optional Fallback)' %></h4>

            <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 mb-4">
              <%= f.label :"name_#{loc}", "Name", class: "block text-sm font-medium leading-6 text-gray-900 sm:pt-1.5" %>
              <div class="mt-2 sm:col-span-2 sm:mt-0">
                <%= f.text_field :"name_#{loc}", class: "block w-full max-w-lg rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-green-600 sm:max-w-xs sm:text-sm sm:leading-6" %>
              </div>
            </div>

            <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 mb-4">
              <%= f.label :"description_#{loc}", "Description", class: "block text-sm font-medium leading-6 text-gray-900 sm:pt-1.5" %>
              <div class="mt-2 sm:col-span-2 sm:mt-0">
                <%= f.text_area :"description_#{loc}", rows: 4, class: "block w-full max-w-lg rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-green-600 sm:text-sm sm:leading-6" %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:border-t sm:border-gray-200 sm:pt-5">
          <%= f.label :category, class: "block text-sm font-medium leading-6 text-gray-900 sm:pt-1.5" %>
          <div class="mt-2 sm:col-span-2 sm:mt-0">
            <%= f.select :category, [["Chauffeured", "chauffeured"], ["Self Drive", "self_drive"]], {}, class: "block w-full max-w-lg rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-green-600 sm:max-w-xs sm:text-sm sm:leading-6" %>
          </div>
        </div>

        <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:border-t sm:border-gray-200 sm:pt-5">
          <%= f.label :image, "Vehicle Image", class: "block text-sm font-medium leading-6 text-gray-900 sm:pt-1.5" %>
          <div class="mt-2 sm:col-span-2 sm:mt-0">
            <%= f.file_field :image, accept: "image/*", class: "block w-full text-sm text-gray-900 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-brand-gray-50 file:text-brand-charcoal-700 hover:file:bg-brand-gray-100" %>
            <% if commercial_vehicle.image.attached? %>
              <div class="mt-4">
                <p class="text-sm text-gray-500 mb-2">Current image:</p>
                <%= image_tag commercial_vehicle.image, class: "h-32 object-cover rounded-md" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6 pt-8 sm:space-y-5 sm:pt-10">
      <div>
        <h3 class="text-base font-semibold leading-6 text-gray-900">Specifications & Pricing</h3>
      </div>

      <div class="space-y-6 sm:space-y-5">
        <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:border-t sm:border-gray-200 sm:pt-5">
          <%= f.label :passenger_capacity, class: "block text-sm font-medium leading-6 text-gray-900 sm:pt-1.5" %>
          <div class="mt-2 sm:col-span-2 sm:mt-0">
            <%= f.number_field :passenger_capacity, min: 1, class: "block w-full max-w-lg rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-green-600 sm:max-w-xs sm:text-sm sm:leading-6" %>
          </div>
        </div>

        <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:border-t sm:border-gray-200 sm:pt-5">
          <%= f.label :luggage_capacity, class: "block text-sm font-medium leading-6 text-gray-900 sm:pt-1.5" %>
          <div class="mt-2 sm:col-span-2 sm:mt-0">
            <%= f.number_field :luggage_capacity, min: 0, class: "block w-full max-w-lg rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-green-600 sm:max-w-xs sm:text-sm sm:leading-6" %>
          </div>
        </div>

        <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:border-t sm:border-gray-200 sm:pt-5">
          <%= f.label :price_from, class: "block text-sm font-medium leading-6 text-gray-900 sm:pt-1.5" %>
          <div class="mt-2 sm:col-span-2 sm:mt-0 flex gap-2 sm:max-w-xs">
            <%= f.number_field :price_from, step: "0.01", min: 0, class: "block w-2/3 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-green-600 sm:text-sm sm:leading-6" %>
            <%= f.text_field :currency, placeholder: "USD", class: "block w-1/3 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-green-600 sm:text-sm sm:leading-6" %>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6 pt-8 sm:space-y-5 sm:pt-10">
      <div>
        <h3 class="text-base font-semibold leading-6 text-gray-900">Visibility</h3>
      </div>
      <div class="space-y-6 sm:space-y-5">
        <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:border-t sm:border-gray-200 sm:pt-5">
          <div class="sm:pt-1.5"></div>
          <div class="mt-2 sm:col-span-2 sm:mt-0">
            <div class="flex items-center">
              <%= f.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-brand-green-600 focus:ring-brand-green-600" %>
              <%= f.label :active, "Active (visible on website)", class: "ml-3 block text-sm font-medium leading-6 text-gray-900" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pt-5">
    <div class="flex justify-end gap-x-3">
      <%= link_to "Cancel", admin_commercial_vehicles_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <%= f.submit class: "inline-flex justify-center rounded-md bg-brand-charcoal-900 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-green-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green-600 cursor-pointer" %>
    </div>
  </div>
<% end %>
