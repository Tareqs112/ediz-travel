<% content_for :title, "Commercial Vehicles" %>

<div class="sm:flex sm:items-center">
  <div class="sm:flex-auto">
    <h1 class="text-base font-semibold leading-6 text-gray-900">Commercial Vehicles</h1>
    <p class="mt-2 text-sm text-gray-700">Manage public vehicle listings for chauffeured services and car rentals.</p>
  </div>
  <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
    <%= link_to "Add Vehicle", new_admin_commercial_vehicle_path, class: "block rounded-md bg-brand-charcoal-900 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-brand-green-800" %>
  </div>
</div>

<div class="mt-8 flow-root">
  <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
      <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
        <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Name</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Category</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Price From</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @commercial_vehicles.each do |vehicle| %>
              <tr>
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6"><%= vehicle.name %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium <%= vehicle.category == 'chauffeured' ? 'bg-purple-50 text-purple-700 ring-1 ring-inset ring-purple-700/10' : 'bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-700/10' %>">
                    <%= vehicle.category.titleize %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= vehicle.price_from.present? ? number_to_currency(vehicle.price_from, unit: vehicle.currency.present? ? vehicle.currency + " " : "$", precision: 0) : "-" %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <% if vehicle.active? %>
                    <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Active</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Inactive</span>
                  <% end %>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                  <%= link_to "View", admin_commercial_vehicle_path(vehicle), class: "text-brand-charcoal-600 hover:text-brand-green-700 mr-4" %>
                  <%= link_to "Edit", edit_admin_commercial_vehicle_path(vehicle), class: "text-brand-charcoal-600 hover:text-brand-green-700" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
