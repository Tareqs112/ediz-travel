<%= form_with(model: [:admin, @package], class: "bg-white shadow rounded-lg p-6") do |f| %>
  <% if @package.errors.any? %>
    <div class="bg-red-50 text-red-800 p-4 rounded-md mb-6">
      <h4 class="font-semibold text-sm">Please fix the following errors:</h4>
      <ul class="list-disc ps-5 text-sm mt-2">
        <% @package.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>
  <div class="mb-4">
    <%= f.label :slug, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :slug, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>
  <div class="mb-4">
    <%= f.label :duration, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :duration, placeholder: "e.g. 5 Days / 4 Nights", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>
  <div class="mb-4">
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 6, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>
  <div class="mb-4">
    <%= f.label :short_description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :short_description, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>
  <div class="mb-4">
    <div class="flex items-center mt-2">
      <%= f.check_box :active, class: "h-4 w-4 text-brand-green-600 focus:ring-brand-green-500 border-gray-300 rounded" %>
      <%= f.label :active, class: "ms-2 block text-sm text-gray-900" %>
    </div>
  </div>
  <div class="mb-4">
    <%= f.label :image, class: "block text-sm font-medium text-gray-700" %>
    <%= f.file_field :image, class: "mt-1 block w-full text-sm text-gray-500 file:me-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-gray-50 file:text-gray-700 hover:file:bg-gray-100" %>
  </div>

  <div class="mb-6 pt-4 border-t border-gray-200">
    <h3 class="text-sm font-medium text-gray-900 mb-2">Associations</h3>
    <div class="mb-4">
      <%= f.label :tour_ids, "Included Tours", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :tour_ids, Tour.order(:title), :id, :title, {}, { multiple: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm", size: 5 } %>
    </div>
    <div class="mb-4">
      <%= f.label :destination_ids, "Included Destinations", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :destination_ids, Destination.order(:name), :id, :name, {}, { multiple: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm", size: 5 } %>
    </div>
    <div class="mb-4">
      <%= f.label :accommodation_ids, "Included Accommodations", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :accommodation_ids, Accommodation.order(:name), :id, :name, {}, { multiple: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm", size: 5 } %>
    </div>
  </div>

  <div class="mb-4">
    <%= f.label :included, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :included, value: Array(f.object.included).join("\n"), rows: 4, placeholder: "One item per line", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>
  <div class="mb-4">
    <%= f.label :excluded, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :excluded, value: Array(f.object.excluded).join("\n"), rows: 4, placeholder: "One item per line", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>
  <div class="mb-4">
    <%= f.label :highlights, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :highlights, value: Array(f.object.highlights).join("\n"), rows: 4, placeholder: "One item per line", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>

  <div class="mb-8 pt-6 border-t border-gray-200">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Itinerary</h3>
    <p class="text-sm text-gray-500 mb-4">Add up to 10 days. Leave title and description blank to ignore a day.</p>
    
    <div class="space-y-4">
      <% 
         current_itinerary = Array(@package.itinerary)
         10.times do |i| 
           day_data = current_itinerary[i] || {}
      %>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-gray-700">Day</label>
            <input type="text" name="package[itinerary][][day]" value="<%= day_data['day'] || day_data[:day] || (i + 1) %>" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm">
          </div>
          <div class="md:col-span-4">
            <label class="block text-xs font-medium text-gray-700">Title</label>
            <input type="text" name="package[itinerary][][title]" value="<%= day_data['title'] || day_data[:title] %>" placeholder="e.g. Arrival in Trabzon" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm">
          </div>
          <div class="md:col-span-6">
            <label class="block text-xs font-medium text-gray-700">Description</label>
            <textarea name="package[itinerary][][desc]" rows="2" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm"><%= day_data['desc'] || day_data[:desc] %></textarea>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 flex justify-end gap-3">
    <%= link_to "Cancel", admin_packages_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50" %>
    <%= f.submit class: "px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-medium hover:bg-gray-800 cursor-pointer" %>
  </div>
<% end %>
