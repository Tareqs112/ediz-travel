<% url_val = @trip_service.persisted? ? edit_admin_booking_trip_service_path(@booking, @trip_service) : new_admin_booking_trip_service_path(@booking) %>
<%= form_with(model: [:admin, @booking, @trip_service], class: "bg-white shadow rounded-lg p-6", data: { controller: "conflict-checker", conflict_checker_url_value: url_val }) do |f| %>
  <% if @trip_service.errors.any? %>
    <div class="bg-red-50 text-red-800 p-4 rounded-md mb-6">
      <h4 class="font-semibold text-sm">Please fix the following errors:</h4>
      <ul class="list-disc ps-5 text-sm mt-2">
        <% @trip_service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div data-conflict-checker-target="warningContainer" class="hidden"></div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="mb-4">
      <%= f.label :service_type, "Service Type", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :service_type, TripService::VALID_SERVICE_TYPES.map { |t| [t.titleize, t] }, { prompt: "Select type…" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>

    <div class="mb-4">
      <%= f.label :status, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :status, TripService::VALID_STATUSES.map { |s| [s.titleize, s] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>

    <div class="mb-4">
      <%= f.label :date, "Service Date", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm", data: { conflict_checker_target: "date", action: "change->conflict-checker#check" } %>
    </div>

    <div class="mb-4 grid grid-cols-2 gap-2">
      <div>
        <%= f.label :start_time, "Start Time", class: "block text-sm font-medium text-gray-700" %>
        <%= f.time_field :start_time, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm", data: { conflict_checker_target: "startTime", action: "change->conflict-checker#check" } %>
      </div>
      <div>
        <%= f.label :end_time, "End Time", class: "block text-sm font-medium text-gray-700" %>
        <%= f.time_field :end_time, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm", data: { conflict_checker_target: "endTime", action: "change->conflict-checker#check" } %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :pickup_location, "Pickup Location", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :pickup_location, placeholder: "e.g. Trabzon Airport", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>

    <div class="mb-4">
      <%= f.label :dropoff_location, "Dropoff Location", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :dropoff_location, placeholder: "e.g. Hotel Novotel Trabzon", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-5 mt-2 mb-4">
    <h4 class="text-sm font-semibold text-gray-700 mb-3">Assignment & Cost</h4>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :driver_id, "Driver", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :driver_id, Driver.where(active: true).order(:name).map { |d| [d.is_external ? "#{d.name} (External)" : d.name, d.id] }, { prompt: "— Unassigned —" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm", data: { conflict_checker_target: "driver", action: "change->conflict-checker#check" } %>
      </div>

      <div>
        <%= f.label :vehicle_id, "Vehicle", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :vehicle_id, Vehicle.where(active: true).order(:name).map { |v| ["#{v.name} (#{v.plate_number})", v.id] }, { prompt: "— Unassigned —" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm", data: { conflict_checker_target: "vehicle", action: "change->conflict-checker#check" } %>
      </div>
    </div>

    <div class="mt-4">
      <%= f.label :estimated_cost, "Estimated Cost (#{@booking.currency || 'USD'})", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :estimated_cost, step: "0.01", placeholder: "e.g. 50.00", class: "mt-1 block w-full md:w-1/2 rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
      <p class="mt-1 text-xs text-gray-500">Optional operational cost. Will be subtracted from booking total price to estimate margin.</p>
    </div>
  </div>

  <div class="mb-4">
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :notes, rows: 3, placeholder: "Internal notes for this service…", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>

  <div class="mt-6 flex justify-end gap-3">
    <%= link_to "Cancel", admin_booking_path(@booking), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50" %>
    <%= f.submit class: "px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-medium hover:bg-gray-800 cursor-pointer", data: { conflict_checker_target: "submitButton" } %>
  </div>
<% end %>
