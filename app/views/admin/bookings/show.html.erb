<% content_for :title, "Booking ##{@booking.id}" %>

<div class="mb-6 flex items-center justify-between">
  <%= link_to "← Back to Bookings", admin_bookings_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  <div class="flex gap-3">
    <%= link_to "Edit", edit_admin_booking_path(@booking), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50" %>
    <%= link_to "Delete", admin_booking_path(@booking), data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will delete the booking." }, class: "px-4 py-2 bg-red-600 text-white rounded-md text-sm font-medium hover:bg-red-700" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <div class="lg:col-span-2 space-y-8">
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
        <div>
          <h3 class="text-lg leading-6 font-medium text-gray-900">Booking Information</h3>
        </div>
        <div>
          <% status_color = case @booking.status
                            when 'confirmed', 'active' then 'bg-green-100 text-green-800'
                            when 'draft' then 'bg-yellow-100 text-yellow-800'
                            when 'cancelled' then 'bg-red-100 text-red-800'
                            else 'bg-gray-100 text-gray-800'
                            end %>
          <span class="px-3 py-1 <%= status_color %> rounded-full text-sm font-semibold capitalize"><%= @booking.status %></span>
        </div>
      </div>
      <div class="border-t border-gray-200 px-4 py-5 sm:p-0">
        <dl class="sm:divide-y sm:divide-gray-200">
          <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Customer</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= link_to @booking.customer.name, admin_customer_path(@booking.customer), class: "text-brand-green-600 hover:underline font-medium" %>
              <% if @booking.customer.phone.present? %>
                <span class="text-gray-500 text-xs ml-2">(<%= @booking.customer.phone %>)</span>
              <% end %>
            </dd>
          </div>
          <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Dates</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <% if @booking.start_date || @booking.end_date %>
                <%= @booking.start_date&.to_formatted_s(:long) || "TBD" %> to <%= @booking.end_date&.to_formatted_s(:long) || "TBD" %>
              <% else %>
                Not set
              <% end %>
            </dd>
          </div>
          <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Source</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 capitalize"><%= @booking.source.tr('_', ' ') %></dd>
          </div>
          <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Notes</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 whitespace-pre-wrap"><%= @booking.notes.presence || "No notes." %></dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Future Trip Services Section -->
    <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-8 text-center">
      <h4 class="text-sm font-medium text-gray-900 mb-1">Trip Services (Coming Soon)</h4>
      <p class="text-sm text-gray-500">This is where drivers, vehicles, and daily operational schedules will be attached in the future.</p>
    </div>
  </div>

  <div class="space-y-8">
    <% if @booking.booking_request || @booking.trip_inquiry %>
      <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
          <h3 class="text-lg font-medium text-gray-900">Originating Lead</h3>
        </div>
        <div class="px-6 py-5">
          <% if @booking.booking_request %>
            <div class="mb-4">
              <span class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Source Request</span>
              <%= link_to "Booking Request ##{@booking.booking_request.id}", admin_booking_request_path(@booking.booking_request), class: "text-brand-green-600 hover:underline font-medium block mb-1" %>
              <div class="text-sm text-gray-700"><strong>Tour:</strong> <%= @booking.booking_request.tour.title %></div>
              <div class="text-sm text-gray-700"><strong>Guests:</strong> <%= @booking.booking_request.travelers_count %></div>
              <div class="text-sm text-gray-700"><strong>Date:</strong> <%= @booking.booking_request.travel_date&.to_formatted_s(:short) %></div>
            </div>
          <% end %>

          <% if @booking.trip_inquiry %>
            <div>
              <span class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Source Inquiry</span>
              <%= link_to "Trip Inquiry ##{@booking.trip_inquiry.id}", admin_trip_inquiry_path(@booking.trip_inquiry), class: "text-brand-green-600 hover:underline font-medium block mb-1" %>
              <div class="text-sm text-gray-700"><strong>Type:</strong> <%= @booking.trip_inquiry.inquiry_type.titleize %></div>
              <div class="text-sm text-gray-700"><strong>Guests:</strong> <%= @booking.trip_inquiry.travelers_count %></div>
              <div class="text-sm text-gray-700"><strong>Date:</strong> <%= @booking.trip_inquiry.travel_date&.to_formatted_s(:short) %></div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
      <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
        <h3 class="text-lg font-medium text-gray-900">Manage Status</h3>
      </div>
      <div class="px-6 py-5">
        <%= form_with(model: [:admin, @booking], local: true) do |f| %>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Current Status</label>
            <%= f.select :status, Booking::VALID_STATUSES.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 text-sm" %>
          </div>
          <%= f.submit "Update Status", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
