<% content_for :title, "Booking ##{@booking.id}" %>

<div class="mb-6 flex items-center justify-between">
  <%= link_to "← Back to Bookings", admin_bookings_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  <div class="flex gap-3">
    <%= link_to "Edit", edit_admin_booking_path(@booking), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50" %>
    <%= link_to "Delete", admin_booking_path(@booking), data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will delete the booking and all its services." }, class: "px-4 py-2 bg-red-600 text-white rounded-md text-sm font-medium hover:bg-red-700" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <div class="lg:col-span-2 space-y-8">

    <%# ═══════════════ JOURNEY HEADER ═══════════════ %>
    <div class="bg-white shadow overflow-hidden sm:rounded-lg border border-gray-200">
      <div class="px-6 py-5">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div>
            <h2 class="text-2xl font-bold text-gray-900">
              <%= link_to @booking.customer.name, admin_customer_path(@booking.customer), class: "hover:underline text-brand-green-700" %>
            </h2>
            <% if @booking.customer.phone.present? %>
              <a href="tel:<%= @booking.customer.phone %>" class="text-gray-600 hover:text-gray-900 flex items-center gap-1.5 mt-1.5 font-medium w-fit">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <span dir="ltr"><%= @booking.customer.phone %></span>
              </a>
            <% end %>
          </div>

          <div class="flex flex-col sm:items-end gap-2">
            <% status_color = case @booking.status
                              when 'confirmed', 'active' then 'bg-green-100 text-green-800'
                              when 'draft' then 'bg-yellow-100 text-yellow-800'
                              when 'cancelled' then 'bg-red-100 text-red-800'
                              else 'bg-gray-100 text-gray-800'
                              end %>
            <span class="px-3 py-1 <%= status_color %> rounded-full text-sm font-semibold capitalize inline-block w-fit"><%= @booking.status %></span>

            <% if @booking.total_price.present? %>
              <div class="text-xl font-bold text-gray-900 mt-1">
                <%= number_to_currency(@booking.total_price, unit: @booking.currency || "USD", format: "%u %n") %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-4 border-t border-gray-100 pt-5">
          <div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Journey Dates</div>
            <div class="mt-1 text-sm font-medium text-gray-900">
              <% if @booking.start_date || @booking.end_date %>
                <%= @booking.start_date&.strftime("%b %d, %Y") || "TBD" %> &rarr; <%= @booking.end_date&.strftime("%b %d, %Y") || "TBD" %>
              <% else %>
                TBD
              <% end %>
            </div>
          </div>
          <div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Legs</div>
            <div class="mt-1 text-sm font-medium text-gray-900">
              <%= @booking.trip_services.size %> service<%= @booking.trip_services.size == 1 ? '' : 's' %>
            </div>
          </div>
        </div>

        <% if @booking.notes.present? %>
          <div class="mt-5 border-t border-gray-100 pt-5">
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Booking Notes</div>
            <div class="text-sm text-gray-700 whitespace-pre-wrap"><%= @booking.notes %></div>
          </div>
        <% end %>

        <div class="mt-5 border-t border-gray-100 pt-5 flex flex-wrap gap-3">
          <%= link_to edit_admin_booking_path(@booking), class: "inline-flex items-center gap-1.5 text-sm text-gray-600 hover:text-gray-900 font-medium bg-gray-50 hover:bg-gray-100 px-3 py-1.5 rounded-md border border-gray-200 transition" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
            Edit Info
          <% end %>
          <%= link_to new_admin_booking_trip_service_path(@booking), class: "inline-flex items-center gap-1.5 text-sm text-white bg-gray-900 hover:bg-gray-800 font-medium px-3 py-1.5 rounded-md transition" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Add Service
          <% end %>
        </div>
      </div>
    </div>

    <%# ═══════════════ TIMELINE ═══════════════ %>
    <% if @booking.trip_services.any? %>
      <div class="space-y-10">
        <% @booking.trip_services.includes(:driver, :vehicle).order(:date, :start_time).group_by(&:date).each do |date, services| %>

          <div>
            <%# Date Divider %>
            <div class="relative mb-5">
              <div class="absolute inset-0 flex items-center" aria-hidden="true">
                <div class="w-full border-t-2 border-gray-200"></div>
              </div>
              <div class="relative flex justify-start">
                <span class="pe-4 bg-gray-50 text-gray-900 flex flex-col">
                  <span class="text-lg font-bold"><%= date.strftime("%B %d, %Y") %></span>
                  <span class="text-sm font-semibold text-brand-gold-600"><%= date.strftime("%A") %></span>
                </span>
              </div>
            </div>

            <%# Services for this date %>
            <div class="space-y-4 ms-2 sm:ms-6 border-s-2 border-gray-200 ps-4 sm:ps-6 pb-2">
              <% services.each do |service| %>
                <div class="bg-white border border-gray-200 shadow-sm rounded-lg overflow-hidden hover:border-gray-300 transition">
                  <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-start justify-between gap-5">

                    <%# Main Info %>
                    <div class="flex-1 min-w-0 space-y-3">

                      <%# Header: Time & Status %>
                      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                        <% if service.start_time %>
                          <div class="text-base font-bold text-gray-900 flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <%= service.start_time.strftime("%H:%M") %>
                            <% if service.end_time %>
                              <span class="text-gray-400 font-medium text-sm">&rarr;</span>
                              <%= service.end_time.strftime("%H:%M") %>
                            <% end %>
                          </div>
                        <% else %>
                          <div class="text-base font-bold text-gray-500 flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Time TBD
                          </div>
                        <% end %>

                        <span class="px-2 py-0.5 bg-gray-100 text-gray-800 rounded text-xs font-bold uppercase tracking-wide">
                          <%= service.service_type.titleize %>
                        </span>

                        <% svc_status_color = case service.status
                                              when 'assigned' then 'bg-blue-100 text-blue-800'
                                              when 'in_progress' then 'bg-indigo-100 text-indigo-800'
                                              when 'completed' then 'bg-green-100 text-green-800'
                                              when 'cancelled' then 'bg-red-100 text-red-800'
                                              else 'bg-yellow-100 text-yellow-800'
                                              end %>
                        <span class="px-2 py-0.5 <%= svc_status_color %> rounded text-xs font-bold capitalize">
                          <%= service.status %>
                        </span>
                      </div>

                      <%# Route %>
                      <% if service.pickup_location.present? || service.dropoff_location.present? %>
                        <div class="text-sm text-gray-800 font-medium flex items-center gap-2 flex-wrap bg-gray-50 px-3 py-2 rounded border border-gray-100">
                          <% if service.pickup_location.present? %>
                            <span><%= service.pickup_location %></span>
                          <% end %>

                          <% if service.pickup_location.present? && service.dropoff_location.present? %>
                            <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mx-1 transform rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                          <% end %>

                          <% if service.dropoff_location.present? %>
                            <span><%= service.dropoff_location %></span>
                          <% end %>
                        </div>
                      <% end %>

                      <%# Assignments %>
                      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm pt-1">
                        <% driver_has_conflict = service.conflicting_driver_services.exists? %>
                        <% vehicle_has_conflict = service.conflicting_vehicle_services.exists? %>

                        <span class="flex items-center gap-1.5 <%= service.driver ? 'text-gray-700' : 'text-amber-600 font-medium' %>">
                          <svg class="w-4 h-4 <%= service.driver ? 'text-gray-400' : 'text-amber-500' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                          <span class="text-gray-500 text-xs uppercase tracking-wider font-semibold">Driver:</span>
                          <% if service.driver %>
                            <%= link_to operations_admin_driver_path(service.driver, date: service.date.to_s), class: "font-semibold hover:underline #{driver_has_conflict ? 'text-red-600' : 'text-gray-900'}" do %>
                              <%= service.driver.name %>
                              <% if driver_has_conflict %><span title="Conflict">⚠</span><% end %>
                            <% end %>
                          <% else %>
                            Unassigned ⚠
                          <% end %>
                        </span>

                        <span class="flex items-center gap-1.5 <%= service.vehicle ? 'text-gray-700' : 'text-amber-600 font-medium' %>">
                          <svg class="w-4 h-4 <%= service.vehicle ? 'text-gray-400' : 'text-amber-500' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                          <span class="text-gray-500 text-xs uppercase tracking-wider font-semibold">Vehicle:</span>
                          <% if service.vehicle %>
                            <%= link_to operations_admin_vehicle_path(service.vehicle, date: service.date.to_s), class: "font-semibold hover:underline #{vehicle_has_conflict ? 'text-red-600' : 'text-gray-900'}" do %>
                              <%= service.vehicle.name %> <span class="text-gray-500 text-xs font-medium">(<%= service.vehicle.plate_number %>)</span>
                              <% if vehicle_has_conflict %><span title="Conflict">⚠</span><% end %>
                            <% end %>
                          <% else %>
                            Unassigned ⚠
                          <% end %>
                        </span>
                      </div>

                      <% if service.notes.present? %>
                        <p class="text-sm text-gray-500 mt-2 italic bg-yellow-50 p-2 rounded border border-yellow-100"><%= service.notes %></p>
                      <% end %>
                    </div>

                    <%# Actions %>
                    <div class="flex-shrink-0 flex flex-row sm:flex-col items-center sm:items-end justify-end gap-3 mt-4 sm:mt-0 pt-4 sm:pt-0 border-t sm:border-t-0 border-gray-100 w-full sm:w-auto">
                      <%= link_to "Edit", edit_admin_booking_trip_service_path(@booking, service), class: "text-sm text-blue-600 hover:text-blue-900 font-bold w-1/2 sm:w-auto text-center bg-blue-50 sm:bg-transparent px-3 py-2 sm:p-0 rounded-md transition" %>
                      <%= link_to "Remove", admin_booking_trip_service_path(@booking, service), data: { turbo_method: :delete, turbo_confirm: "Remove this service from the journey?" }, class: "text-sm text-red-600 hover:text-red-900 font-bold w-1/2 sm:w-auto text-center bg-red-50 sm:bg-transparent px-3 py-2 sm:p-0 rounded-md transition" %>
                    </div>

                  </div>
                </div>
              <% end %>
            </div>
          </div>

        <% end %>
      </div>
    <% else %>
      <%# Empty State %>
      <div class="bg-white shadow rounded-lg p-10 text-center border border-gray-200">
        <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <h3 class="text-lg font-medium text-gray-900 mb-1">No services scheduled</h3>
        <p class="text-gray-500 text-sm mb-6 max-w-sm mx-auto">This booking doesn't have any legs on the journey yet. Add the first service to build the itinerary.</p>
        <%= link_to new_admin_booking_trip_service_path(@booking), class: "inline-flex items-center gap-2 px-5 py-2.5 bg-brand-green-600 hover:bg-brand-green-700 text-white font-medium rounded-md shadow-sm transition" do %>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Add First Service
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ═══════════════ SIDEBAR ═══════════════ %>
  <div class="space-y-8">
    <% if @booking.booking_request || @booking.trip_inquiry %>
      <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
          <h3 class="text-lg font-medium text-gray-900">Originating Lead</h3>
        </div>
        <div class="px-6 py-5">
          <% if @booking.booking_request %>
            <div class="mb-4">
              <span class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Source Request</span>
              <%= link_to "Booking Request ##{@booking.booking_request.id}", admin_booking_request_path(@booking.booking_request), class: "text-brand-green-600 hover:underline font-medium block mb-1" %>
              <div class="text-sm text-gray-700"><strong>Tour:</strong> <%= @booking.booking_request.tour.title %></div>
              <div class="text-sm text-gray-700"><strong>Guests:</strong> <%= @booking.booking_request.travelers_count %></div>
              <div class="text-sm text-gray-700"><strong>Date:</strong> <%= @booking.booking_request.travel_date&.to_formatted_s(:short) %></div>
            </div>
          <% end %>

          <% if @booking.trip_inquiry %>
            <div>
              <span class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Source Inquiry</span>
              <%= link_to "Trip Inquiry ##{@booking.trip_inquiry.id}", admin_trip_inquiry_path(@booking.trip_inquiry), class: "text-brand-green-600 hover:underline font-medium block mb-1" %>
              <div class="text-sm text-gray-700"><strong>Type:</strong> <%= @booking.trip_inquiry.inquiry_type.titleize %></div>
              <div class="text-sm text-gray-700"><strong>Guests:</strong> <%= @booking.trip_inquiry.travelers_count %></div>
              <div class="text-sm text-gray-700"><strong>Date:</strong> <%= @booking.trip_inquiry.travel_date&.to_formatted_s(:short) %></div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
      <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
        <h3 class="text-lg font-medium text-gray-900">Manage Status</h3>
      </div>
      <div class="px-6 py-5">
        <%= form_with(model: [:admin, @booking], local: true) do |f| %>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Current Status</label>
            <%= f.select :status, Booking::VALID_STATUSES.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 text-sm" %>
          </div>
          <%= f.submit "Update Status", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none cursor-pointer transition" %>
        <% end %>
      </div>
    </div>

    <%# Assignment summary %>
    <% if @booking.trip_services.any? %>
      <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
          <h3 class="text-lg font-medium text-gray-900">Assignment Summary</h3>
        </div>
        <div class="px-6 py-5 space-y-3">
          <% total = @booking.trip_services.size %>
          <% unassigned_driver = @booking.trip_services.where(driver_id: nil).count %>
          <% unassigned_vehicle = @booking.trip_services.where(vehicle_id: nil).count %>

          <div class="flex justify-between text-sm">
            <span class="text-gray-600">Total services</span>
            <span class="font-bold text-gray-900"><%= total %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="<%= unassigned_driver > 0 ? 'text-amber-600 font-medium' : 'text-gray-600' %>">Missing driver</span>
            <span class="font-bold <%= unassigned_driver > 0 ? 'text-amber-600' : 'text-gray-900' %>"><%= unassigned_driver %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="<%= unassigned_vehicle > 0 ? 'text-amber-600 font-medium' : 'text-gray-600' %>">Missing vehicle</span>
            <span class="font-bold <%= unassigned_vehicle > 0 ? 'text-amber-600' : 'text-gray-900' %>"><%= unassigned_vehicle %></span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
