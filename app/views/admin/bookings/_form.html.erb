<%= form_with(model: [:admin, @booking], class: "bg-white shadow rounded-lg p-6") do |f| %>
  <% if @booking.errors.any? %>
    <div class="bg-red-50 text-red-800 p-4 rounded-md mb-6">
      <h4 class="font-semibold text-sm">Please fix the following errors:</h4>
      <ul class="list-disc ps-5 text-sm mt-2">
        <% @booking.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="mb-4">
      <%= f.label :customer_id, class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :customer_id, Customer.order(:name), :id, :name, { prompt: "Select Customer" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
      <div class="mt-1 text-xs text-gray-500">
        Customer not here? <%= link_to "Create them first", new_admin_customer_path, target: "_blank", class: "text-brand-green-600 hover:underline" %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :status, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :status, Booking::VALID_STATUSES.map { |s| [s.titleize, s] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>

    <div class="mb-4">
      <%= f.label :source, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :source, Booking::VALID_SOURCES.map { |s| [s.titleize, s] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>

    <div class="mb-4 grid grid-cols-2 gap-2">
      <div>
        <%= f.label :start_date, class: "block text-sm font-medium text-gray-700" %>
        <%= f.date_field :start_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.label :end_date, class: "block text-sm font-medium text-gray-700" %>
        <%= f.date_field :end_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
      </div>
    </div>
  </div>

  <div class="mb-4">
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :notes, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
  </div>

  <div class="mt-6 flex justify-end gap-3">
    <%= link_to "Cancel", admin_bookings_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50" %>
    <%= f.submit class: "px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-medium hover:bg-gray-800 cursor-pointer" %>
  </div>
<% end %>
