<% content_for :title, "Operational Bookings" %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div class="flex flex-wrap gap-2">
    <%= link_to "All", admin_bookings_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{params[:status].blank? ? 'bg-gray-900 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'}" %>
    <% Booking::VALID_STATUSES.each do |status| %>
      <%= link_to status.capitalize, admin_bookings_path(status: status, source: params[:source]), class: "px-3 py-1.5 rounded-md text-sm font-medium #{params[:status] == status ? 'bg-gray-900 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'}" %>
    <% end %>
  </div>

  <div class="flex gap-2">
    <div class="relative">
      <select onchange="window.location.href=this.value" class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-brand-green-500 focus:border-brand-green-500 sm:text-sm rounded-md">
        <option value="<%= admin_bookings_path(status: params[:status]) %>">All Sources</option>
        <% Booking::VALID_SOURCES.each do |source| %>
          <option value="<%= admin_bookings_path(status: params[:status], source: source) %>" <%= 'selected' if params[:source] == source %>><%= source.titleize %></option>
        <% end %>
      </select>
    </div>
    <%= link_to "New Booking", new_admin_booking_path, class: "px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white rounded-md text-sm font-medium whitespace-nowrap" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Dates</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Services</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @bookings.each do |booking| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">#<%= booking.id %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= link_to booking.customer.name, admin_customer_path(booking.customer), class: "text-brand-green-600 hover:underline font-medium" %>
              <div class="text-xs text-gray-500 mt-1 capitalize"><%= booking.source.tr('_', ' ') %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% if booking.start_date || booking.end_date %>
                <%= booking.start_date&.to_fs(:short) || "?" %> &rarr; <%= booking.end_date&.to_fs(:short) || "?" %>
              <% else %>
                -
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <% total_services = booking.trip_services.size %>
              <% if total_services > 0 %>
                <div class="text-gray-900 font-medium"><%= total_services %> service<%= total_services == 1 ? '' : 's' %></div>
                <% unassigned = booking.trip_services.count { |s| s.driver_id.nil? || s.vehicle_id.nil? } %>
                <% if unassigned > 0 %>
                  <div class="text-amber-600 text-xs mt-1 font-medium"><%= unassigned %> needs assignment</div>
                <% end %>
              <% else %>
                <span class="text-gray-400">0 services</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% status_color = case booking.status
                                when 'confirmed', 'active' then 'bg-green-100 text-green-800'
                                when 'draft' then 'bg-yellow-100 text-yellow-800'
                                when 'cancelled' then 'bg-red-100 text-red-800'
                                else 'bg-gray-100 text-gray-800'
                                end %>
              <span class="px-2 py-1 <%= status_color %> rounded-full text-xs font-semibold capitalize"><%= booking.status %></span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
              <%= link_to "View", admin_booking_path(booking), class: "text-brand-green-600 hover:text-brand-green-900 me-3" %>
              <%= link_to "Edit", edit_admin_booking_path(booking), class: "text-blue-600 hover:text-blue-900 me-3" %>
              <%= link_to "Delete", admin_booking_path(booking), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @bookings.empty? %>
    <div class="p-8 text-center text-gray-500">No bookings found matching filters.</div>
  <% end %>
</div>
