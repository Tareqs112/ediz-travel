<% content_for :title, "Customers" %>

<div class="mb-6 flex items-center justify-between">
  <div></div>
  <%= link_to "New Customer", new_admin_customer_path, class: "px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white rounded-md text-sm font-medium" %>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Contact</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Language</th>
          <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @customers.each do |customer| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= customer.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% if customer.email.present? %>
                <div class="mb-1"><a href="mailto:<%= customer.email %>" class="text-brand-green-600 hover:underline"><%= customer.email %></a></div>
              <% end %>
              <% if customer.phone.present? %>
                <div><a href="tel:<%= customer.phone %>" class="text-gray-600 hover:underline"><%= customer.phone %></a></div>
              <% end %>
              <% if customer.email.blank? && customer.phone.blank? %>
                -
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= customer.preferred_language&.upcase || "-" %></td>
            <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
              <%= link_to "View", admin_customer_path(customer), class: "text-brand-green-600 hover:text-brand-green-900 me-3" %>
              <%= link_to "Edit", edit_admin_customer_path(customer), class: "text-blue-600 hover:text-blue-900 me-3" %>
              <%= link_to "Delete", admin_customer_path(customer), data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will delete the customer and all associated bookings." }, class: "text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @customers.empty? %>
    <div class="p-8 text-center text-gray-500">No records found.</div>
  <% end %>
</div>
