<% content_for :title, "View Tour" %>

<div class="mb-6 flex items-center justify-between">
  <%= link_to "&larr; Back to Tours".html_safe, admin_tours_path, class: "text-gray-500 hover:text-gray-700 font-medium text-sm" %>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_admin_tour_path(@tour), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50" %>
    <%= link_to "Delete", admin_tour_path(@tour), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-600 text-white rounded-md text-sm font-medium hover:bg-red-700" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
  <div class="px-6 py-5 border-b border-gray-200">
    <h3 class="text-lg font-medium leading-6 text-gray-900"><%= @tour.try(:name) || @tour.try(:title) %></h3>
  </div>
  <div class="px-6 py-5">
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-8">
      <% if @tour.image.attached? %>
        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500">Image</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= image_tag @tour.image, alt: @tour.title, class: "w-64 h-auto rounded-lg shadow-sm" %>
          </dd>
        </div>
      <% end %>
      <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Title</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.title %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Slug</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.slug %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Description</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.description %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Cancellation policy</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.cancellation_policy %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Duration</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.duration %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Group size</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.group_size %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Meeting point</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.meeting_point %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Tour type</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.tour_type %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Active</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.active %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Destination id</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.destination_id %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Included</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.included %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Excluded</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.excluded %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Highlights</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.highlights %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Languages</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @tour.languages %></dd>
          </div>
    </dl>
  </div>
</div>
