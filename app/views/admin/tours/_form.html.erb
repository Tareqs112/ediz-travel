<%= form_with(model: [:admin, @tour], class: "bg-white shadow rounded-lg p-6") do |f| %>
  <% if @tour.errors.any? %>
    <div class="bg-red-50 text-red-800 p-4 rounded-md mb-6">
      <h4 class="font-semibold text-sm">Please fix the following errors:</h4>
      <ul class="list-disc ps-5 text-sm mt-2">
        <% @tour.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="col-span-1">
      <%= f.label :slug, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :slug, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>
    <div class="col-span-1">
      <%= f.label :destination_id, class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :destination_id, Destination.all, :id, :name, { prompt: "Select Destination" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>

    <div class="col-span-1">
      <%= f.label :duration, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :duration, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>
    <div class="col-span-1">
      <%= f.label :group_size, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :group_size, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>

    <div class="col-span-1">
      <%= f.label :tour_type, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :tour_type, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>
    <div class="col-span-1">
      <%= f.label :languages, "Languages (Global, e.g. EN, AR)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :languages, value: Array(f.object.languages).join("\n"), rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
    </div>

    <div class="col-span-1 md:col-span-2">
      <%= f.label :image, class: "block text-sm font-medium text-gray-700" %>
      <%= f.file_field :image, class: "mt-1 block w-full text-sm text-gray-500 file:me-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-gray-50 file:text-gray-700 hover:file:bg-gray-100" %>
    </div>

    <div class="col-span-1 md:col-span-2">
      <div class="flex items-center gap-6 mt-2">
        <div class="flex items-center">
          <%= f.check_box :active, class: "h-4 w-4 text-brand-green-600 focus:ring-brand-green-500 border-gray-300 rounded" %>
          <%= f.label :active, class: "ms-2 block text-sm text-gray-900" %>
        </div>
        <div class="flex items-center">
          <%= f.check_box :featured, class: "h-4 w-4 text-brand-green-600 focus:ring-brand-green-500 border-gray-300 rounded" %>
          <%= f.label :featured, class: "ms-2 block text-sm text-gray-900" %>
        </div>
      </div>
    </div>
  </div>

  <div class="mb-8 pt-6 border-t border-gray-200">
    <h3 class="text-lg font-medium text-gray-900 mb-4 border-b pb-2">Pricing Information</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :price_from, "Starting Price", class: "block text-sm font-medium text-gray-700" %>
        <div class="mt-1 flex rounded-md shadow-sm">
          <%= f.text_field :price_from, class: "flex-1 min-w-0 block w-full px-3 py-2 rounded-none rounded-s-md border-gray-300 focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm", placeholder: "e.g. 150.00" %>
          <%= f.text_field :currency, class: "inline-flex items-center px-3 py-2 rounded-none rounded-e-md border border-s-0 border-gray-300 bg-gray-50 text-gray-500 sm:text-sm w-24", placeholder: "USD" %>
        </div>
      </div>
    </div>
  </div>

  <% [ ['en', 'English'], ['ar', 'Arabic'], ['tr', 'Turkish'] ].each do |loc, loc_name| %>
    <div class="mb-8 pt-6 border-t border-gray-200">
      <h3 class="text-xl font-semibold text-gray-900 mb-6"><%= loc_name %> Content <%= loc == 'en' ? '(Required)' : '(Optional Fallback)' %></h3>

      <div class="grid grid-cols-1 gap-6">
        <div>
          <%= f.label :"title_#{loc}", "Title", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :"title_#{loc}", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :"description_#{loc}", "Description", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_area :"description_#{loc}", rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :"cancellation_policy_#{loc}", "Cancellation Policy", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_area :"cancellation_policy_#{loc}", rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :"meeting_point_#{loc}", "Meeting Point", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_area :"meeting_point_#{loc}", rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm" %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <%= f.label :"included_#{loc}", "Included (One per line)", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_area :"included_#{loc}", value: Array(f.object.send(:"included_#{loc}")).join("\n"), rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>
          </div>
          <div>
            <%= f.label :"excluded_#{loc}", "Excluded (One per line)", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_area :"excluded_#{loc}", value: Array(f.object.send(:"excluded_#{loc}")).join("\n"), rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>
          </div>
          <div>
            <%= f.label :"highlights_#{loc}", "Highlights (One per line)", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_area :"highlights_#{loc}", value: Array(f.object.send(:"highlights_#{loc}")).join("\n"), rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>
          </div>
        </div>

        <div class="mt-4 bg-gray-50 p-4 rounded-lg border border-gray-200">
          <h4 class="text-md font-medium text-gray-900 mb-4">Itinerary (<%= loc_name %>)</h4>
          <div class="space-y-4">
            <%
               current_itinerary = Array(f.object.send(:"itinerary_#{loc}"))
               10.times do |i|
                 day_data = current_itinerary[i] || {}
            %>
              <div class="grid grid-cols-1 gap-4 p-4 bg-white border border-gray-200 rounded-md">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                  <div class="md:col-span-2">
                    <label class="block text-xs font-medium text-gray-700">Order / Stop</label>
                    <input type="text" name="tour[itinerary_<%= loc %>][][order]" value="<%= day_data['order'] || day_data[:order] || day_data['day'] || day_data[:day] || (i + 1) %>" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                  </div>
                  <div class="md:col-span-4">
                    <label class="block text-xs font-medium text-gray-700">Location (Optional)</label>
                    <input type="text" name="tour[itinerary_<%= loc %>][][location]" value="<%= day_data['location'] || day_data[:location] %>" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                  </div>
                  <div class="md:col-span-4">
                    <label class="block text-xs font-medium text-gray-700">Title</label>
                    <input type="text" name="tour[itinerary_<%= loc %>][][title]" value="<%= day_data['title'] || day_data[:title] %>" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                  </div>
                  <div class="md:col-span-2">
                    <label class="block text-xs font-medium text-gray-700">Duration (Approx.)</label>
                    <input type="text" name="tour[itinerary_<%= loc %>][][duration]" value="<%= day_data['duration'] || day_data[:duration] %>" placeholder="e.g. 45 min" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700">Description</label>
                  <textarea name="tour[itinerary_<%= loc %>][][desc]" rows="2" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm"><%= day_data['desc'] || day_data[:desc] %></textarea>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancel", admin_tours_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50" %>
    <%= f.submit class: "px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-medium hover:bg-gray-800 cursor-pointer" %>
  </div>
<% end %>
