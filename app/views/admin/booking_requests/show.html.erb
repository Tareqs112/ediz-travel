<% content_for :title, "Booking Request Details" %>

<div class="mb-6">
  <%= link_to "&larr; Back to Requests".html_safe, admin_booking_requests_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <!-- Details -->
  <div class="lg:col-span-2 space-y-8">
    <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
      <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
        <h3 class="text-lg font-medium text-gray-900">Customer Information</h3>
      </div>
      <div class="px-6 py-5">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6">
          <div>
            <dt class="text-sm font-medium text-gray-500">Full Name</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @booking_request.customer_name %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Email Address</dt>
            <dd class="mt-1 text-sm text-gray-900"><a href="mailto:<%= @booking_request.email %>" class="text-brand-green-600 hover:underline"><%= @booking_request.email %></a></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Phone / WhatsApp</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <% if @booking_request.phone.present? %>
                <a href="tel:<%= @booking_request.phone %>" class="text-brand-green-600 hover:underline"><%= @booking_request.phone %></a>
              <% else %>
                -
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Preferred Language</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @booking_request.preferred_language.presence || "-" %></dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
      <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
        <h3 class="text-lg font-medium text-gray-900">Trip Details</h3>
      </div>
      <div class="px-6 py-5">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6">
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Requested Tour</dt>
            <dd class="mt-1 text-sm text-gray-900 font-medium"><%= @booking_request.tour.title %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Travel Date</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @booking_request.travel_date.to_formatted_s(:long) %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Number of Travelers</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @booking_request.travelers_count %> Guests</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Additional Notes</dt>
            <dd class="mt-1 text-sm text-gray-900 bg-gray-50 p-4 rounded-md"><%= @booking_request.notes.presence || "No additional notes provided." %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-8">
    <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
      <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
        <h3 class="text-lg font-medium text-gray-900">Manage Status</h3>
      </div>
      <div class="px-6 py-5">
        
        <% if @booking_request.errors.any? %>
          <div class="bg-red-50 text-red-800 p-3 mb-4 rounded text-sm">
            <%= @booking_request.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <%= form_with(model: [:admin, @booking_request], local: true) do |f| %>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Current Status</label>
            <%= f.select :status, BookingRequest::VALID_STATUSES.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 text-sm" %>
          </div>
          <%= f.submit "Update Status", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none" %>
        <% end %>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
      <div class="px-6 py-5">
        <dt class="text-sm font-medium text-gray-500">Date Received</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @booking_request.created_at.to_formatted_s(:long) %></dd>
      </div>
    </div>
  </div>
</div>
