<% content_for :title, "Accommodations" %>

<div class="mb-6 flex items-center justify-between">
  <div></div>
  <%= link_to "New Accommodation", new_admin_accommodation_path, class: "px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white rounded-md text-sm font-medium" %>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Slug</th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Accommodation type</th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Active</th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase tracking-wider">Featured</th>
          <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @accommodations.each do |record| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= record.name %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= record.slug %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= record.accommodation_type %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= record.active ? '<span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold">Yes</span>'.html_safe : '<span class="px-2 py-1 bg-gray-100 text-gray-800 rounded-full text-xs font-semibold">No</span>'.html_safe %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= record.featured ? '<span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold">Yes</span>'.html_safe : '<span class="px-2 py-1 bg-gray-100 text-gray-800 rounded-full text-xs font-semibold">No</span>'.html_safe %></td>
            <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
              <%= link_to "View", admin_accommodation_path(record), class: "text-brand-green-600 hover:text-brand-green-900 me-3" %>
              <%= link_to "Edit", edit_admin_accommodation_path(record), class: "text-blue-600 hover:text-blue-900 me-3" %>
              <%= link_to "Delete", admin_accommodation_path(record), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @accommodations.empty? %>
    <div class="p-8 text-center text-gray-500">No records found.</div>
  <% end %>
</div>
