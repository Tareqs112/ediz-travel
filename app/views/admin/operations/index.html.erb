<% content_for :title, "Daily Operations — #{@date.strftime("%A, %d %b %Y")}" %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div class="flex items-center gap-2">
    <%= link_to "← Prev", admin_operations_path(date: @date.yesterday), class: "px-3 py-1.5 bg-white border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50" %>
    <%= link_to "Today", admin_operations_path, class: "px-4 py-1.5 #{@date == Date.today ? 'bg-gray-900 text-white' : 'bg-white text-gray-900 border border-gray-300 hover:bg-gray-50'} rounded-md text-sm font-medium" %>
    <%= link_to "Next →", admin_operations_path(date: @date.tomorrow), class: "px-3 py-1.5 bg-white border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50" %>
  </div>

  <div class="flex items-center gap-2">
    <form action="<%= admin_operations_path %>" method="get" class="flex gap-2">
      <input type="date" name="date" value="<%= @date %>" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm">
      <button type="submit" class="px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-medium hover:bg-gray-800">Go</button>
    </form>
  </div>
</div>

<%# Summary Stats %>
<div class="mb-8 grid grid-cols-2 md:grid-cols-6 gap-4">
  <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
    <div class="text-xs font-medium text-gray-500 uppercase">Total Services</div>
    <div class="mt-1 text-2xl font-semibold text-gray-900"><%= @total %></div>
  </div>
  <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
    <div class="text-xs font-medium text-gray-500 uppercase">Assigned</div>
    <div class="mt-1 text-2xl font-semibold text-green-600"><%= @assigned %></div>
  </div>
  <div class="bg-white p-4 rounded-lg shadow-sm border <%= @needs_driver > 0 ? 'border-amber-300 bg-amber-50' : 'border-gray-200' %>">
    <div class="text-xs font-medium text-gray-500 uppercase">Needs Driver</div>
    <div class="mt-1 text-2xl font-semibold <%= @needs_driver > 0 ? 'text-amber-700' : 'text-gray-900' %>"><%= @needs_driver %></div>
  </div>
  <div class="bg-white p-4 rounded-lg shadow-sm border <%= @needs_vehicle > 0 ? 'border-amber-300 bg-amber-50' : 'border-gray-200' %>">
    <div class="text-xs font-medium text-gray-500 uppercase">Needs Vehicle</div>
    <div class="mt-1 text-2xl font-semibold <%= @needs_vehicle > 0 ? 'text-amber-700' : 'text-gray-900' %>"><%= @needs_vehicle %></div>
  </div>
  <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
    <div class="text-xs font-medium text-gray-500 uppercase">In Progress</div>
    <div class="mt-1 text-2xl font-semibold text-blue-600"><%= @in_progress %></div>
  </div>
  <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
    <div class="text-xs font-medium text-gray-500 uppercase">Completed</div>
    <div class="mt-1 text-2xl font-semibold text-gray-900"><%= @completed %></div>
  </div>
</div>

<%# Conflicts %>
<% if @driver_conflicts.any? || @vehicle_conflicts.any? %>
  <div class="mb-8 space-y-4">
    <% @driver_conflicts.each do |driver_id, conflict| %>
      <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-md">
        <div class="flex items-start">
          <div class="flex-shrink-0 text-red-500">⚠</div>
          <div class="ml-3">
            <h3 class="text-sm font-bold text-red-800">Driver Conflict: <%= conflict[:name] %></h3>
            <div class="mt-1 text-sm text-red-700">
              Assigned to overlapping services: 
              <% conflict[:service_ids].each do |id| %>
                <a href="#service-<%= id %>" class="underline hover:text-red-900">#<%= id %></a>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% @vehicle_conflicts.each do |vehicle_id, conflict| %>
      <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-md">
        <div class="flex items-start">
          <div class="flex-shrink-0 text-red-500">⚠</div>
          <div class="ml-3">
            <h3 class="text-sm font-bold text-red-800">Vehicle Conflict: <%= conflict[:name] %></h3>
            <div class="mt-1 text-sm text-red-700">
              Assigned to overlapping services:
              <% conflict[:service_ids].each do |id| %>
                <a href="#service-<%= id %>" class="underline hover:text-red-900">#<%= id %></a>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%# Services List %>
<% if @services.any? %>
  <div class="space-y-4">
    <% @services.each do |service| %>
      <% is_cancelled = service.status == 'cancelled' %>
      <% driver_has_conflict = @driver_conflicts[service.driver_id]&.dig(:service_ids)&.include?(service.id) %>
      <% vehicle_has_conflict = @vehicle_conflicts[service.vehicle_id]&.dig(:service_ids)&.include?(service.id) %>
      <% has_conflict = driver_has_conflict || vehicle_has_conflict %>
      
      <div id="service-<%= service.id %>" class="bg-white rounded-lg shadow-sm border <%= has_conflict ? 'border-red-300' : 'border-gray-200' %> overflow-hidden <%= 'opacity-50' if is_cancelled %>">
        <div class="p-5 flex flex-col md:flex-row md:items-start gap-4">
          
          <%# Time %>
          <div class="w-32 flex-shrink-0">
            <div class="text-lg font-bold text-gray-900">
              <%= service.start_time ? service.start_time.strftime("%H:%M") : "TBD" %>
            </div>
            <% if service.end_time %>
              <div class="text-sm text-gray-500">to <%= service.end_time.strftime("%H:%M") %></div>
            <% end %>
          </div>

          <%# Core Details %>
          <div class="flex-1 min-w-0 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <div class="text-sm font-bold text-gray-900 mb-1">
                <%= service.service_type.titleize %>
                <% if is_cancelled %>
                  <span class="ml-2 px-2 py-0.5 text-xs bg-red-100 text-red-800 rounded-full font-semibold">Cancelled</span>
                <% elsif service.status == 'in_progress' %>
                  <span class="ml-2 px-2 py-0.5 text-xs bg-blue-100 text-blue-800 rounded-full font-semibold">In Progress</span>
                <% elsif service.status == 'completed' %>
                  <span class="ml-2 px-2 py-0.5 text-xs bg-green-100 text-green-800 rounded-full font-semibold">Completed</span>
                <% end %>
              </div>
              
              <div class="text-sm text-gray-700 mb-2">
                <%= link_to service.booking.customer.name, admin_customer_path(service.booking.customer), class: "font-medium hover:underline text-brand-green-700" %>
                <% travelers = service.booking.booking_request&.travelers_count || service.booking.trip_inquiry&.travelers_count %>
                <% if travelers %>
                  <span class="text-gray-500">· <%= travelers %> travelers</span>
                <% end %>
                · <%= link_to "Booking ##{service.booking.id}", admin_booking_path(service.booking), class: "text-gray-500 hover:underline" %>
              </div>

              <% if service.pickup_location.present? || service.dropoff_location.present? %>
                <div class="text-sm text-gray-600 flex items-start gap-1.5 mt-1">
                  <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  <span><%= service.pickup_location.presence || "—" %> &rarr; <%= service.dropoff_location.presence || "—" %></span>
                </div>
              <% end %>
              
              <% if service.notes.present? %>
                <div class="text-xs text-gray-500 italic mt-2"><%= service.notes %></div>
              <% end %>
            </div>

            <%# Assignments %>
            <div class="bg-gray-50 rounded p-3 text-sm flex flex-col justify-center <%= has_conflict ? 'border border-red-200' : '' %>">
              <div class="mb-2">
                <span class="text-gray-500 w-16 inline-block">Driver:</span>
                <% if service.driver %>
                  <%= link_to operations_admin_driver_path(service.driver, date: @date.to_s), class: "font-medium hover:underline #{driver_has_conflict ? 'text-red-600' : 'text-brand-green-700'}" do %>
                    <%= service.driver.name %>
                    <% if driver_has_conflict %>⚠<% end %>
                  <% end %>
                <% else %>
                  <span class="text-amber-600 font-bold">⚠ Unassigned</span>
                <% end %>
              </div>
              
              <div>
                <span class="text-gray-500 w-16 inline-block">Vehicle:</span>
                <% if service.vehicle %>
                  <%= link_to operations_admin_vehicle_path(service.vehicle, date: @date.to_s), class: "font-medium hover:underline #{vehicle_has_conflict ? 'text-red-600' : 'text-brand-green-700'}" do %>
                    <%= service.vehicle.name %> <span class="text-gray-400 text-xs">(<%= service.vehicle.plate_number %>)</span>
                    <% if vehicle_has_conflict %>⚠<% end %>
                  <% end %>
                <% else %>
                  <span class="text-amber-600 font-bold">⚠ Unassigned</span>
                <% end %>
              </div>
            </div>
          </div>

          <%# Actions %>
          <div class="md:text-right flex-shrink-0 pt-2 md:pt-0">
            <%= link_to "Edit / Assign", edit_admin_booking_trip_service_path(service.booking, service), class: "inline-block px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white p-12 text-center rounded-lg shadow-sm border border-gray-200">
    <h3 class="text-lg font-medium text-gray-900">No Services Scheduled</h3>
    <p class="mt-2 text-sm text-gray-500">There are no trip services scheduled for <%= @date.strftime("%A, %d %b %Y") %>.</p>
  </div>
<% end %>
