<%= content_for :title, "Availability Lookup" %>

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Who's Free?</h1>
    <p class="text-sm text-gray-500 mt-1">
      Check driver and vehicle availability for a requested time window.
      Respects the <%= TripService::BUFFER_MINUTES %>-minute operational buffer.
    </p>
  </div>
  <div>
    <%= link_to "← Back to Operations", admin_operations_path(date: @date.to_s), class: "text-sm text-brand-green-700 font-medium hover:underline" %>
  </div>
</div>

<%# ─── QUERY FORM ─── %>
<div class="bg-white p-4 md:p-6 rounded-lg shadow-sm border border-gray-200 mb-8">
  <%= form_with url: admin_operations_availability_path, method: :get,
                class: "grid grid-cols-2 sm:grid-cols-4 gap-3 items-end" do |f| %>
    <div>
      <%= f.label :date, "Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :date, value: @date,
            class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm py-2 px-3" %>
    </div>
    <div>
      <%= f.label :start_time, "Start Time", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.time_field :start_time, value: @start_time,
            class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm py-2 px-3" %>
    </div>
    <div>
      <%= f.label :end_time, "End Time", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.time_field :end_time, value: @end_time,
            class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green-500 focus:ring-brand-green-500 sm:text-sm py-2 px-3",
            placeholder: "optional" %>
    </div>
    <div>
      <%= f.submit "Check", class: "w-full px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-bold hover:bg-gray-800 cursor-pointer" %>
    </div>
  <% end %>

  <%# Query summary %>
  <p class="mt-3 text-xs text-gray-500">
    Checking: <strong><%= @date.strftime("%A, %B %d, %Y") %></strong>
    &nbsp;·&nbsp;
    <strong><%= @start_time %></strong>
    <% if @end_time.present? %>
      &rarr; <strong><%= @end_time %></strong>
    <% else %>
      (point-in-time)
    <% end %>
    &nbsp;·&nbsp; Buffer: ±<%= TripService::BUFFER_MINUTES %> min
  </p>
</div>

<%# ─── RESULTS ─── %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

  <%# ══ DRIVERS ══ %>
  <div>
    <h2 class="text-lg font-bold text-gray-900 mb-5 flex items-center gap-2">
      <svg class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      Drivers
    </h2>

    <%
      available_drivers = @drivers.reject { |d| @driver_blocking.key?(d.id) }
      busy_drivers      = @drivers.select { |d| @driver_blocking.key?(d.id) }
    %>

    <%# AVAILABLE %>
    <% if available_drivers.any? %>
      <div class="mb-5">
        <div class="text-xs font-bold text-green-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Available (<%= available_drivers.size %>)
        </div>
        <div class="space-y-2">
          <% available_drivers.each do |driver| %>
            <div class="bg-green-50 border border-green-200 rounded-md px-4 py-2.5 flex items-center gap-3">
              <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="font-semibold text-gray-900 text-sm"><%= driver.name %></span>
              <% if driver.is_external %>
                <span class="text-[10px] uppercase font-bold text-gray-500 bg-gray-200 px-1.5 py-0.5 rounded ms-auto">External</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# BUSY %>
    <% if busy_drivers.any? %>
      <div>
        <div class="text-xs font-bold text-red-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
          Busy (<%= busy_drivers.size %>)
        </div>
        <div class="space-y-3">
          <% busy_drivers.each do |driver| %>
            <% blocking_services = @driver_blocking[driver.id] %>
            <div class="bg-red-50 border border-red-200 rounded-md overflow-hidden">
              <div class="px-4 py-2.5 flex items-center gap-2 border-b border-red-100">
                <svg class="w-4 h-4 text-red-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <span class="font-bold text-gray-900 text-sm"><%= driver.name %></span>
                <% if driver.is_external %>
                  <span class="text-[10px] uppercase font-bold text-gray-500 bg-gray-200 px-1.5 py-0.5 rounded">External</span>
                <% end %>
                <span class="ms-auto text-xs font-bold text-red-700 uppercase">Busy</span>
              </div>
              <div class="divide-y divide-red-100">
                <% blocking_services.each do |svc| %>
                  <div class="px-4 py-3 text-xs text-red-800 space-y-1.5">
                    <div class="font-semibold text-gray-800 text-sm">
                      <%= svc.start_time.strftime("%H:%M") %> – <%= svc.end_time.strftime("%H:%M") %>
                      <span class="text-gray-500 font-normal">(<%= svc.service_type.titleize %>)</span>
                    </div>
                    <div class="text-gray-500">
                      Buffer block:
                      <%= (svc.start_time - TripService::BUFFER_MINUTES.minutes).strftime("%H:%M") %>
                      –
                      <%= (svc.end_time + TripService::BUFFER_MINUTES.minutes).strftime("%H:%M") %>
                    </div>
                    <% if svc.pickup_location.present? || svc.dropoff_location.present? %>
                      <div class="text-gray-600">
                        <%= svc.pickup_location.presence %>
                        <% if svc.pickup_location.present? && svc.dropoff_location.present? %>
                          <span class="mx-0.5">→</span>
                        <% end %>
                        <%= svc.dropoff_location.presence %>
                      </div>
                    <% end %>
                    <div class="flex items-center gap-3 pt-0.5">
                      <% if svc.booking&.customer %>
                        <span class="text-gray-700 font-medium"><%= svc.booking.customer.name %></span>
                      <% end %>
                      <%= link_to "View Booking →", admin_booking_path(svc.booking),
                            class: "text-brand-green-700 font-bold hover:underline" %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @drivers.empty? %>
      <p class="text-sm text-gray-400 italic">No active drivers found.</p>
    <% end %>
  </div>

  <%# ══ VEHICLES ══ %>
  <div>
    <h2 class="text-lg font-bold text-gray-900 mb-5 flex items-center gap-2">
      <svg class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
      </svg>
      Vehicles
    </h2>

    <%
      available_vehicles = @vehicles.reject { |v| @vehicle_blocking.key?(v.id) }
      busy_vehicles      = @vehicles.select { |v| @vehicle_blocking.key?(v.id) }
    %>

    <%# AVAILABLE %>
    <% if available_vehicles.any? %>
      <div class="mb-5">
        <div class="text-xs font-bold text-green-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Available (<%= available_vehicles.size %>)
        </div>
        <div class="space-y-2">
          <% available_vehicles.each do |vehicle| %>
            <div class="bg-green-50 border border-green-200 rounded-md px-4 py-2.5 flex flex-wrap items-center gap-x-3 gap-y-1">
              <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="font-semibold text-gray-900 text-sm"><%= vehicle.name %></span>
              <span class="text-xs text-gray-500" dir="ltr"><%= vehicle.plate_number %></span>
              <% if vehicle.vehicle_type.present? %>
                <span class="text-[10px] uppercase font-bold text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded"><%= vehicle.vehicle_type.titleize %></span>
              <% end %>
              <% if vehicle.ownership_type.present? %>
                <span class="text-[10px] uppercase font-bold text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded ms-auto"><%= vehicle.ownership_type.titleize %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# BUSY %>
    <% if busy_vehicles.any? %>
      <div>
        <div class="text-xs font-bold text-red-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
          Busy (<%= busy_vehicles.size %>)
        </div>
        <div class="space-y-3">
          <% busy_vehicles.each do |vehicle| %>
            <% blocking_services = @vehicle_blocking[vehicle.id] %>
            <div class="bg-red-50 border border-red-200 rounded-md overflow-hidden">
              <div class="px-4 py-2.5 flex flex-wrap items-center gap-x-2 gap-y-1 border-b border-red-100">
                <svg class="w-4 h-4 text-red-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <span class="font-bold text-gray-900 text-sm"><%= vehicle.name %></span>
                <span class="text-xs text-gray-500" dir="ltr"><%= vehicle.plate_number %></span>
                <% if vehicle.vehicle_type.present? %>
                  <span class="text-[10px] uppercase font-bold text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded"><%= vehicle.vehicle_type.titleize %></span>
                <% end %>
                <% if vehicle.ownership_type.present? %>
                  <span class="text-[10px] uppercase font-bold text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded"><%= vehicle.ownership_type.titleize %></span>
                <% end %>
                <span class="ms-auto text-xs font-bold text-red-700 uppercase">Busy</span>
              </div>
              <div class="divide-y divide-red-100">
                <% blocking_services.each do |svc| %>
                  <div class="px-4 py-3 text-xs text-red-800 space-y-1.5">
                    <div class="font-semibold text-gray-800 text-sm">
                      <%= svc.start_time.strftime("%H:%M") %> – <%= svc.end_time.strftime("%H:%M") %>
                      <span class="text-gray-500 font-normal">(<%= svc.service_type.titleize %>)</span>
                    </div>
                    <div class="text-gray-500">
                      Buffer block:
                      <%= (svc.start_time - TripService::BUFFER_MINUTES.minutes).strftime("%H:%M") %>
                      –
                      <%= (svc.end_time + TripService::BUFFER_MINUTES.minutes).strftime("%H:%M") %>
                    </div>
                    <% if svc.pickup_location.present? || svc.dropoff_location.present? %>
                      <div class="text-gray-600">
                        <%= svc.pickup_location.presence %>
                        <% if svc.pickup_location.present? && svc.dropoff_location.present? %>
                          <span class="mx-0.5">→</span>
                        <% end %>
                        <%= svc.dropoff_location.presence %>
                      </div>
                    <% end %>
                    <div class="flex items-center gap-3 pt-0.5">
                      <% if svc.booking&.customer %>
                        <span class="text-gray-700 font-medium"><%= svc.booking.customer.name %></span>
                      <% end %>
                      <%= link_to "View Booking →", admin_booking_path(svc.booking),
                            class: "text-brand-green-700 font-bold hover:underline" %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @vehicles.empty? %>
      <p class="text-sm text-gray-400 italic">No active vehicles found.</p>
    <% end %>
  </div>

</div>
