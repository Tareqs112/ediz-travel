<% content_for :title, "Vehicle: #{@vehicle.name}" %>

<div class="mb-6 flex items-center justify-between">
  <%= link_to "← Back to Vehicles", admin_vehicles_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  <div class="flex gap-3">
    <%= link_to "Edit", edit_admin_vehicle_path(@vehicle), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50" %>
    <%= link_to "Delete", admin_vehicle_path(@vehicle), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-600 text-white rounded-md text-sm font-medium hover:bg-red-700" %>
  </div>
</div>

<div class="bg-white shadow overflow-hidden sm:rounded-lg">
  <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
    <div>
      <h3 class="text-lg leading-6 font-medium text-gray-900">Vehicle Information</h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">Fleet details and status.</p>
    </div>
    <div>
      <% if @vehicle.active %>
        <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-semibold">Active</span>
      <% else %>
        <span class="px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-sm font-semibold">Inactive</span>
      <% end %>
    </div>
  </div>
  <div class="border-t border-gray-200 px-4 py-5 sm:p-0">
    <dl class="sm:divide-y sm:divide-gray-200">
      <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Name / Identifier</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @vehicle.name %></dd>
      </div>
      <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Plate number</dt>
        <dd class="mt-1 text-sm font-mono font-bold text-gray-900 sm:mt-0 sm:col-span-2"><%= @vehicle.plate_number %></dd>
      </div>
      <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Vehicle type</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @vehicle.vehicle_type.presence || "—" %></dd>
      </div>
      <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Ownership</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @vehicle.ownership_type.presence || "—" %></dd>
      </div>
      <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Notes</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 whitespace-pre-wrap"><%= @vehicle.notes.presence || "No notes." %></dd>
      </div>
    </dl>
  </div>
</div>
