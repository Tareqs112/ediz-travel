<% content_for :title, "View Destination" %>

<div class="mb-6 flex items-center justify-between">
  <%= link_to "&larr; Back to Destinations".html_safe, admin_destinations_path, class: "text-gray-500 hover:text-gray-700 font-medium text-sm" %>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_admin_destination_path(@destination), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50" %>
    <%= link_to "Delete", admin_destination_path(@destination), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-600 text-white rounded-md text-sm font-medium hover:bg-red-700" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
  <div class="px-6 py-5 border-b border-gray-200">
    <h3 class="text-lg font-medium leading-6 text-gray-900"><%= @destination.try(:name) || @destination.try(:title) %></h3>
  </div>
  <div class="px-6 py-5">
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-8">
      <% if @destination.image.attached? %>
        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500">Image</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= image_tag @destination.image, alt: @destination.name, class: "w-64 h-auto rounded-lg shadow-sm" %>
          </dd>
        </div>
      <% end %>
      <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Name</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @destination.name %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Slug</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @destination.slug %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Description</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @destination.description %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Short description</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @destination.short_description %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Region</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @destination.region %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Best time to visit</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @destination.best_time_to_visit %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Active</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @destination.active %></dd>
          </div>
    </dl>
  </div>
</div>
