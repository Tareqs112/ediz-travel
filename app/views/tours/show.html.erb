<div class="container-main py-24 min-h-screen max-w-4xl">
  <%= link_to "&larr; Back to all tours".html_safe, tours_path, class: "inline-block mb-10 text-brand-charcoal-600 hover:text-brand-charcoal-900 font-medium transition-colors" %>

  <div class="bg-white border border-brand-gray-200/60 rounded-xl overflow-hidden shadow-sm">
    
    <!-- Image Placeholder / Asset -->
    <div class="w-full aspect-[21/9] bg-[#faf9f6] border-b border-brand-gray-200/60 relative overflow-hidden flex items-center justify-center">
      <% if @tour.image.attached? %>
        <%= image_tag @tour.image, class: "w-full h-full object-cover" %>
      <% else %>
        <div class="text-brand-gray-400 flex flex-col items-center">
          <svg class="w-12 h-12 mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
          <span class="text-xs uppercase tracking-widest font-semibold">Development Placeholder: Image Pending</span>
        </div>
      <% end %>
    </div>

    <!-- Tour Details -->
    <div class="p-10 lg:p-14">
      <span class="text-sm font-semibold text-brand-gold-500 uppercase tracking-widest block mb-4">
        <%= @tour.destination %>
      </span>
      
      <h1 class="text-4xl lg:text-5xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-tight mb-8">
        <%= @tour.title %>
      </h1>
      
      <div class="prose prose-lg text-brand-charcoal-600 font-light leading-relaxed max-w-none">
        <p><%= @tour.description %></p>
      </div>
    </div>
  </div>
</div>
