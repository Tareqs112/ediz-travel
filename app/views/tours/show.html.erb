<div class="bg-white min-h-screen">
  
  <!-- Back Navigation -->
  <div class="container-main pt-8 lg:pt-12 pb-6">
    <%= link_to tours_path, class: "inline-flex items-center text-sm font-medium text-brand-charcoal-600 hover:text-brand-gold-500 transition-colors uppercase tracking-widest" do %>
      <span class="mr-2">&larr;</span> Back to all tours
    <% end %>
  </div>

  <!-- Hero Image -->
  <div class="w-full relative bg-[#faf9f6] border-y border-brand-gray-200/60 overflow-hidden">
    <div class="aspect-[16/9] lg:aspect-[21/9] w-full">
      <% if @tour.image.attached? %>
        <%= image_tag @tour.image, class: "w-full h-full object-cover" %>
      <% else %>
        <div class="w-full h-full flex flex-col items-center justify-center text-brand-gray-400">
          <svg class="w-12 h-12 mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
          <span class="text-xs uppercase tracking-widest font-semibold text-brand-gray-400">Image Asset Pending</span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="container-main py-16 lg:py-24">
    
    <!-- Tour Header -->
    <div class="max-w-4xl mx-auto text-center mb-16 lg:mb-24">
      <span class="text-sm font-semibold text-brand-gold-500 uppercase tracking-[0.2em] block mb-6">
        <%= @tour.destination %>
      </span>
      <h1 class="text-4xl lg:text-6xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.1] mb-8">
        <%= @tour.title %>
      </h1>
      <p class="text-lg lg:text-xl text-brand-charcoal-600 font-light leading-relaxed max-w-3xl mx-auto">
        <%= @tour.description.sub(/\A\[DEVELOPMENT PLACEHOLDER\]\s*/, "") %>
      </p>
    </div>

    <!-- Tour Info Row -->
    <div class="max-w-5xl mx-auto border-t border-b border-brand-gray-200/60 py-8 lg:py-12 mb-16 lg:mb-24">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4 text-center divide-x-0 md:divide-x divide-brand-gray-200/60">
        
        <div class="flex flex-col px-4">
          <span class="text-xs text-brand-charcoal-500 uppercase tracking-widest mb-2 font-medium">Duration</span>
          <span class="text-lg font-light text-brand-charcoal-900"><%= @tour.duration.presence || "Variable" %></span>
        </div>
        
        <div class="flex flex-col px-4">
          <span class="text-xs text-brand-charcoal-500 uppercase tracking-widest mb-2 font-medium">Tour Type</span>
          <span class="text-lg font-light text-brand-charcoal-900"><%= @tour.tour_type.presence || "Custom" %></span>
        </div>
        
        <div class="flex flex-col px-4">
          <span class="text-xs text-brand-charcoal-500 uppercase tracking-widest mb-2 font-medium">Group Size</span>
          <span class="text-lg font-light text-brand-charcoal-900"><%= @tour.group_size.presence || "Flexible" %></span>
        </div>
        
        <div class="flex flex-col px-4">
          <span class="text-xs text-brand-charcoal-500 uppercase tracking-widest mb-2 font-medium">Languages</span>
          <span class="text-lg font-light text-brand-charcoal-900">
            <%= @tour.languages.present? ? @tour.languages.join(", ") : "English, Turkish" %>
          </span>
        </div>

      </div>
    </div>

    <!-- Main Content & Sidebar -->
    <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-16 lg:gap-24">
      
      <!-- Left Column (Content) -->
      <div class="w-full lg:w-2/3">
        
        <!-- Itinerary -->
        <% if @tour.itinerary.present? && @tour.itinerary.any? %>
          <div class="mb-16">
            <h2 class="text-2xl font-medium text-brand-charcoal-900 mb-8 pb-4 border-b border-brand-gray-200/60">Itinerary</h2>
            <div class="space-y-12">
              <% @tour.itinerary.each do |day| %>
                <div class="flex flex-col md:flex-row gap-4 md:gap-8">
                  <div class="md:w-32 flex-shrink-0">
                    <span class="text-sm font-semibold text-brand-gold-500 uppercase tracking-widest block">Day <%= day['day'] || day[:day] %></span>
                  </div>
                  <div>
                    <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= day['title'] || day[:title] %></h3>
                    <p class="text-brand-charcoal-600 font-light leading-relaxed">
                      <%= day['desc'] || day[:desc] %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Included / Excluded -->
        <div class="grid md:grid-cols-2 gap-12">
          
          <% if @tour.included.present? && @tour.included.any? %>
            <div>
              <h2 class="text-xl font-medium text-brand-charcoal-900 mb-6 pb-4 border-b border-brand-gray-200/60">What's Included</h2>
              <ul class="space-y-4">
                <% @tour.included.each do |item| %>
                  <li class="flex items-start text-brand-charcoal-600 font-light leading-relaxed">
                    <span class="text-brand-green-600 mr-3 mt-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                    </span>
                    <%= item %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <% if @tour.excluded.present? && @tour.excluded.any? %>
            <div>
              <h2 class="text-xl font-medium text-brand-charcoal-900 mb-6 pb-4 border-b border-brand-gray-200/60">What's Excluded</h2>
              <ul class="space-y-4">
                <% @tour.excluded.each do |item| %>
                  <li class="flex items-start text-brand-charcoal-600 font-light leading-relaxed">
                    <span class="text-brand-charcoal-300 mr-3 mt-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    </span>
                    <%= item %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

        </div>
      </div>

      <!-- Right Column (Sidebar) -->
      <div class="w-full lg:w-1/3">
        <div class="sticky top-32">
          <div class="bg-[#faf9f6] border border-brand-gray-200/60 p-8 lg:p-10 flex flex-col items-center text-center">
            <h3 class="text-2xl font-medium text-brand-charcoal-900 mb-4">Plan Your Trip</h3>
            <p class="text-brand-charcoal-600 font-light leading-relaxed mb-8">
              Contact us to check availability, customize your itinerary, or arrange a private booking for this experience.
            </p>
            <button class="w-full py-4 px-8 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors">
              Inquire Now
            </button>
            <p class="text-xs text-brand-charcoal-400 font-light mt-6">
              Our travel specialists typically respond within 24 hours.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
