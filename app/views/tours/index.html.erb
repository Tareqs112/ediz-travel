<div class="container-main py-24 min-h-screen">
  <h1 class="text-4xl font-sans font-bold text-brand-charcoal-900 mb-10">All Tours</h1>
  
  <% if @tours.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      <% @tours.each do |tour| %>
        <%= render "shared/components/tour_card", tour: tour %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/components/empty_state",
               title: "No active tours found",
               message: "There are currently no active tours in our database. Please check back later." %>
  <% end %>
</div>
