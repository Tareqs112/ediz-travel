<% content_for :title, t("booking_requests.success.page_title") %>

<div class="bg-white min-h-screen flex items-center justify-center">
  <div class="container-main py-10 lg:py-24 text-center">
    
    <div class="max-w-2xl mx-auto">
      <div class="w-20 h-20 bg-brand-green-50 rounded-full flex items-center justify-center mx-auto mb-8">
        <svg class="w-10 h-10 text-brand-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      
      <h1 class="text-2xl lg:text-5xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-tight mb-6"><%= t("booking_requests.success.title") %></h1>
      
      <p class="text-base lg:text-lg text-brand-charcoal-600 font-light leading-relaxed mb-8">
        <%= t("booking_requests.success.message_html", name: @booking_request.customer_name, tour: @tour.title, email: @booking_request.email).html_safe %>
      </p>
      
      <%= link_to t("booking_requests.success.return_to_tour"), tour_path(@tour), class: "inline-block px-10 py-4 bg-brand-charcoal-900 text-white hover:bg-brand-green-800 font-medium text-sm tracking-widest uppercase transition-colors" %>
    </div>
    
  </div>
</div>
