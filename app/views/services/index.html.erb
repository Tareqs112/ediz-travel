<% content_for :title, t("services.page_title") %>

<div class="bg-brand-gray-50 min-h-screen">
  <div class="pt-8 lg:pt-24 pb-8 lg:pb-32">
    <div class="container-main">
      <%= render "shared/components/section_heading",
                 eyebrow: t("services.eyebrow"),
                 title: t("services.title"),
                 description: t("services.subtitle"),
                 as_h1: true %>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 lg:gap-12 mt-4 lg:mt-16">
        
        <!-- Transportation -->
        <div class="bg-white p-4 lg:p-8 border border-brand-gray-200">
          <h3 class="text-xl lg:text-2xl font-medium text-brand-charcoal-900 mb-3 lg:mb-6 pb-2 lg:pb-4 border-b border-brand-gray-100"><%= t("services.transportation") %></h3>
          <ul class="space-y-3 lg:space-y-6">
            <li>
              <h4 class="text-base lg:text-lg font-medium text-brand-charcoal-900 mb-0.5 lg:mb-2"><%= t("services.airport_transfer") %></h4>
              <p class="text-sm text-brand-charcoal-600 font-light mb-1.5 lg:mb-3"><%= t("services.airport_transfer_desc") %></p>
              <%= link_to "#{t('services.learn_more')} <span class=\"inline-block rtl:rotate-180\">&rarr;</span>".html_safe, airport_transfer_path, class: "text-xs font-semibold text-brand-gold-500 uppercase tracking-widest hover:text-brand-green-700 transition" %>
            </li>
            <li>
              <h4 class="text-base lg:text-lg font-medium text-brand-charcoal-900 mb-0.5 lg:mb-2"><%= t("services.chauffeured_car") %></h4>
              <p class="text-sm text-brand-charcoal-600 font-light mb-1.5 lg:mb-3"><%= t("services.chauffeured_car_desc") %></p>
              <%= link_to "#{t('services.learn_more')} <span class=\"inline-block rtl:rotate-180\">&rarr;</span>".html_safe, chauffeured_car_path, class: "text-xs font-semibold text-brand-gold-500 uppercase tracking-widest hover:text-brand-green-700 transition" %>
            </li>
            <li>
              <h4 class="text-base lg:text-lg font-medium text-brand-charcoal-900 mb-0.5 lg:mb-2"><%= t("services.car_rental") %></h4>
              <p class="text-sm text-brand-charcoal-600 font-light mb-1.5 lg:mb-3"><%= t("services.car_rental_desc") %></p>
              <%= link_to "#{t('services.learn_more')} <span class=\"inline-block rtl:rotate-180\">&rarr;</span>".html_safe, car_rental_path, class: "text-xs font-semibold text-brand-gold-500 uppercase tracking-widest hover:text-brand-green-700 transition" %>
            </li>
          </ul>
        </div>

        <!-- Accommodation -->
        <div class="bg-white p-4 lg:p-8 border border-brand-gray-200">
          <h3 class="text-xl lg:text-2xl font-medium text-brand-charcoal-900 mb-3 lg:mb-6 pb-2 lg:pb-4 border-b border-brand-gray-100"><%= t("services.accommodation") %></h3>
          <p class="text-brand-charcoal-600 font-light text-sm lg:text-base mb-3 lg:mb-6"><%= t("services.accommodation_desc") %></p>
          <ul class="space-y-1.5 lg:space-y-4 mb-3 lg:mb-8 border-s-2 border-brand-gold-500 ps-4">
            <li><%= link_to t("services.hotels"), accommodations_path(type: "hotel"), class: "text-brand-charcoal-800 hover:text-brand-green-700 font-medium transition" %></li>
            <li><%= link_to t("services.bungalows"), accommodations_path(type: "bungalow"), class: "text-brand-charcoal-800 hover:text-brand-green-700 font-medium transition" %></li>
            <li><%= link_to t("services.apartments"), accommodations_path(type: "apartment"), class: "text-brand-charcoal-800 hover:text-brand-green-700 font-medium transition" %></li>
            <li><%= link_to t("services.chalets"), accommodations_path(type: "chalet"), class: "text-brand-charcoal-800 hover:text-brand-green-700 font-medium transition" %></li>
          </ul>
          <%= link_to "#{t('services.explore_all_stays')} <span class=\"inline-block rtl:rotate-180\">&rarr;</span>".html_safe, accommodations_path, class: "text-xs font-semibold text-brand-gold-500 uppercase tracking-widest hover:text-brand-green-700 transition" %>
        </div>

        <!-- Experiences -->
        <div class="bg-white p-4 lg:p-8 border border-brand-gray-200">
          <h3 class="text-xl lg:text-2xl font-medium text-brand-charcoal-900 mb-3 lg:mb-6 pb-2 lg:pb-4 border-b border-brand-gray-100"><%= t("services.experiences") %></h3>
          <ul class="space-y-3 lg:space-y-6">
            <li>
              <h4 class="text-base lg:text-lg font-medium text-brand-charcoal-900 mb-0.5 lg:mb-2"><%= t("services.private_tours") %></h4>
              <p class="text-sm text-brand-charcoal-600 font-light mb-1.5 lg:mb-3"><%= t("services.private_tours_desc") %></p>
              <%= link_to "#{t('services.learn_more')} <span class=\"inline-block rtl:rotate-180\">&rarr;</span>".html_safe, private_tours_path, class: "text-xs font-semibold text-brand-gold-500 uppercase tracking-widest hover:text-brand-green-700 transition" %>
            </li>
            <li>
              <h4 class="text-base lg:text-lg font-medium text-brand-charcoal-900 mb-0.5 lg:mb-2"><%= t("services.travel_packages") %></h4>
              <p class="text-sm text-brand-charcoal-600 font-light mb-1.5 lg:mb-3"><%= t("services.travel_packages_desc") %></p>
              <%= link_to "#{t('services.learn_more')} <span class=\"inline-block rtl:rotate-180\">&rarr;</span>".html_safe, packages_path, class: "text-xs font-semibold text-brand-gold-500 uppercase tracking-widest hover:text-brand-green-700 transition" %>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </div>
</div>
