<% content_for :title, t("airport_transfer_page.page_title") %>

<div class="bg-white min-h-screen border-t border-brand-gray-200/50">
  
  <!-- Hero Section -->
  <div class="pt-8 lg:pt-24 pb-8 lg:pb-16">
    <div class="container-main text-center max-w-4xl mx-auto">
      <div class="mb-6 inline-flex items-center justify-center gap-4">
        <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
        <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase"><%= t("airport_transfer_page.eyebrow") %></span>
        <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
      </div>
      <h1 class="text-3xl lg:text-6xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.1] mb-6">
        <%= t("airport_transfer_page.hero_title") %>
      </h1>
      <p class="text-lg lg:text-xl text-brand-charcoal-600 font-light leading-relaxed mb-8 max-w-3xl mx-auto">
        <%= t("airport_transfer_page.hero_subtitle") %>
      </p>
      <div class="flex justify-center">
        <%= link_to t("airport_transfer_page.plan_transfer"), plan_your_trip_path(inquiry_type: 'airport_transfer'), class: "inline-block px-10 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors" %>
      </div>
    </div>
  </div>



  <!-- Service Highlights -->
  <div class="bg-[#faf9f6] py-10 lg:py-24 border-y border-brand-gray-200/60">
    <div class="container-main">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-8 divide-none lg:divide-x divide-brand-gray-200/60">
        
        <div class="pt-2 lg:pt-0 px-2 lg:px-8 text-center flex flex-col items-center">
          <h3 class="text-sm md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("airport_transfer_page.feature_1_title") %></h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            <%= t("airport_transfer_page.feature_1_desc") %>
          </p>
        </div>
        
        <div class="pt-2 lg:pt-0 px-2 lg:px-8 text-center flex flex-col items-center">
          <h3 class="text-sm md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("airport_transfer_page.feature_2_title") %></h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            <%= t("airport_transfer_page.feature_2_desc") %>
          </p>
        </div>
        
        <div class="pt-2 lg:pt-0 px-2 lg:px-8 text-center flex flex-col items-center">
          <h3 class="text-sm md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("airport_transfer_page.feature_3_title") %></h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            <%= t("airport_transfer_page.feature_3_desc") %>
          </p>
        </div>
        
        <div class="pt-2 lg:pt-0 px-2 lg:px-8 text-center flex flex-col items-center">
          <h3 class="text-sm md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("airport_transfer_page.feature_4_title") %></h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            <%= t("airport_transfer_page.feature_4_desc") %>
          </p>
        </div>

      </div>
    </div>
  </div>

  <!-- Simple Transfer Flow -->
  <div class="py-10 lg:py-24 bg-white border-b border-brand-gray-200/50">
    <div class="container-main max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4 text-center">
        
        <div class="flex flex-col items-center w-24 md:w-32">
          <div class="w-10 h-10 md:w-14 md:h-14 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-4">1</div>
          <span class="text-sm md:text-lg font-medium text-brand-charcoal-900"><%= t("airport_transfer_page.step_1") %></span>
        </div>
        
        <div class="hidden md:block flex-grow h-[1px] bg-brand-gray-200/60 relative top-[-1.5rem]"></div>
        <div class="md:hidden w-[1px] h-10 bg-brand-gray-200/60"></div>
        
        <div class="flex flex-col items-center w-24 md:w-32">
          <div class="w-10 h-10 md:w-14 md:h-14 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-4">2</div>
          <span class="text-sm md:text-lg font-medium text-brand-charcoal-900"><%= t("airport_transfer_page.step_2") %></span>
        </div>
        
        <div class="hidden md:block flex-grow h-[1px] bg-brand-gray-200/60 relative top-[-1.5rem]"></div>
        <div class="md:hidden w-[1px] h-10 bg-brand-gray-200/60"></div>

        <div class="flex flex-col items-center w-24 md:w-32">
          <div class="w-10 h-10 md:w-14 md:h-14 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-4">3</div>
          <span class="text-sm md:text-lg font-medium text-brand-charcoal-900"><%= t("airport_transfer_page.step_3") %></span>
        </div>
        
        <div class="hidden md:block flex-grow h-[1px] bg-brand-gray-200/60 relative top-[-1.5rem]"></div>
        <div class="md:hidden w-[1px] h-10 bg-brand-gray-200/60"></div>

        <div class="flex flex-col items-center w-24 md:w-32">
          <div class="w-10 h-10 md:w-14 md:h-14 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-4">4</div>
          <span class="text-sm md:text-lg font-medium text-brand-charcoal-900"><%= t("airport_transfer_page.step_4") %></span>
        </div>

      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="bg-brand-green-900 py-10 lg:py-24 text-center text-white border-t border-brand-green-800">
    <div class="container-main max-w-2xl mx-auto">
      <h2 class="text-2xl lg:text-5xl font-sans font-medium tracking-tight mb-8"><%= t("airport_transfer_page.cta_title") %></h2>
      <%= link_to t("airport_transfer_page.plan_transfer"), plan_your_trip_path(inquiry_type: 'airport_transfer'), class: "inline-block px-10 py-4 bg-white text-brand-green-900 hover:bg-brand-gray-100 font-medium text-sm tracking-widest uppercase transition-colors" %>
    </div>
  </div>

</div>
