<%
  content_for :title, t("airport_transfer_page.page_title")
  content_for :meta_description, t("airport_transfer_page.meta_description")

  # WhatsApp URL resolution (Direct CTA)
  # Uses business setting number or approved default +905540171890
  raw_whatsapp = current_business_setting&.whatsapp_number.presence || "+905540171890"
  clean_whatsapp = raw_whatsapp.to_s.gsub(/[^0-9]/, "")
  encoded_wa_msg = ERB::Util.url_encode(t("airport_transfer_page.whatsapp_message"))
  whatsapp_transfer_url = "https://wa.me/#{clean_whatsapp}?text=#{encoded_wa_msg}"
%>

<div class="bg-white min-h-screen">
  
  <!-- 1. Hero Section -->
  <section class="relative bg-gradient-to-b from-[#fbfaf8] via-white to-white border-b border-brand-gray-200/50 pt-16 md:pt-24 lg:pt-32 pb-14 md:pb-20">
    <div class="container-main max-w-4xl mx-auto text-center">
      <div class="mb-5 inline-flex items-center justify-center gap-3">
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-70"></span>
        <span class="text-brand-gold-600 font-semibold tracking-[0.2em] text-xs uppercase"><%= t("airport_transfer_page.eyebrow") %></span>
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-70"></span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.18] mb-6">
        <%= t("airport_transfer_page.hero_title") %>
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-brand-charcoal-600 font-light leading-relaxed max-w-2xl mx-auto mb-10">
        <%= t("airport_transfer_page.hero_subtitle") %>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="<%= whatsapp_transfer_url %>"
           target="_blank"
           rel="noopener noreferrer"
           class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-xs sm:text-sm tracking-widest uppercase transition-all duration-300 shadow-sm hover:shadow">
          <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          <span><%= t("airport_transfer_page.plan_transfer") %></span>
        </a>
      </div>

      <div class="mt-4 text-center">
        <span class="text-xs text-brand-charcoal-400 font-light"><%= t("airport_transfer_page.available_note") %></span>
      </div>
    </div>
  </section>

  <!-- 2. Arrival Experience Flow -->
  <section class="py-14 md:py-20 lg:py-28 bg-[#faf9f6] border-b border-brand-gray-200/60">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("airport_transfer_page.experience_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("airport_transfer_page.experience_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("airport_transfer_page.experience_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        <!-- Step 1 -->
        <div class="bg-white p-6 sm:p-7 border border-brand-gray-200/80 rounded-none relative flex flex-col">
          <div class="text-brand-gold-500 font-sans font-medium text-2xl mb-4 tracking-widest"><%= t("airport_transfer_page.step_1_num") %></div>
          <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.step_1_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("airport_transfer_page.step_1_desc") %></p>
        </div>

        <!-- Step 2 -->
        <div class="bg-white p-6 sm:p-7 border border-brand-gray-200/80 rounded-none relative flex flex-col">
          <div class="text-brand-gold-500 font-sans font-medium text-2xl mb-4 tracking-widest"><%= t("airport_transfer_page.step_2_num") %></div>
          <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.step_2_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("airport_transfer_page.step_2_desc") %></p>
        </div>

        <!-- Step 3 -->
        <div class="bg-white p-6 sm:p-7 border border-brand-gray-200/80 rounded-none relative flex flex-col">
          <div class="text-brand-gold-500 font-sans font-medium text-2xl mb-4 tracking-widest"><%= t("airport_transfer_page.step_3_num") %></div>
          <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.step_3_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("airport_transfer_page.step_3_desc") %></p>
        </div>

        <!-- Step 4 -->
        <div class="bg-white p-6 sm:p-7 border border-brand-gray-200/80 rounded-none relative flex flex-col">
          <div class="text-brand-gold-500 font-sans font-medium text-2xl mb-4 tracking-widest"><%= t("airport_transfer_page.step_4_num") %></div>
          <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.step_4_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("airport_transfer_page.step_4_desc") %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Why Private Transfer Section -->
  <section class="py-14 md:py-20 lg:py-24 bg-white border-b border-brand-gray-200/60">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("airport_transfer_page.why_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("airport_transfer_page.why_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("airport_transfer_page.why_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-green-50 text-brand-green-800 flex items-center justify-center shrink-0 mt-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-1.5"><%= t("airport_transfer_page.benefit_1_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.benefit_1_desc") %></p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-green-50 text-brand-green-800 flex items-center justify-center shrink-0 mt-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-1.5"><%= t("airport_transfer_page.benefit_2_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.benefit_2_desc") %></p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-green-50 text-brand-green-800 flex items-center justify-center shrink-0 mt-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-1.5"><%= t("airport_transfer_page.benefit_3_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.benefit_3_desc") %></p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-green-50 text-brand-green-800 flex items-center justify-center shrink-0 mt-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-1.5"><%= t("airport_transfer_page.benefit_4_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.benefit_4_desc") %></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Who It Is For -->
  <section class="py-14 md:py-20 bg-[#faf9f6] border-b border-brand-gray-200/60">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("airport_transfer_page.who_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight"><%= t("airport_transfer_page.who_title") %></h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white p-6 border border-brand-gray-200/70 flex flex-col">
          <h3 class="text-base font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.who_1_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.who_1_desc") %></p>
        </div>

        <div class="bg-white p-6 border border-brand-gray-200/70 flex flex-col">
          <h3 class="text-base font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.who_2_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.who_2_desc") %></p>
        </div>

        <div class="bg-white p-6 border border-brand-gray-200/70 flex flex-col">
          <h3 class="text-base font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.who_3_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.who_3_desc") %></p>
        </div>

        <div class="bg-white p-6 border border-brand-gray-200/70 flex flex-col">
          <h3 class="text-base font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.who_4_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.who_4_desc") %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Transfer Destinations / Common Routes -->
  <section class="py-14 md:py-20 lg:py-24 bg-white border-b border-brand-gray-200/60">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("airport_transfer_page.destinations_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("airport_transfer_page.destinations_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("airport_transfer_page.destinations_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 border border-brand-gray-200 bg-[#fdfcfb] flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold text-brand-gold-600 uppercase tracking-wider mb-2">01</div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.dest_1_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.dest_1_desc") %></p>
          </div>
        </div>

        <div class="p-6 border border-brand-gray-200 bg-[#fdfcfb] flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold text-brand-gold-600 uppercase tracking-wider mb-2">02</div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.dest_2_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.dest_2_desc") %></p>
          </div>
        </div>

        <div class="p-6 border border-brand-gray-200 bg-[#fdfcfb] flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold text-brand-gold-600 uppercase tracking-wider mb-2">03</div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.dest_3_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.dest_3_desc") %></p>
          </div>
        </div>

        <div class="p-6 border border-brand-gray-200 bg-[#fdfcfb] flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold text-brand-gold-600 uppercase tracking-wider mb-2">04</div>
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("airport_transfer_page.dest_4_title") %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed"><%= t("airport_transfer_page.dest_4_desc") %></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. What We Need From You -->
  <section class="py-14 md:py-20 bg-[#faf9f6] border-b border-brand-gray-200/60">
    <div class="container-main max-w-4xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("airport_transfer_page.details_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("airport_transfer_page.details_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("airport_transfer_page.details_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="bg-white p-5 border border-brand-gray-200 flex items-start gap-3.5">
          <span class="w-6 h-6 rounded-full bg-brand-green-100 text-brand-green-800 text-xs font-semibold flex items-center justify-center shrink-0 mt-0.5">1</span>
          <div>
            <h3 class="text-sm md:text-base font-medium text-brand-charcoal-900"><%= t("airport_transfer_page.req_1_title") %></h3>
            <p class="text-xs md:text-sm text-brand-charcoal-600 font-light mt-0.5"><%= t("airport_transfer_page.req_1_desc") %></p>
          </div>
        </div>

        <div class="bg-white p-5 border border-brand-gray-200 flex items-start gap-3.5">
          <span class="w-6 h-6 rounded-full bg-brand-green-100 text-brand-green-800 text-xs font-semibold flex items-center justify-center shrink-0 mt-0.5">2</span>
          <div>
            <h3 class="text-sm md:text-base font-medium text-brand-charcoal-900"><%= t("airport_transfer_page.req_2_title") %></h3>
            <p class="text-xs md:text-sm text-brand-charcoal-600 font-light mt-0.5"><%= t("airport_transfer_page.req_2_desc") %></p>
          </div>
        </div>

        <div class="bg-white p-5 border border-brand-gray-200 flex items-start gap-3.5">
          <span class="w-6 h-6 rounded-full bg-brand-green-100 text-brand-green-800 text-xs font-semibold flex items-center justify-center shrink-0 mt-0.5">3</span>
          <div>
            <h3 class="text-sm md:text-base font-medium text-brand-charcoal-900"><%= t("airport_transfer_page.req_3_title") %></h3>
            <p class="text-xs md:text-sm text-brand-charcoal-600 font-light mt-0.5"><%= t("airport_transfer_page.req_3_desc") %></p>
          </div>
        </div>

        <div class="bg-white p-5 border border-brand-gray-200 flex items-start gap-3.5">
          <span class="w-6 h-6 rounded-full bg-brand-green-100 text-brand-green-800 text-xs font-semibold flex items-center justify-center shrink-0 mt-0.5">4</span>
          <div>
            <h3 class="text-sm md:text-base font-medium text-brand-charcoal-900"><%= t("airport_transfer_page.req_4_title") %></h3>
            <p class="text-xs md:text-sm text-brand-charcoal-600 font-light mt-0.5"><%= t("airport_transfer_page.req_4_desc") %></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Final Editorial CTA Section -->
  <section class="bg-brand-charcoal-900 py-16 md:py-24 text-center text-white relative overflow-hidden">
    <div class="container-main max-w-2xl mx-auto px-4 relative z-10">
      <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs uppercase block mb-3"><%= t("airport_transfer_page.final_eyebrow") %></span>
      <h2 class="text-2xl sm:text-3xl md:text-5xl font-sans font-medium tracking-tight mb-5 leading-tight">
        <%= t("airport_transfer_page.final_title") %>
      </h2>
      <p class="text-white/80 text-sm sm:text-base md:text-lg font-light leading-relaxed mb-8 max-w-xl mx-auto">
        <%= t("airport_transfer_page.final_subtitle") %>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="<%= whatsapp_transfer_url %>"
           target="_blank"
           rel="noopener noreferrer"
