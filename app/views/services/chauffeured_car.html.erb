<%
  content_for :title, t("chauffeured_car_page.page_title")
  content_for :meta_description, t("chauffeured_car_page.meta_description")

  # WhatsApp URL resolution (Direct CTA)
  # Uses business setting number or approved default +905540171890
  raw_whatsapp = current_business_setting&.whatsapp_number.presence || "+905540171890"
  clean_whatsapp = raw_whatsapp.to_s.gsub(/[^0-9]/, "")
  encoded_wa_general = ERB::Util.url_encode(t("chauffeured_car_page.whatsapp_general_message"))
  whatsapp_general_url = "https://wa.me/#{clean_whatsapp}?text=#{encoded_wa_general}"
%>

<div class="bg-white min-h-screen">

  <!-- 1. Hero Section -->
  <section class="relative bg-gradient-to-b from-[#fbfaf8] via-white to-white border-b border-brand-gray-200/50 pt-16 md:pt-24 lg:pt-32 pb-14 md:pb-20">
    <div class="container-main max-w-4xl mx-auto text-center">
      <div class="mb-5 inline-flex items-center justify-center gap-3">
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-70"></span>
        <span class="text-brand-gold-600 font-semibold tracking-[0.2em] text-xs uppercase"><%= t("chauffeured_car_page.eyebrow") %></span>
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-70"></span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.18] mb-6">
        <%= t("chauffeured_car_page.hero_title") %>
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-brand-charcoal-600 font-light leading-relaxed max-w-2xl mx-auto mb-10">
        <%= t("chauffeured_car_page.hero_subtitle") %>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#vehicles-and-arrangements"
           class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 sm:px-10 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-xs sm:text-sm tracking-widest uppercase transition-all duration-300 shadow-sm hover:shadow">
          <span><%= t("chauffeured_car_page.plan_journey") %></span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>

        <a href="<%= whatsapp_general_url %>"
           target="_blank"
           rel="noopener noreferrer"
           class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 border border-brand-gray-300 hover:border-brand-charcoal-900 text-brand-charcoal-900 font-medium text-xs sm:text-sm tracking-widest uppercase transition-all duration-300 bg-white">
          <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          <span><%= t("chauffeured_car_page.whatsapp_cta") %></span>
        </a>
      </div>

      <div class="mt-4 text-center">
        <span class="text-xs text-brand-charcoal-400 font-light"><%= t("chauffeured_car_page.available_note") %></span>
      </div>
    </div>
  </section>

  <!-- 2. What is a Chauffeured Car Service? -->
  <section class="py-14 md:py-20 lg:py-24 bg-[#faf9f6] border-b border-brand-gray-200/60">
    <div class="container-main max-w-4xl mx-auto text-center">
      <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("chauffeured_car_page.about_eyebrow") %></span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("chauffeured_car_page.about_title") %></h2>
      <p class="text-base sm:text-lg text-brand-charcoal-700 font-medium mb-6"><%= t("chauffeured_car_page.about_subtitle") %></p>
      <div class="bg-white p-7 sm:p-9 border border-brand-gray-200/80 shadow-sm text-left rtl:text-right">
        <p class="text-sm sm:text-base text-brand-charcoal-600 font-light leading-relaxed">
          <%= t("chauffeured_car_page.about_desc") %>
        </p>
      </div>
    </div>
  </section>

  <!-- 3. When It Makes Sense in Trabzon -->
  <section class="py-14 md:py-20 lg:py-24 bg-white border-b border-brand-gray-200/60">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("chauffeured_car_page.when_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("chauffeured_car_page.when_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("chauffeured_car_page.when_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-[#faf9f6] p-6 sm:p-7 border border-brand-gray-200/80 flex flex-col">
          <div class="w-10 h-10 rounded-full bg-brand-green-50 text-brand-green-800 flex items-center justify-center mb-5 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.199l-.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <h3 class="text-base sm:text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("chauffeured_car_page.when_1_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("chauffeured_car_page.when_1_desc") %></p>
        </div>

        <div class="bg-[#faf9f6] p-6 sm:p-7 border border-brand-gray-200/80 flex flex-col">
          <div class="w-10 h-10 rounded-full bg-brand-green-50 text-brand-green-800 flex items-center justify-center mb-5 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.53 3.22a11.956 11.956 0 004.97-2.61c.42-.37.69-.9.69-1.47V6.75a1.5 1.5 0 00-.91-1.38L15 3.32a3 3 0 00-2.06 0L8.22 5.09A1.5 1.5 0 007.31 6.47v11.39c0 .57.27 1.1.69 1.47a11.956 11.956 0 004.97 2.61.75.75 0 00.56 0z" />
            </svg>
          </div>
          <h3 class="text-base sm:text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("chauffeured_car_page.when_2_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("chauffeured_car_page.when_2_desc") %></p>
        </div>

        <div class="bg-[#faf9f6] p-6 sm:p-7 border border-brand-gray-200/80 flex flex-col">
          <div class="w-10 h-10 rounded-full bg-brand-green-50 text-brand-green-800 flex items-center justify-center mb-5 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </div>
          <h3 class="text-base sm:text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("chauffeured_car_page.when_3_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("chauffeured_car_page.when_3_desc") %></p>
        </div>

        <div class="bg-[#faf9f6] p-6 sm:p-7 border border-brand-gray-200/80 flex flex-col">
          <div class="w-10 h-10 rounded-full bg-brand-green-50 text-brand-green-800 flex items-center justify-center mb-5 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-base sm:text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("chauffeured_car_page.when_4_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("chauffeured_car_page.when_4_desc") %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. The Chauffeured Experience Flow -->
  <section class="py-14 md:py-20 lg:py-28 bg-[#faf9f6] border-b border-brand-gray-200/60">
    <div class="container-main max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("chauffeured_car_page.flow_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("chauffeured_car_page.flow_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("chauffeured_car_page.flow_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        <div class="bg-white p-6 sm:p-7 border border-brand-gray-200/80 flex flex-col">
          <div class="text-brand-gold-500 font-sans font-medium text-2xl mb-4 tracking-widest"><%= t("chauffeured_car_page.flow_1_num") %></div>
          <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("chauffeured_car_page.flow_1_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("chauffeured_car_page.flow_1_desc") %></p>
        </div>

        <div class="bg-white p-6 sm:p-7 border border-brand-gray-200/80 flex flex-col">
          <div class="text-brand-gold-500 font-sans font-medium text-2xl mb-4 tracking-widest"><%= t("chauffeured_car_page.flow_2_num") %></div>
          <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("chauffeured_car_page.flow_2_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("chauffeured_car_page.flow_2_desc") %></p>
        </div>

        <div class="bg-white p-6 sm:p-7 border border-brand-gray-200/80 flex flex-col">
          <div class="text-brand-gold-500 font-sans font-medium text-2xl mb-4 tracking-widest"><%= t("chauffeured_car_page.flow_3_num") %></div>
          <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("chauffeured_car_page.flow_3_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("chauffeured_car_page.flow_3_desc") %></p>
        </div>

        <div class="bg-white p-6 sm:p-7 border border-brand-gray-200/80 flex flex-col">
          <div class="text-brand-gold-500 font-sans font-medium text-2xl mb-4 tracking-widest"><%= t("chauffeured_car_page.flow_4_num") %></div>
          <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t("chauffeured_car_page.flow_4_title") %></h3>
          <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed flex-grow"><%= t("chauffeured_car_page.flow_4_desc") %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Available Vehicles Section -->
  <section id="vehicles-and-arrangements" class="py-14 md:py-20 lg:py-28 bg-white border-b border-brand-gray-200/60 scroll-mt-12">
    <div class="container-main max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
        <span class="text-xs font-semibold text-brand-gold-600 uppercase tracking-[0.2em] block mb-2"><%= t("chauffeured_car_page.vehicles_eyebrow") %></span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-brand-charcoal-900 tracking-tight mb-3"><%= t("chauffeured_car_page.vehicles_title") %></h2>
        <p class="text-sm md:text-base text-brand-charcoal-600 font-light"><%= t("chauffeured_car_page.vehicles_subtitle") %></p>
      </div>

      <% if @vehicles.present? && @vehicles.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-center">
          <% @vehicles.each do |vehicle| %>
            <%
              vehicle_msg = ERB::Util.url_encode("#{t('chauffeured_car_page.whatsapp_general_message')} #{vehicle.name}")
              vehicle_wa_url = "https://wa.me/#{clean_whatsapp}?text=#{vehicle_msg}"
            %>
            <div class="bg-[#faf9f6] border border-brand-gray-200 overflow-hidden flex flex-col group transition-all duration-300 hover:shadow-md">
              <% if vehicle.image.attached? %>
                <div class="aspect-w-16 aspect-h-10 bg-brand-gray-100 overflow-hidden relative">
                  <%= image_tag vehicle.image, alt: vehicle.name, class: "object-cover w-full h-full group-hover:scale-105 transition-transform duration-500" %>
                  <% if vehicle.category.present? %>
                    <span class="absolute top-3 left-3 bg-brand-charcoal-900/85 text-white text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1">
                      <%= vehicle.category.humanize %>
                    </span>
                  <% end %>
                </div>
              <% else %>
                <div class="aspect-w-16 aspect-h-10 bg-brand-gray-100 flex items-center justify-center relative overflow-hidden py-12">
                  <svg class="w-14 h-14 text-brand-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M8 16a2 2 0 002-2h4a2 2 0 002 2m-8 0a2 2 0 01-2-2m10 0a2 2 0 012-2V9a2 2 0 00-2-2H6a2 2 0 00-2 2v5a2 2 0 012 2m10 0v1m-10 0v1"></path>
                  </svg>
                  <% if vehicle.category.present? %>
                    <span class="absolute top-3 left-3 bg-brand-charcoal-900/85 text-white text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1">
                      <%= vehicle.category.humanize %>
                    </span>
                  <% end %>
                </div>
              <% end %>

              <div class="p-6 flex-grow flex flex-col bg-white">
                <h3 class="text-xl font-medium text-brand-charcoal-900 mb-2"><%= vehicle.name %></h3>

                <% if vehicle.description.present? %>
                  <p class="text-sm text-brand-charcoal-600 font-light mb-4 line-clamp-2 leading-relaxed"><%= vehicle.description %></p>
                <% end %>

                <div class="flex flex-wrap gap-2.5 mb-6">
                  <% if vehicle.passenger_capacity.present? %>
                    <span class="inline-flex items-center text-xs text-brand-charcoal-700 bg-brand-gray-50 px-2.5 py-1 border border-brand-gray-200">
                      <svg class="w-3.5 h-3.5 mr-1.5 text-brand-charcoal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                      <%= vehicle.passenger_capacity %> <%= t("services.seats", default: "Seats") %>
                    </span>
                  <% end %>

                  <% if vehicle.luggage_capacity.present? %>
                    <span class="inline-flex items-center text-xs text-brand-charcoal-700 bg-brand-gray-50 px-2.5 py-1 border border-brand-gray-200">
                      <svg class="w-3.5 h-3.5 mr-1.5 text-brand-charcoal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                      <%= vehicle.luggage_capacity %> <%= t("services.bags", default: "Bags") %>
                    </span>
                  <% end %>
                </div>

                <div class="mt-auto border-t border-brand-gray-100 pt-5 flex items-center justify-between gap-3">
                  <div>
                    <% if vehicle.price_from.present? %>
                      <span class="text-[11px] text-brand-charcoal-500 uppercase tracking-wider block"><%= t("services.starting_from", default: "Starting from") %></span>
                      <span class="text-xl font-medium text-brand-charcoal-900">
                        <%= number_to_currency(vehicle.price_from, unit: vehicle.currency.present? ? vehicle.currency + " " : "$", precision: 0) %>
                        <span class="text-xs font-normal text-brand-charcoal-500"><%= t("services.per_day", default: "/ day") %></span>
                      </span>
                    <% else %>
                      <span class="text-sm text-brand-charcoal-500"><%= t("services.contact_for_pricing", default: "Contact for pricing") %></span>
                    <% end %>
                  </div>

                  <a href="<%= vehicle_wa_url %>"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white text-xs font-medium tracking-wider uppercase transition-colors shrink-0">
                    <svg class="w-3.5 h-3.5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                    </svg>
                    <span><%= t("chauffeured_car_page.inquire_vehicle_btn") %></span>
                  </a>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-[#faf9f6] border border-brand-gray-200 p-8 lg:p-12 text-center max-w-2xl mx-auto">
          <p class="text-brand-charcoal-600 font-light leading-relaxed mb-6">
            <%= t("chauffeured_car_page.no_vehicles") %>
          </p>
          <a href="<%= whatsapp_general_url %>"
             target="_blank"
             rel="noopener noreferrer"
             class="inline-flex items-center gap-2 px-8 py-3.5 bg-[#25D366] hover:bg-[#20bd5a] text-white font-medium text-xs tracking-widest uppercase transition-colors shadow-sm">
            <span><%= t("chauffeured_car_page.whatsapp_cta") %></span>
          </a>
        </div>
      <% end %>
    </div>
  </section>

