<% content_for :title, t("chauffeured_car_page.page_title") %>

<div class="bg-brand-gray-50 min-h-screen">
  <div class="pt-8 lg:pt-24 pb-8 lg:pb-32">
    <div class="container-main max-w-4xl">
      <%= render "shared/components/section_heading",
                 eyebrow: t("chauffeured_car_page.eyebrow"),
                 title: t("chauffeured_car_page.title"),
                 description: t("chauffeured_car_page.description"),
                 as_h1: true %>
                 
      <div class="bg-white border border-brand-gray-200 p-6 lg:p-12 mt-6 lg:mt-12">
        <h2 class="text-2xl font-medium text-brand-charcoal-900 mb-6"><%= t("chauffeured_car_page.how_it_works") %></h2>
        <p class="text-brand-charcoal-600 font-light leading-relaxed mb-8">
          <%= t("chauffeured_car_page.how_it_works_desc") %>
        </p>
        
        <div class="border-t border-brand-gray-100 pt-8 text-center">
          <h3 class="text-lg font-medium text-brand-charcoal-900 mb-4"><%= t("chauffeured_car_page.request_driver") %></h3>
          <%= link_to t("chauffeured_car_page.inquire_now"), plan_your_trip_path(inquiry_type: 'chauffeured_car'), class: "btn-primary inline-block" %>
        </div>
      </div>
    </div>
  </div>
</div>
