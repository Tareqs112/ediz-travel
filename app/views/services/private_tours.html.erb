<% content_for :title, t("private_tours_page.page_title") %>

<div class="bg-white min-h-screen border-t border-brand-gray-200/50">
  
  <!-- Hero Section -->
  <div class="pt-16 lg:pt-24 pb-12 lg:pb-16">
    <div class="container-main text-center max-w-4xl mx-auto">
      <div class="mb-6 inline-flex items-center justify-center gap-4">
        <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
        <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase"><%= t("private_tours_page.eyebrow") %></span>
        <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
      </div>
      <h1 class="text-3xl lg:text-6xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.1] mb-6">
        <%= t("private_tours_page.title") %>
      </h1>
      <p class="text-lg lg:text-xl text-brand-charcoal-600 font-light leading-relaxed mb-10 max-w-3xl mx-auto">
        <%= t("private_tours_page.subtitle") %>
      </p>
      <div class="flex justify-center">
        <%= link_to t("private_tours_page.plan_private_tour"), plan_your_trip_path(inquiry_type: 'private_transport'), class: "inline-block px-10 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors" %>
      </div>
    </div>
  </div>


  <!-- Why Private -->
  <div class="bg-[#faf9f6] py-10 lg:py-24 border-y border-brand-gray-200/60">
    <div class="container-main">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-2xl lg:text-4xl font-medium text-brand-charcoal-900 tracking-tight"><%= t("private_tours_page.why_choose_private") %></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 divide-y md:divide-y-0 md:divide-x divide-brand-gray-200/60">
        
        <div class="pt-6 md:pt-0 md:px-6 lg:px-12 text-center flex flex-col items-center">
          <span class="text-brand-gold-500 mb-4 block">
            <svg class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
          <h3 class="text-lg md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("private_tours_page.feature_1_title") %></h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            <%= t("private_tours_page.feature_1_desc") %>
          </p>
        </div>
        
        <div class="pt-6 md:pt-0 md:px-6 lg:px-12 text-center flex flex-col items-center">
          <span class="text-brand-gold-500 mb-4 block">
            <svg class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
            </svg>
          </span>
          <h3 class="text-lg md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("private_tours_page.feature_2_title") %></h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            <%= t("private_tours_page.feature_2_desc") %>
          </p>
        </div>
        
        <div class="pt-6 md:pt-0 md:px-6 lg:px-12 text-center flex flex-col items-center">
          <span class="text-brand-gold-500 mb-4 block">
            <svg class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </span>
          <h3 class="text-lg md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("private_tours_page.feature_3_title") %></h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            <%= t("private_tours_page.feature_3_desc") %>
          </p>
        </div>

      </div>
    </div>
  </div>

  <!-- How It Works Flow -->
  <div class="py-10 lg:py-24 bg-white border-b border-brand-gray-200/50">
    <div class="container-main max-w-5xl mx-auto">
      <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
        <h2 class="text-2xl lg:text-4xl font-medium text-brand-charcoal-900 tracking-tight"><%= t("private_tours_page.how_it_works") %></h2>
      </div>
      
      <div class="flex flex-col md:flex-row items-start justify-between gap-8 md:gap-4">
        
        <div class="flex flex-col items-center text-center w-full md:w-1/3 px-4">
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-6">01</div>
          <h3 class="text-lg md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("private_tours_page.step_1_title") %></h3>
          <p class="text-brand-charcoal-600 font-light text-sm"><%= t("private_tours_page.step_1_desc") %></p>
        </div>
        
        <div class="hidden md:block w-[1px] h-32 bg-brand-gray-200/60 mt-8"></div>
        <div class="md:hidden w-full h-[1px] bg-brand-gray-200/60"></div>
        
        <div class="flex flex-col items-center text-center w-full md:w-1/3 px-4">
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-6">02</div>
          <h3 class="text-lg md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("private_tours_page.step_2_title") %></h3>
          <p class="text-brand-charcoal-600 font-light text-sm"><%= t("private_tours_page.step_2_desc") %></p>
        </div>
        
        <div class="hidden md:block w-[1px] h-32 bg-brand-gray-200/60 mt-8"></div>
        <div class="md:hidden w-full h-[1px] bg-brand-gray-200/60"></div>

        <div class="flex flex-col items-center text-center w-full md:w-1/3 px-4">
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-6">03</div>
          <h3 class="text-lg md:text-xl font-medium text-brand-charcoal-900 mb-2 md:mb-3"><%= t("private_tours_page.step_3_title") %></h3>
          <p class="text-brand-charcoal-600 font-light text-sm"><%= t("private_tours_page.step_3_desc") %></p>
        </div>

      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="bg-brand-green-900 py-10 lg:py-24 text-center text-white border-t border-brand-green-800">
    <div class="container-main max-w-2xl mx-auto">
      <h2 class="text-2xl lg:text-5xl font-sans font-medium tracking-tight mb-8"><%= t("private_tours_page.cta_title") %></h2>
      <%= link_to t("private_tours_page.plan_private_tour"), plan_your_trip_path(inquiry_type: 'private_transport'), class: "inline-block px-10 py-4 bg-white text-brand-green-900 hover:bg-brand-gray-100 font-medium text-sm tracking-widest uppercase transition-colors" %>
    </div>
  </div>

</div>
