<% content_for :title, t("travel_guides.page_title") %>

<div class="bg-brand-gray-50 min-h-screen">
  <div class="pt-8 lg:pt-24 pb-8 lg:pb-32">
    <div class="container-main">
      <%= render "shared/components/section_heading",
                 eyebrow: t("travel_guides.eyebrow"),
                 title: t("travel_guides.title"),
                 description: t("travel_guides.subtitle"),
                 as_h1: true %>
                 
      <div class="mt-6 lg:mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <% if @travel_guides.any? %>
          <% @travel_guides.each do |guide| %>
            <div class="bg-white border border-brand-gray-200 flex flex-col group h-full">
              <% if guide.image.attached? %>
                <%= image_tag guide.image, alt: guide.title, loading: "lazy", class: "w-full h-48 object-cover group-hover:opacity-90 transition-opacity" %>
              <% else %>
                <div class="w-full h-48 bg-brand-gray-50 flex items-center justify-center text-brand-gray-300">
                  <svg class="w-10 h-10 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                  </svg>
                </div>
              <% end %>
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex items-center justify-between gap-2 mb-2.5">
                  <% if guide.tags.present? && guide.tags.any? %>
                    <span class="text-[10px] uppercase tracking-[0.15em] text-brand-gold-600 font-bold">
                      <%= guide.tags.first %>
                    </span>
                  <% else %>
                    <span class="text-[10px] uppercase tracking-[0.15em] text-brand-gold-600 font-bold">
                      <%= t("travel_guides.guide_badge") %>
                    </span>
                  <% end %>
                  <span class="text-[11px] text-brand-charcoal-400 font-light">
                    <%= l((guide.published_at || guide.created_at).to_date, format: :travel_guide) %>
                  </span>
                </div>
                <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3 group-hover:text-brand-green-700 transition-colors leading-snug">
                  <%= link_to guide.title, travel_guide_path(guide) %>
                </h3>
                <p class="text-sm text-brand-charcoal-600 font-light leading-relaxed mb-6 line-clamp-3">
                  <%= guide.excerpt %>
                </p>
                <div class="mt-auto">
                  <%= link_to "#{t('travel_guides.read_article')} <span class=\"inline-block rtl:rotate-180\">&rarr;</span>".html_safe, travel_guide_path(guide), class: "text-xs font-semibold text-brand-charcoal-900 uppercase tracking-widest group-hover:text-brand-green-700 transition-colors" %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="col-span-full">
            <%= render "shared/components/empty_state", 
                       title: t("travel_guides.empty_title"), 
                       message: t("travel_guides.empty_desc") %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
