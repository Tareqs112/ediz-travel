<div class="bg-white min-h-screen">
  
  <!-- Hero Section -->
  <div class="pt-16 lg:pt-24 pb-16 border-b border-brand-gray-200/50">
    <div class="container-main">
      <%= render "shared/components/section_heading",
                 eyebrow: "Explore",
                 title: "Destinations",
                 description: "Discover the breathtaking landscapes, ancient monasteries, and vibrant local cultures of Trabzon and the Eastern Black Sea." %>
    </div>
  </div>

  <!-- Destinations Grid -->
  <div class="py-16 lg:py-24 bg-[#faf9f6]">
    <div class="container-main">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
        
        <!-- Destination Card 1 -->
        <a href="/destinations/uzungol" class="group flex flex-col h-full bg-white border border-brand-gray-200/60 overflow-hidden hover:border-brand-charcoal-900/20 transition-all duration-500">
          <div class="relative w-full aspect-[4/3] bg-brand-charcoal-900 overflow-hidden border-b border-brand-gray-200/60 flex items-center justify-center">
            <span class="text-brand-gray-400 text-xs uppercase tracking-widest font-semibold">Image Pending</span>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <div class="mb-4">
              <span class="text-xs font-semibold text-brand-gold-500 uppercase tracking-widest block mb-2">Çaykara, Trabzon</span>
              <h3 class="text-2xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors duration-300">Uzungöl</h3>
            </div>
            <p class="text-brand-charcoal-600 font-light leading-relaxed flex-grow">
              A scenic journey to the famous long lake surrounded by dense forests and mountains.
            </p>
            <div class="mt-8 pt-6 border-t border-brand-gray-100 flex items-center justify-between">
              <span class="text-sm font-medium text-brand-charcoal-900 uppercase tracking-widest">3 Tours Available</span>
              <span class="text-brand-charcoal-900 group-hover:text-brand-gold-500 transition-transform duration-500 group-hover:translate-x-1">&rarr;</span>
            </div>
          </div>
        </a>

        <!-- Destination Card 2 -->
        <a href="/destinations/sumela" class="group flex flex-col h-full bg-white border border-brand-gray-200/60 overflow-hidden hover:border-brand-charcoal-900/20 transition-all duration-500">
          <div class="relative w-full aspect-[4/3] bg-brand-charcoal-900 overflow-hidden border-b border-brand-gray-200/60 flex items-center justify-center">
            <span class="text-brand-gray-400 text-xs uppercase tracking-widest font-semibold">Image Pending</span>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <div class="mb-4">
              <span class="text-xs font-semibold text-brand-gold-500 uppercase tracking-widest block mb-2">Maçka, Trabzon</span>
              <h3 class="text-2xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors duration-300">Sümela Monastery</h3>
            </div>
            <p class="text-brand-charcoal-600 font-light leading-relaxed flex-grow">
              Discover the ancient Greek Orthodox monastery built into a steep cliff in the Altındere valley.
            </p>
            <div class="mt-8 pt-6 border-t border-brand-gray-100 flex items-center justify-between">
              <span class="text-sm font-medium text-brand-charcoal-900 uppercase tracking-widest">2 Tours Available</span>
              <span class="text-brand-charcoal-900 group-hover:text-brand-gold-500 transition-transform duration-500 group-hover:translate-x-1">&rarr;</span>
            </div>
          </div>
        </a>

        <!-- Destination Card 3 -->
        <a href="/destinations/ayder" class="group flex flex-col h-full bg-white border border-brand-gray-200/60 overflow-hidden hover:border-brand-charcoal-900/20 transition-all duration-500">
          <div class="relative w-full aspect-[4/3] bg-brand-charcoal-900 overflow-hidden border-b border-brand-gray-200/60 flex items-center justify-center">
            <span class="text-brand-gray-400 text-xs uppercase tracking-widest font-semibold">Image Pending</span>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <div class="mb-4">
              <span class="text-xs font-semibold text-brand-gold-500 uppercase tracking-widest block mb-2">Çamlıhemşin, Rize</span>
              <h3 class="text-2xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors duration-300">Ayder Plateau</h3>
            </div>
            <p class="text-brand-charcoal-600 font-light leading-relaxed flex-grow">
              Experience the lush highlands, traditional wooden houses, and the rushing Fırtına River.
            </p>
            <div class="mt-8 pt-6 border-t border-brand-gray-100 flex items-center justify-between">
              <span class="text-sm font-medium text-brand-charcoal-900 uppercase tracking-widest">4 Tours Available</span>
              <span class="text-brand-charcoal-900 group-hover:text-brand-gold-500 transition-transform duration-500 group-hover:translate-x-1">&rarr;</span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </div>
</div>
