<% content_for :title, t("packages.page_title") %>
<div class="bg-white">

  <!-- Hero Section -->
  <div class="pt-32 pb-16 lg:pt-40 lg:pb-24 border-b border-brand-gray-200/50">
    <div class="container-main">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-24">
        
        <div class="lg:w-1/3">
          <h1 class="text-2xl lg:text-4xl font-medium text-brand-charcoal-900 tracking-tight"><%= t("packages.hero_title") %></h1>
        </div>
        
        <div class="lg:w-2/3">
          <div class="grid grid-cols-2 gap-x-4 gap-y-8 md:gap-x-12 md:gap-y-12 lg:gap-y-16">
            
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-3">01</span>
              <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("packages.feature_1_title") %></h3>
              <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
                <%= t("packages.feature_1_desc") %>
              </p>
            </div>
            
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-3">02</span>
              <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("packages.feature_2_title") %></h3>
              <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
                <%= t("packages.feature_2_desc") %>
              </p>
            </div>
            
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-3">03</span>
              <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("packages.feature_3_title") %></h3>
              <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
                <%= t("packages.feature_3_desc") %>
              </p>
            </div>
            
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-3">04</span>
              <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("packages.feature_4_title") %></h3>
              <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
                <%= t("packages.feature_4_desc") %>
              </p>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Packages List -->
  <div class="py-10 lg:py-28 bg-white">
    <div class="container-main">
      <div class="mb-16">
        <h2 class="text-2xl lg:text-4xl font-medium text-brand-charcoal-900 tracking-tight"><%= t("packages.choose_journey") %></h2>
      </div>
      
      <% if @packages.any? %>
        <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 md:gap-8 pb-8 hide-scrollbar md:grid md:grid-cols-2 lg:grid-cols-3">
          <% @packages.each do |package| %>
            <%= render "shared/components/package_card", package: package %>
          <% end %>
        </div>
      <% else %>
        <p class="text-brand-charcoal-600"><%= t("packages.empty_message") %></p>
      <% end %>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="bg-brand-green-900 py-10 lg:py-24 text-center text-white border-t border-brand-green-800">
    <div class="container-main max-w-2xl mx-auto flex flex-col items-center">
      <h2 class="text-2xl lg:text-5xl font-sans font-medium tracking-tight mb-6"><%= t("packages.cta_title") %></h2>
      <p class="text-lg text-white/80 font-light leading-relaxed mb-10 max-w-xl">
        <%= t("packages.cta_desc") %>
      </p>
      <%= link_to t("packages.plan_your_trip"), plan_your_trip_path, class: "inline-block px-10 py-4 bg-white text-brand-green-900 hover:bg-brand-gray-100 font-medium text-sm tracking-widest uppercase transition-colors" %>
    </div>
  </div>

</div>
