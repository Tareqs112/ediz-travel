<section class="relative w-full h-[90vh] min-h-[700px] flex items-center overflow-hidden bg-brand-charcoal-900">
  <!-- Clean, neutral background fallback (Image ready) -->
  <div class="absolute inset-0 z-0">
    <% if File.exist?(Rails.root.join("app/assets/images/hero-trabzon-bg.jpg")) %>
      <%= image_tag "hero-trabzon-bg.jpg", alt: "Trabzon and Eastern Black Sea Landscape", class: "w-full h-full object-cover object-center" %>
      <!-- Overlays only applied if image exists to ensure contrast -->
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-brand-charcoal-900/95 via-brand-charcoal-900/50 to-transparent"></div>
      <div class="absolute inset-0 z-10 bg-gradient-to-r from-brand-charcoal-900/80 via-brand-charcoal-900/30 to-transparent"></div>
    <% else %>
      <!-- Deliberate, premium dark atmosphere (No placeholder text) -->
      <div class="w-full h-full bg-brand-charcoal-900 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand-green-900/30 via-brand-charcoal-900 to-brand-charcoal-900"></div>
    <% end %>
  </div>

  <!-- Hero Content -->
  <div class="relative z-20 container-main w-full pt-16 lg:pt-0">
    
    <div class="max-w-4xl">
      <!-- Eyebrow -->
      <div class="mb-6 inline-flex items-center gap-4">
        <span class="w-10 sm:w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
        <span class="text-brand-gold-500 font-bold tracking-[0.25em] text-xs sm:text-sm uppercase">
          Trabzon &bull; Eastern Black Sea
        </span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-white font-sans text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] mb-8">
        Discover Trabzon.<br>
        <span class="text-brand-gray-300 font-medium">Experience the Black Sea.</span>
      </h1>

      <!-- Supporting Text -->
      <p class="text-lg sm:text-xl text-brand-gray-300 mb-12 font-light leading-relaxed max-w-2xl">
        Private tours, unforgettable landscapes, and carefully planned journeys across Trabzon and the Eastern Black Sea.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 w-full sm:w-auto">
        <a href="#" class="btn bg-white text-brand-charcoal-900 hover:bg-brand-gray-100 px-10 py-4 shadow-xl w-full sm:w-auto font-bold text-center transition-transform hover:-translate-y-0.5 rounded-lg">
          Explore Tours
        </a>
        <a href="#" class="btn bg-transparent border border-brand-gray-200/30 text-white hover:bg-white/5 hover:border-white/60 px-10 py-4 w-full sm:w-auto font-semibold text-center transition-all rounded-lg">
          Plan Your Trip
        </a>
      </div>
    </div>

  </div>
</section>
