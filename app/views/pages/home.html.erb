<section class="relative w-full h-[90vh] min-h-[700px] flex items-center overflow-hidden bg-black">
  <!-- Clean, neutral background fallback (Image ready) -->
  <div class="absolute inset-0 z-0">
    <% if File.exist?(Rails.root.join("app/assets/images/hero-trabzon-bg.jpg")) %>
      <%= image_tag "hero-trabzon-bg.jpg", alt: "Trabzon and Eastern Black Sea Landscape", class: "w-full h-full object-cover object-center" %>
      <!-- Overlays only applied if image exists to ensure contrast -->
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-black/95 via-black/50 to-transparent"></div>
      <div class="absolute inset-0 z-10 bg-gradient-to-r from-black/80 via-black/30 to-transparent"></div>
    <% else %>
      <!-- Deep cinematic palette avoiding cool/blue tones (using pure black and forest green) -->
      <div class="w-full h-full bg-black bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand-green-900/30 via-black to-black"></div>
    <% end %>
  </div>

  <!-- Hero Content -->
  <div class="relative z-20 container-main w-full pt-20 lg:pt-0">
    
    <div class="max-w-4xl flex flex-col gap-6">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-4">
        <span class="w-10 sm:w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
        <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase">
          Trabzon &bull; Eastern Black Sea
        </span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-white font-sans text-5xl sm:text-6xl lg:text-[4.5rem] font-medium tracking-tight leading-[1.15]">
        Discover Trabzon.<br>
        <span class="text-brand-gray-300">Experience the Black Sea.</span>
      </h1>

      <!-- Supporting Text -->
      <p class="text-lg sm:text-xl text-white/95 font-light leading-relaxed max-w-[600px] mt-2 mb-4">
        Private tours, unforgettable landscapes, and carefully planned journeys across Trabzon and the Eastern Black Sea.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-5 w-full sm:w-auto">
        <a href="#" class="btn bg-white text-black hover:bg-brand-gray-100 px-10 py-4 shadow-xl w-full sm:w-auto font-semibold text-center transition-transform hover:-translate-y-0.5 rounded-lg">
          Explore Tours
        </a>
        <a href="#" class="btn bg-transparent border border-white/20 text-white hover:bg-white/5 hover:border-white/50 px-10 py-4 w-full sm:w-auto font-medium text-center transition-all rounded-lg">
          Plan Your Trip
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Services Section -->
<section class="bg-[#faf9f6] py-24 lg:py-32 relative">
  <div class="container-main">
    
    <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">
      
      <!-- Sticky Header Column -->
      <div class="w-full lg:w-5/12 xl:w-1/3">
        <div class="sticky top-32">
          <div class="mb-6 inline-flex items-center gap-4">
            <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
            <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase">Our Services</span>
          </div>
          <h2 class="text-4xl lg:text-5xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.1] mb-6">
            Travel Your Way
          </h2>
          <p class="text-lg text-brand-charcoal-600 font-light leading-relaxed">
            From private tours to seamless transfers, discover experiences designed around your journey.
          </p>
        </div>
      </div>

      <!-- Services List -->
      <div class="w-full lg:w-7/12 xl:w-2/3 flex flex-col border-t border-brand-charcoal-900/10">
        
        <!-- Service 1: Private Tours -->
        <div class="group flex flex-col sm:flex-row items-start gap-6 sm:gap-10 py-10 lg:py-12 border-b border-brand-charcoal-900/10 hover:border-brand-gold-400 transition-colors duration-500 cursor-pointer">
          <!-- Number -->
          <div class="flex-shrink-0 w-12 sm:w-16">
            <span class="text-3xl font-light text-brand-charcoal-900/20 group-hover:text-brand-gold-500 transition-colors duration-500 font-sans tracking-tighter">01</span>
          </div>
          
          <!-- Content -->
          <div class="flex-grow">
            <div class="flex items-center gap-5 mb-5">
              <div class="text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors duration-500">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.25">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <h3 class="text-2xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-800 transition-colors duration-500">Private Tours</h3>
            </div>
            <p class="text-lg text-brand-charcoal-600 font-light leading-relaxed mb-6 max-w-xl">
              Explore Trabzon and the Black Sea with a journey tailored to you.
            </p>
            <div class="inline-flex items-center text-sm font-medium text-brand-charcoal-900 group-hover:text-brand-gold-500 transition-colors duration-500 uppercase tracking-widest">
              Discover <span class="ml-2 transition-transform duration-500 group-hover:translate-x-2">&rarr;</span>
            </div>
          </div>
        </div>

        <!-- Service 2: Airport Transfer -->
        <div class="group flex flex-col sm:flex-row items-start gap-6 sm:gap-10 py-10 lg:py-12 border-b border-brand-charcoal-900/10 hover:border-brand-gold-400 transition-colors duration-500 cursor-pointer">
          <div class="flex-shrink-0 w-12 sm:w-16">
            <span class="text-3xl font-light text-brand-charcoal-900/20 group-hover:text-brand-gold-500 transition-colors duration-500 font-sans tracking-tighter">02</span>
          </div>
          <div class="flex-grow">
            <div class="flex items-center gap-5 mb-5">
              <div class="text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors duration-500">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.25">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                </svg>
              </div>
              <h3 class="text-2xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-800 transition-colors duration-500">Airport Transfer</h3>
            </div>
            <p class="text-lg text-brand-charcoal-600 font-light leading-relaxed mb-6 max-w-xl">
              Comfortable, reliable transfers between Trabzon Airport and your destination.
            </p>
            <div class="inline-flex items-center text-sm font-medium text-brand-charcoal-900 group-hover:text-brand-gold-500 transition-colors duration-500 uppercase tracking-widest">
              Reserve <span class="ml-2 transition-transform duration-500 group-hover:translate-x-2">&rarr;</span>
            </div>
          </div>
        </div>

        <!-- Service 3: Custom Trips -->
        <div class="group flex flex-col sm:flex-row items-start gap-6 sm:gap-10 py-10 lg:py-12 border-b border-brand-charcoal-900/10 hover:border-brand-gold-400 transition-colors duration-500 cursor-pointer">
          <div class="flex-shrink-0 w-12 sm:w-16">
            <span class="text-3xl font-light text-brand-charcoal-900/20 group-hover:text-brand-gold-500 transition-colors duration-500 font-sans tracking-tighter">03</span>
          </div>
          <div class="flex-grow">
            <div class="flex items-center gap-5 mb-5">
              <div class="text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors duration-500">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.25">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zM12 2.25V4.5m5.834.166l-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243l-1.59-1.59" />
                </svg>
              </div>
              <h3 class="text-2xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-800 transition-colors duration-500">Custom Trips</h3>
            </div>
            <p class="text-lg text-brand-charcoal-600 font-light leading-relaxed mb-6 max-w-xl">
              Build a personalized itinerary around the places and experiences you want to discover.
            </p>
            <div class="inline-flex items-center text-sm font-medium text-brand-charcoal-900 group-hover:text-brand-gold-500 transition-colors duration-500 uppercase tracking-widest">
              Start planning <span class="ml-2 transition-transform duration-500 group-hover:translate-x-2">&rarr;</span>
            </div>
          </div>
        </div>

        <!-- Service 4: Travel Packages -->
        <div class="group flex flex-col sm:flex-row items-start gap-6 sm:gap-10 py-10 lg:py-12 border-b border-brand-charcoal-900/10 hover:border-brand-gold-400 transition-colors duration-500 cursor-pointer">
          <div class="flex-shrink-0 w-12 sm:w-16">
            <span class="text-3xl font-light text-brand-charcoal-900/20 group-hover:text-brand-gold-500 transition-colors duration-500 font-sans tracking-tighter">04</span>
          </div>
          <div class="flex-grow">
            <div class="flex items-center gap-5 mb-5">
              <div class="text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors duration-500">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.25">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
                </svg>
              </div>
              <h3 class="text-2xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-800 transition-colors duration-500">Travel Packages</h3>
            </div>
            <p class="text-lg text-brand-charcoal-600 font-light leading-relaxed mb-6 max-w-xl">
              Thoughtfully planned journeys combining destinations, experiences, and essential travel services.
            </p>
            <div class="inline-flex items-center text-sm font-medium text-brand-charcoal-900 group-hover:text-brand-gold-500 transition-colors duration-500 uppercase tracking-widest">
              View packages <span class="ml-2 transition-transform duration-500 group-hover:translate-x-2">&rarr;</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- Featured Experiences Section -->
<section class="bg-white py-24 lg:py-32">
  <div class="container-main">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16 lg:mb-24">
      <div class="max-w-2xl">
        <div class="mb-6 inline-flex items-center gap-4">
          <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
          <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase">Curated Journeys</span>
        </div>
        <h2 class="text-4xl lg:text-5xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-tight">
          Featured Experiences
        </h2>
      </div>
      <div class="max-w-md md:pb-2">
        <p class="text-lg text-brand-charcoal-600 font-light leading-relaxed">
          Discover some of the journeys waiting for you across Trabzon and the Eastern Black Sea.
        </p>
      </div>
    </div>

    <!-- Featured Tours Grid -->
    <% if @featured_tours.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        <% @featured_tours.each do |tour| %>
          <div class="group flex flex-col h-full bg-white border border-brand-gray-200/60 overflow-hidden hover:border-brand-charcoal-900/20 transition-all duration-500">
            <!-- Image Area -->
            <div class="relative w-full aspect-[4/3] bg-[#faf9f6] overflow-hidden border-b border-brand-gray-200/60">
              <% if tour.image.attached? %>
                <%= image_tag tour.image, class: "w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" %>
              <% else %>
                <div class="w-full h-full flex flex-col items-center justify-center text-brand-gray-300 transition-transform duration-700 group-hover:scale-105">
                  <svg class="w-10 h-10 mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                  </svg>
                  <span class="text-[10px] uppercase tracking-widest font-semibold text-brand-gray-400">Image Asset Pending</span>
                </div>
              <% end %>
            </div>

            <!-- Content Area -->
            <div class="p-8 flex flex-col flex-grow">
              <div class="mb-4">
                <span class="text-xs font-semibold text-brand-gold-500 uppercase tracking-widest block mb-2"><%= tour.destination %></span>
                <h3 class="text-2xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-700 transition-colors duration-300"><%= tour.title %></h3>
              </div>
              <p class="text-brand-charcoal-600 font-light leading-relaxed mb-8 flex-grow">
                <%= tour.description.sub(/\A\[DEVELOPMENT PLACEHOLDER\]\s*/, "") %>
              </p>
              <div class="mt-auto pt-6 border-t border-brand-gray-100 flex items-center justify-between">
                <a href="<%= tour_path(tour) %>" class="inline-flex items-center text-sm font-medium text-brand-charcoal-900 group-hover:text-brand-gold-500 transition-colors uppercase tracking-widest">
                  Explore Tour
                </a>
                <span class="text-brand-charcoal-900 group-hover:text-brand-gold-500 transition-transform duration-500 group-hover:translate-x-1">&rarr;</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="w-full py-20 border border-brand-gray-200/60 bg-[#faf9f6] flex flex-col items-center justify-center text-center px-4">
        <span class="text-brand-gray-400 mb-4">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
          </svg>
        </span>
        <h3 class="text-xl font-medium text-brand-charcoal-900 mb-2">Experiences Coming Soon</h3>
        <p class="text-brand-charcoal-600 font-light max-w-md">Our curated journeys are currently being finalized. Please check back shortly for new adventures.</p>
      </div>
    <% end %>

  </div>
</section>

