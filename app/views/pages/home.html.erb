<section class="relative w-full min-h-[450px] lg:min-h-[700px] py-20 lg:py-0 lg:h-[90vh] flex items-center justify-center overflow-hidden bg-brand-green-900">
  <div class="absolute inset-0 z-0">
    <% if File.exist?(Rails.root.join("app/assets/images/hero-trabzon-bg.jpg")) %>
      <%= image_tag "hero-trabzon-bg.jpg", alt: "Trabzon and Eastern Black Sea Landscape", class: "w-full h-full object-cover object-center" %>
      <div class="absolute inset-0 z-10 bg-black/40"></div>
    <% else %>
      <div class="w-full h-full bg-brand-green-900"></div>
    <% end %>
  </div>

  <div class="relative z-20 container-main w-full pt-20 lg:pt-0 text-center flex flex-col items-center">
    
    <div class="max-w-4xl flex flex-col items-center gap-6">
      <div class="inline-flex items-center gap-4">
        <span class="w-8 sm:w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
        <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase">
          <%= t("home.region_badge") %>
        </span>
        <span class="w-8 sm:w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
      </div>

      <h1 class="text-white font-sans text-5xl sm:text-6xl lg:text-[5rem] font-medium tracking-tight leading-[1.1]">
        <%= t("home.hero_title_line1") %><br>
        <span class="text-brand-gray-200"><%= t("home.hero_title_line2") %></span>
      </h1>

      <p class="text-lg sm:text-xl text-white/90 font-light leading-relaxed max-w-2xl mt-2 mb-6">
        <%= t("home.hero_subtitle") %>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 w-full sm:w-auto">
        <%= link_to t("home.explore_tours"), tours_path, class: "btn bg-white text-brand-green-900 hover:bg-brand-gray-100 px-10 py-4 shadow-xl w-full sm:w-auto font-medium text-sm tracking-widest uppercase text-center transition-colors rounded-none" %>
        <%= link_to t("home.plan_your_trip"), plan_your_trip_path, class: "btn bg-transparent border border-white/30 text-white hover:bg-white/10 hover:border-white/50 px-10 py-4 w-full sm:w-auto font-medium text-sm tracking-widest uppercase text-center transition-colors rounded-none" %>
      </div>
    </div>

  </div>
</section>

<!-- Featured Experiences Section -->
<section class="bg-[#faf9f6] py-12 lg:py-24">
  <div class="container-main">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-6 lg:mb-12">
      <div class="max-w-2xl">
        <%= render "shared/components/section_heading", 
                   eyebrow: t("home.curated_journeys"), 
                   title: t("home.featured_experiences"), 
                   description: t("home.featured_description"),
                   no_margin: true %>
      </div>
      <div class="pb-2">
        <%= link_to tours_path, class: "text-sm font-semibold tracking-widest uppercase text-brand-charcoal-900 hover:text-brand-green-700 transition-colors inline-flex items-center gap-1" do %>
          <%= t("home.view_all_tours") %> <span class="inline-block rtl:rotate-180">&rarr;</span>
        <% end %>
      </div>
    </div>

<% if @featured_tours.any? %>
  <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 md:gap-8 pb-8 hide-scrollbar md:grid md:grid-cols-2 lg:grid-cols-3">
    <% @featured_tours.each do |tour| %>
      <div class="snap-start flex-none w-[80%] sm:w-[60%] md:w-auto h-auto">
        <%= render "shared/components/tour_card", tour: tour %>
      </div>
    <% end %>
  </div>
    <% else %>
      <%= render "shared/components/empty_state", 
                 title: t("home.empty_tours_title"), 
                 message: t("home.empty_tours_message") %>
    <% end %>

  </div>
</section>

<!-- Travel Services Section -->
<section class="bg-white py-12 lg:py-24 border-t border-brand-gray-200/50">
  <div class="container-main">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-6 lg:mb-12">
      <div class="max-w-2xl">
        <%= render "shared/components/section_heading", 
                   eyebrow: t("home.our_expertise"), 
                   title: t("home.travel_services"), 
                   description: t("home.services_description"),
                   no_margin: true %>
      </div>
      <div class="pb-2">
        <%= link_to services_path, class: "text-sm font-semibold tracking-widest uppercase text-brand-charcoal-900 hover:text-brand-green-700 transition-colors inline-flex items-center gap-1" do %>
          <%= t("home.view_all_services") %> <span class="inline-block rtl:rotate-180">&rarr;</span>
        <% end %>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-10">
      
      <!-- Transportation -->
      <div class="group border border-brand-gray-200/60 p-6 lg:p-10 hover:border-brand-gold-400 transition-colors duration-500 bg-[#faf9f6]">
        <h3 class="text-xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-800 transition-colors duration-500 mb-6 pb-4 border-b border-brand-gray-200/60"><%= t("home.transportation") %></h3>
        <ul class="space-y-4">
          <li><%= link_to t("home.airport_transfers"), airport_transfer_path, class: "text-brand-charcoal-700 hover:text-brand-green-700 transition-colors block" %></li>
          <li><%= link_to t("home.car_rental"), car_rental_path, class: "text-brand-charcoal-700 hover:text-brand-green-700 transition-colors block" %></li>
          <li><%= link_to t("home.chauffeured_car"), chauffeured_car_path, class: "text-brand-charcoal-700 hover:text-brand-green-700 transition-colors block" %></li>
        </ul>
      </div>

      <!-- Accommodation -->
      <div class="group border border-brand-gray-200/60 p-6 lg:p-10 hover:border-brand-gold-400 transition-colors duration-500 bg-[#faf9f6]">
        <h3 class="text-xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-800 transition-colors duration-500 mb-6 pb-4 border-b border-brand-gray-200/60"><%= t("home.accommodation") %></h3>
        <ul class="space-y-4">
          <li><%= link_to t("home.hotels"), accommodations_path(type: 'hotel'), class: "text-brand-charcoal-700 hover:text-brand-green-700 transition-colors block" %></li>
          <li><%= link_to t("home.apartments"), accommodations_path(type: 'apartment'), class: "text-brand-charcoal-700 hover:text-brand-green-700 transition-colors block" %></li>
          <li><%= link_to t("home.bungalows"), accommodations_path(type: 'bungalow'), class: "text-brand-charcoal-700 hover:text-brand-green-700 transition-colors block" %></li>
          <li><%= link_to t("home.chalets"), accommodations_path(type: 'chalet'), class: "text-brand-charcoal-700 hover:text-brand-green-700 transition-colors block" %></li>
        </ul>
      </div>

      <!-- Experiences -->
      <div class="group border border-brand-gray-200/60 p-6 lg:p-10 hover:border-brand-gold-400 transition-colors duration-500 bg-[#faf9f6]">
        <h3 class="text-xl font-medium text-brand-charcoal-900 group-hover:text-brand-green-800 transition-colors duration-500 mb-6 pb-4 border-b border-brand-gray-200/60"><%= t("home.experiences") %></h3>
        <ul class="space-y-4">
          <li><%= link_to t("home.private_tours"), private_tours_path, class: "text-brand-charcoal-700 hover:text-brand-green-700 transition-colors block" %></li>
          <li><%= link_to t("home.travel_packages"), packages_path, class: "text-brand-charcoal-700 hover:text-brand-green-700 transition-colors block" %></li>
        </ul>
      </div>

    </div>
  </div>
</section>



<!-- Why 61 EDİZ TRAVEL Section -->

<section class="bg-brand-green-900 text-white py-12 lg:py-32 border-t border-brand-green-800 relative overflow-hidden">
  <div class="absolute inset-0 bg-brand-charcoal-900/10 pointer-events-none"></div>

  <div class="container-main relative z-10">
    <%= render "shared/components/section_heading",
               center: true,
               dark: true,
               eyebrow: t("home.why_us_eyebrow"),
               title: t("home.why_us_title"),
               description: t("home.why_us_desc") %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-y-6 md:gap-y-0 md:divide-x divide-white/15 border-t border-b border-white/15 py-6 lg:py-16 mt-4 lg:mt-16 text-center md:text-start">
      
      <div class="px-0 py-2 md:py-0 md:pe-8 lg:pe-12 md:ps-0 flex flex-col md:justify-start">
        <span class="text-2xl lg:text-3xl font-light text-brand-gold-500 font-sans tracking-tighter block mb-2 lg:mb-4">01</span>
        <h3 class="text-lg lg:text-xl font-medium text-white mb-2 lg:mb-4"><%= t("home.pillar_1_title") %></h3>
        <p class="text-white/70 font-light leading-relaxed">
          <%= t("home.pillar_1_desc") %>
        </p>
      </div>

      <div class="px-0 py-2 md:py-0 md:px-8 lg:px-12 flex flex-col md:justify-start">
        <span class="text-2xl lg:text-3xl font-light text-brand-gold-500 font-sans tracking-tighter block mb-2 lg:mb-4">02</span>
        <h3 class="text-lg lg:text-xl font-medium text-white mb-2 lg:mb-4"><%= t("home.pillar_2_title") %></h3>
        <p class="text-white/70 font-light leading-relaxed">
          <%= t("home.pillar_2_desc") %>
        </p>
      </div>

      <div class="px-0 py-2 md:py-0 md:ps-8 lg:ps-12 md:pe-0 flex flex-col md:justify-start">
        <span class="text-2xl lg:text-3xl font-light text-brand-gold-500 font-sans tracking-tighter block mb-2 lg:mb-4">03</span>
        <h3 class="text-lg lg:text-xl font-medium text-white mb-2 lg:mb-4"><%= t("home.pillar_3_title") %></h3>
        <p class="text-white/70 font-light leading-relaxed">
          <%= t("home.pillar_3_desc_html").html_safe %>
        </p>
      </div>

    </div>

  </div>
</section>

<!-- Travel Guide Preview Section -->
<section class="bg-[#faf9f6] py-12 lg:py-32 border-t border-brand-gray-200/50">
  <div class="container-main">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 <%= @travel_guides && @travel_guides.any? ? 'mb-12' : 'mb-6' %>">
      <div class="max-w-2xl">
        <%= render "shared/components/section_heading", 
                   eyebrow: t("home.travel_guide_eyebrow"), 
                   title: t("home.travel_guide_title"), 
                   description: t("home.travel_guide_desc"),
                   no_margin: !(@travel_guides && @travel_guides.any?) %>
      </div>
      <div class="pb-2">
        <%= link_to travel_guides_path, class: "text-sm font-semibold tracking-widest uppercase text-brand-charcoal-900 hover:text-brand-green-700 transition-colors inline-flex items-center gap-1" do %>
          <%= t("home.view_all_guides") %> <span class="inline-block rtl:rotate-180">&rarr;</span>
        <% end %>
      </div>
    </div>
    
    <% if @travel_guides && @travel_guides.any? %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% @travel_guides.first(3).each do |guide| %>
          <div class="border border-brand-gray-200/60 p-6 hover:border-brand-gold-400 transition-colors bg-white">
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-3"><%= link_to guide.title, travel_guide_path(guide) %></h3>
            <p class="text-sm text-brand-charcoal-600 font-light line-clamp-3"><%= guide.excerpt %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/components/empty_state", 
                 title: t("home.empty_guides_title"), 
                 message: t("home.empty_guides_message") %>
    <% end %>
  </div>
</section>

<!-- Final CTA Section -->
<section class="bg-white py-12 lg:py-20">
  <div class="container-main text-center">
    <div class="max-w-2xl mx-auto flex flex-col items-center">
      
      <div class="mb-6 inline-flex items-center gap-4">
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-80"></span>
        <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase"><%= t("home.cta_eyebrow") %></span>
        <span class="w-8 h-[1px] bg-brand-gold-500 opacity-80"></span>
      </div>
      
      <h2 class="text-2xl lg:text-5xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.1] mb-6">
        <%= t("home.cta_title") %>
      </h2>
      
      <p class="text-base lg:text-lg text-brand-charcoal-600 font-light leading-relaxed mb-10">
        <%= t("home.cta_subtitle") %>
      </p>
      
      <%= link_to t("nav.plan_your_trip"), plan_your_trip_path, class: "px-10 py-5 bg-brand-charcoal-900 text-white font-medium text-sm tracking-widest uppercase hover:bg-brand-green-900 transition-colors inline-block" %>
      
    </div>
  </div>
</section>
