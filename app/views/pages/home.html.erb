<% content_for :meta_description, t("seo.home_meta_description", default: "Discover Trabzon and the Eastern Black Sea with 61 EDİZ TRAVEL. Private tours, VIP transfers, and tailored travel experiences.") %>
<%# ═══════════════════════════════════════════════════════════════
    HERO — Cinematic, image-forward, minimal overlay
    ═══════════════════════════════════════════════════════════════ %>
<% video_url = hero_video_stream_url %>
<section class="relative w-full h-[90vh] min-h-[560px] max-h-[900px] flex items-end overflow-hidden bg-black">
  <% if video_url.present? %>
    <video autoplay muted loop playsinline preload="metadata"
           poster="<%= asset_path('uzungol.webp') %>"
           class="absolute inset-0 w-full h-full object-cover bg-black">
      <source src="<%= video_url %>" type="video/mp4">
    </video>
  <% else %>
    <%= image_tag "uzungol.webp",
          class: "absolute inset-0 w-full h-full object-cover",
          alt: "Uzungöl, Trabzon",
          fetchpriority: "high",
          style: "object-position: center 40%" %>
  <% end %>

  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent mix-blend-multiply pointer-events-none"></div>
  
  <div class="relative z-10 w-full container-main pb-16 md:pb-24">
    <div class="max-w-4xl max-w-full">
      <span class="inline-block text-brand-gold-400 font-semibold tracking-[0.2em] text-xs md:text-sm uppercase mb-4 opacity-90 slide-up"><%= t(".welcome_prefix", default: "TÜRSAB Licensed Local Agency · Trabzon") %></span>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-semibold text-white leading-[1.1] mb-6 slide-up" style="animation-delay: 100ms">
        <%= t(".hero_title", default: "Private Travel in Trabzon & The Black Sea") %>
      </h1>
      <p class="text-lg md:text-xl text-white/90 max-w-2xl mb-10 font-light leading-relaxed slide-up" style="animation-delay: 200ms">
        <%= t(".hero_subtitle", default: "Thoughtfully paced private tours, chauffeured vehicles, and honest local guidance across Trabzon, Rize, and the Eastern Black Sea plateaus.") %>
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 slide-up" style="animation-delay: 300ms">
        <%= link_to tours_path, class: "btn-primary py-4 px-8" do %>
          <%= t(".view_tours", default: "Explore Private Tours") %>
        <% end %>
        <%= link_to plan_your_trip_path, class: "btn-outline border-white/30 text-white hover:bg-white hover:text-brand-charcoal-900 py-4 px-8 bg-transparent" do %>
          <%= t(".plan_trip", default: "Plan Your Trip") %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════
    TRUST STRIP — Orientation and Credentials
    ═══════════════════════════════════════════════════════════════ %>
<section class="bg-brand-charcoal-900 text-white/80 py-5 border-t border-white/10">
  <div class="container-main">
    <div class="flex flex-wrap items-center justify-center sm:justify-between gap-x-8 gap-y-4 text-xs md:text-sm tracking-wide font-medium">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 11.955 0 0112 2.944a11.955 11.955 11.955 0 01-8.618 3.04A12.02 12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span>TÜRSAB <%= t("tursab_no_html", default: "No. <strong>15956</strong>").html_safe %></span>
      </div>
      <div class="flex items-center gap-2 hidden md:flex">
        <svg class="w-4 h-4 text-brand-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span><%= t(".trabzon_based", default: "Trabzon-Based Local Agency") %></span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span><%= t(".private_focus", default: "100% Private Travel") %></span>
      </div>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════
    DISCOVER — Destination Mosaic
    ═══════════════════════════════════════════════════════════════ %>
<section class="section-padding bg-white">
  <div class="container-main">
    <div class="max-w-2xl mb-12 lg:mb-16">
      <h2 class="heading-2 mb-4"><%= t(".discover_title", default: "Discover the Black Sea") %></h2>
      <p class="text-brand-gray-600 text-lg md:text-xl font-light"><%= t(".discover_desc", default: "Mountains, plateaus, and deep green valleys. A region defined by nature and history.") %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 h-[800px] md:h-[600px]">
      <%# Main featured location %>
      <div class="md:col-span-2 lg:col-span-2 md:row-span-2 relative">
        <%= link_to (@uzungol ? tour_path(@uzungol) : tours_path), class: "group relative h-full overflow-hidden block bg-brand-charcoal-800" do %>
          <%= image_tag "uzungol.webp", class: "absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 opacity-90", alt: "Uzungöl", loading: "lazy" %>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 start-0 p-6 md:p-10">
            <h3 class="text-2xl md:text-3xl font-medium text-white mb-2"><%= t(".uzungol", default: "Uzungöl") %></h3>
            <p class="text-white/80 font-light text-sm md:text-base opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300"><%= t(".uzungol_desc", default: "The iconic alpine lake surrounded by steep green mountains.") %></p>
          </div>
        <% end %>
      </div>

      <%# Secondary locations %>
      <div class="flex flex-col gap-4 md:gap-6 md:col-span-2 lg:col-span-2">
        <div class="grid grid-cols-2 gap-4 md:gap-6 h-1/2">
          <%# Ayder %>
          <%= link_to (@ayder ? tour_path(@ayder) : tours_path), class: "group relative h-full overflow-hidden block bg-brand-charcoal-800" do %>
            <% if @ayder&.image&.attached? %>
              <%= image_tag @ayder.image.variant(resize_to_fill: [800, 800], format: :webp), class: "absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 opacity-80", alt: "Ayder Plateau", loading: "lazy" %>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 start-0 p-4 md:p-6">
              <h3 class="text-base md:text-lg lg:text-xl font-medium text-white"><%= t(".ayder", default: "Ayder Plateau") %></h3>
            </div>
          <% end %>

          <%# Trabzon %>
          <%= link_to (@trabzon ? tour_path(@trabzon) : tours_path), class: "group relative h-full overflow-hidden block bg-brand-charcoal-800" do %>
            <% if @trabzon&.image&.attached? && @trabzon.image.variable? %>
              <%= image_tag @trabzon.image.variant(resize_to_fill: [800, 800], format: :webp), class: "absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 opacity-80", alt: "Trabzon", loading: "lazy" %>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 start-0 p-4 md:p-6">
              <h3 class="text-base md:text-lg lg:text-xl font-medium text-white"><%= t(".trabzon", default: "Trabzon") %></h3>
            </div>
          <% end %>
        </div>

        <%# Sumela %>
        <%= link_to (@sumela ? tour_path(@sumela) : tours_path), class: "group relative h-1/2 overflow-hidden block bg-brand-charcoal-800" do %>
          <% if @sumela&.image&.attached? %>
            <%= image_tag @sumela.image.variant(resize_to_fill: [1200, 600], format: :webp), class: "absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 opacity-80", alt: "Sümela Monastery", loading: "lazy" %>
          <% end %>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 start-0 p-6 md:p-8">
            <h3 class="text-xl md:text-2xl font-medium text-white mb-1"><%= t(".sumela", default: "Sümela Monastery") %></h3>
            <p class="text-white/80 font-light text-sm hidden sm:block"><%= t(".sumela_desc", default: "Ancient cliff-face sanctuary") %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════
    SIGNATURE EXPERIENCES — Featured Tours
    ═══════════════════════════════════════════════════════════════ %>
<section class="section-padding bg-brand-gray-50 border-y border-brand-gray-100">
  <div class="container-main">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-xl">
        <span class="text-sm font-semibold tracking-widest text-brand-gold-600 uppercase mb-3 block"><%= t(".featured_subtitle", default: "Signature Experiences") %></span>
        <h2 class="heading-2"><%= t(".featured_title", default: "Curated for You") %></h2>
      </div>
      <div>
        <%= link_to tours_path, class: "group flex items-center gap-2 text-brand-charcoal-900 font-medium hover:text-brand-gold-600 transition-colors" do %>
          <%= t(".see_all_tours", default: "See All Private Tours") %>
          <svg class="w-4 h-4 rtl:rotate-180 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <% end %>
      </div>
    </div>

    <%# Mobile: horizontal scroll-snap container %>
    <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory hide-scrollbar pb-4 -mx-4 px-4 md:mx-0 md:px-0 md:grid md:grid-cols-2 lg:grid-cols-4 md:gap-6 lg:gap-8 md:overflow-visible md:pb-0">
      <% @featured_tours.each do |tour| %>
        <%= link_to tour_path(tour), class: "group flex flex-col snap-center shrink-0 w-[85vw] sm:w-[75vw] md:w-auto border border-brand-gray-200/60 hover:border-brand-gold-400 transition-colors duration-300 bg-white" do %>
          <div class="relative aspect-[4/3] overflow-hidden bg-brand-charcoal-50">
            <% if tour.image.attached? && tour.image.variable? %>
              <%= image_tag tour.image.variant(resize_to_fill: [800, 600], format: :webp),
                  class: "w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700",
                  alt: tour.title, loading: "lazy" %>
            <% end %>
            <div class="absolute top-3 start-3 bg-white/90 backdrop-blur px-2.5 py-1 text-[10px] font-semibold tracking-wider uppercase text-brand-charcoal-700">
              <%= t(".private_experience", default: "Private") %>
            </div>
          </div>
          <div class="p-5 md:p-6 flex flex-col flex-grow">
            <h3 class="text-base md:text-lg font-medium text-brand-charcoal-900 mb-3 group-hover:text-brand-green-700 transition-colors line-clamp-2 leading-snug"><%= tour.title %></h3>

            <div class="mt-auto pt-3 flex flex-wrap gap-y-2 items-center justify-between border-t border-brand-gray-100">
              <% if tour.duration.present? %>
                <span class="text-sm text-brand-charcoal-600 flex items-center gap-1.5">
                  <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <%= localized_duration(tour.duration) %>
                </span>
              <% end %>
              <% if tour.price_from.present? && tour.price_from > 0 %>
                <div class="text-end">
                  <span class="text-[11px] text-brand-charcoal-500 block leading-none mb-0.5"><%= t(".starting_from", default: "From") %></span>
                  <span class="text-sm font-semibold text-brand-charcoal-900"><%= number_to_currency(tour.price_from, unit: tour.currency == 'USD' ? '$' : '₺', precision: 0) %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════
    TRAVEL SERVICES — editorial blocks
    ═══════════════════════════════════════════════════════════════ %>
<section class="py-16 lg:py-28 bg-brand-charcoal-900 text-white">
  <div class="container-main">
    <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-20">
      <h2 class="text-2xl sm:text-3xl lg:text-5xl font-sans font-medium tracking-tight mb-4 lg:mb-6">
        <%= t(".services_title", default: "Travel Services") %>
      </h2>
      <p class="text-base lg:text-lg text-white/70 font-light leading-relaxed">
        <%= t(".services_desc", default: "Comprehensive local expertise for a seamless Black Sea journey.") %>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-white/10 border border-white/10">
      <%# Private Tours %>
      <div class="bg-brand-charcoal-900 p-8 lg:p-10">
        <h3 class="text-lg lg:text-xl font-medium text-brand-gold-500 mb-3"><%= t(".private_tours_title", default: "Private Tours") %></h3>
        <p class="text-white/60 font-light mb-6 text-sm leading-relaxed"><%= t(".private_tours_desc", default: "Fully guided daily excursions tailored exclusively to your group, ensuring privacy and flexibility.") %></p>
        <ul class="space-y-3 text-[15px]">
          <li><%= link_to private_tours_path, class: "text-white/90 hover:text-brand-gold-400 transition-colors inline-flex items-center gap-1.5" do %><span class="rtl:rotate-180 opacity-50">&rarr;</span> <%= t("home.private_tours") %><% end %></li>
          <li><%= link_to packages_path, class: "text-white/90 hover:text-brand-gold-400 transition-colors inline-flex items-center gap-1.5" do %><span class="rtl:rotate-180 opacity-50">&rarr;</span> <%= t("home.travel_packages") %><% end %></li>
        </ul>
      </div>

      <%# Private Transport %>
      <div class="bg-brand-charcoal-900 p-8 lg:p-10">
        <h3 class="text-lg lg:text-xl font-medium text-brand-gold-500 mb-3"><%= t(".private_transport_title", default: "Private Transport") %></h3>
        <p class="text-white/60 font-light mb-6 text-sm leading-relaxed"><%= t(".private_transport_desc", default: "Premium late-model vehicles with professional local drivers for comfortable regional travel.") %></p>
        <ul class="space-y-3 text-[15px]">
          <li><%= link_to airport_transfer_path, class: "text-white/90 hover:text-brand-gold-400 transition-colors inline-flex items-center gap-1.5" do %><span class="rtl:rotate-180 opacity-50">&rarr;</span> <%= t("home.airport_transfers") %><% end %></li>
          <li><%= link_to chauffeured_car_path, class: "text-white/90 hover:text-brand-gold-400 transition-colors inline-flex items-center gap-1.5" do %><span class="rtl:rotate-180 opacity-50">&rarr;</span> <%= t("home.chauffeured_car") %><% end %></li>
          <li><%= link_to car_rental_path, class: "text-white/90 hover:text-brand-gold-400 transition-colors inline-flex items-center gap-1.5" do %><span class="rtl:rotate-180 opacity-50">&rarr;</span> <%= t("home.car_rental") %><% end %></li>
        </ul>
      </div>

      <%# Trip Services %>
      <div class="bg-brand-charcoal-900 p-8 lg:p-10">
        <h3 class="text-lg lg:text-xl font-medium text-brand-gold-500 mb-3"><%= t(".trip_services_title", default: "Trip Services") %></h3>
        <p class="text-white/60 font-light mb-6 text-sm leading-relaxed"><%= t(".trip_services_desc", default: "Boutique accommodations and bespoke trip planning to perfect your Black Sea itinerary.") %></p>
        <ul class="space-y-3 text-[15px]">
          <li><%= link_to accommodations_path, class: "text-white/90 hover:text-brand-gold-400 transition-colors inline-flex items-center gap-1.5" do %><span class="rtl:rotate-180 opacity-50">&rarr;</span> <%= t("home.accommodation") %><% end %></li>
          <li><%= link_to plan_your_trip_path, class: "text-white/90 hover:text-brand-gold-400 transition-colors inline-flex items-center gap-1.5" do %><span class="rtl:rotate-180 opacity-50">&rarr;</span> <%= t("nav.plan_your_trip") %><% end %></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════
    THE 61 EDİZ APPROACH — compact, no oversized icons
    ═══════════════════════════════════════════════════════════════ %>
<section class="py-14 lg:py-24 bg-[#faf9f6]">
  <div class="container-main">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-sans font-medium text-brand-charcoal-900 tracking-tight text-center mb-10 lg:mb-14">
      <%= t(".approach_title", default: "The 61 EDİZ Approach") %>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-14">
      <div>
        <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t(".approach_1_title", default: "Local Knowledge") %></h3>
        <p class="text-[15px] text-brand-charcoal-600 font-light leading-relaxed"><%= t(".approach_1_desc", default: "Based in Trabzon, our deep regional roots ensure authentic experiences far beyond the standard tourist trails.") %></p>
      </div>

      <div>
        <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t(".approach_2_title", default: "Private Travel") %></h3>
        <p class="text-[15px] text-brand-charcoal-600 font-light leading-relaxed"><%= t(".approach_2_desc", default: "Every tour is exclusive to your group. No crowded buses, no rushed schedules—just your journey, at your pace.") %></p>
      </div>

      <div>
        <h3 class="text-lg font-medium text-brand-charcoal-900 mb-2"><%= t(".approach_3_title", default: "Thoughtful Planning") %></h3>
        <p class="text-[15px] text-brand-charcoal-600 font-light leading-relaxed"><%= t(".approach_3_desc", default: "From the moment of inquiry to your departure, we provide seamless logistics and attentive 1-on-1 support.") %></p>
      </div>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════
    BEFORE YOU GO — Travel Guides
    ═══════════════════════════════════════════════════════════════ %>
<section class="py-16 lg:py-28 bg-white">
  <div class="container-main">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 md:gap-6 mb-10 lg:mb-14">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl lg:text-5xl font-sans font-medium text-brand-charcoal-900 tracking-tight mb-3 lg:mb-4">
          <%= t(".before_you_go_title", default: "Before You Go") %>
        </h2>
        <p class="text-base lg:text-lg text-brand-charcoal-600 font-light">
          <%= t(".before_you_go_desc", default: "Essential reading and local insights from our Trabzon travel experts.") %>
        </p>
      </div>
      <div class="shrink-0">
        <%= link_to travel_guides_path, class: "text-sm font-semibold tracking-widest uppercase text-brand-charcoal-900 hover:text-brand-green-700 transition-colors inline-flex items-center gap-2 whitespace-nowrap" do %>
          <%= t(".view_all_guides", default: "View All Guides") %> <span class="rtl:rotate-180">&rarr;</span>
        <% end %>
      </div>
    </div>

    <% if @travel_guides && @travel_guides.any? %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <% @travel_guides.each do |guide| %>
          <div class="group flex flex-col h-full border border-brand-gray-200/60 hover:border-brand-gold-400 transition-colors bg-[#faf9f6]">
            <div class="p-6 lg:p-8 flex flex-col flex-grow">
              <span class="text-brand-gold-500 text-[11px] font-semibold tracking-widest uppercase mb-3 block"><%= t(".guide", default: "Guide") %></span>
              <h3 class="text-lg lg:text-xl font-medium text-brand-charcoal-900 mb-3 group-hover:text-brand-green-700 transition-colors leading-snug"><%= link_to guide.title, travel_guide_path(guide) %></h3>
              <p class="text-[15px] text-brand-charcoal-600 font-light line-clamp-3 mb-5 flex-grow leading-relaxed"><%= guide.excerpt %></p>
              <div class="mt-auto">
                <%= link_to travel_guide_path(guide), class: "text-sm font-medium text-brand-charcoal-900 inline-flex items-center gap-1.5 group-hover:text-brand-gold-500 transition-colors" do %>
                  <%= t(".read_more", default: "Read Article") %> <span class="rtl:rotate-180">&rarr;</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/components/empty_state",
                 title: t("home.empty_guides_title"),
                 message: t("home.empty_guides_message") %>
    <% end %>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════
    FINAL CTA
    ═══════════════════════════════════════════════════════════════ %>
<section class="py-16 lg:py-24 bg-brand-charcoal-900 text-white relative overflow-hidden">
  <div class="absolute inset-0 bg-brand-green-900/15 pointer-events-none"></div>
  <div class="container-main text-center relative z-10">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl md:text-5xl lg:text-6xl font-sans font-medium tracking-tight leading-[1.15] mb-8 lg:mb-10">
        <%= t(".final_cta_title", default: "Your Black Sea journey starts here.") %>
      </h2>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 max-w-md sm:max-w-none mx-auto">
        <%= link_to t(".plan_your_trip", default: "Plan Your Trip"), plan_your_trip_path,
            class: "px-10 py-4 bg-brand-gold-500 hover:bg-brand-gold-400 text-brand-charcoal-900 font-medium text-sm tracking-widest uppercase transition-colors text-center" %>

        <% if current_business_setting&.whatsapp_number.present? %>
          <%
            clean_number = current_business_setting.whatsapp_number.to_s.gsub(/[^0-9]/, "")
            encoded_message = ERB::Util.url_encode("Hello, I would like to plan a trip to the Black Sea.")
          %>
