<div class="bg-white min-h-screen">
  
  <!-- Hero Section -->
  <div class="pt-16 lg:pt-24 pb-16 border-b border-brand-gray-200/50 bg-[#faf9f6]">
    <div class="container-main">
      <%= render "shared/components/section_heading",
                 eyebrow: "Get in Touch",
                 title: "Contact Us",
                 description: "We are here to answer your questions and help you plan your perfect journey across the Eastern Black Sea." %>
    </div>
  </div>

  <div class="container-main py-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
      
      <!-- Contact Information -->
      <div>
        <h2 class="text-2xl font-medium text-brand-charcoal-900 tracking-tight mb-8">Contact Information</h2>
        <div class="space-y-8 mb-12">
          <div class="flex items-start gap-5">
            <span class="text-brand-gold-500 mt-1"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg></span>
            <div>
              <span class="block text-xs uppercase tracking-widest font-semibold text-brand-gray-500 mb-1">Office Location</span>
              <span class="text-brand-charcoal-900 text-lg">Trabzon, Türkiye</span>
            </div>
          </div>
          <div class="flex items-start gap-5">
            <span class="text-brand-gold-500 mt-1"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg></span>
            <div>
              <span class="block text-xs uppercase tracking-widest font-semibold text-brand-gray-500 mb-1">Email</span>
              <a href="#" class="text-brand-charcoal-900 text-lg hover:text-brand-gold-500 transition">info@ediztravel.com</a>
            </div>
          </div>
          <div class="flex items-start gap-5">
            <span class="text-brand-gold-500 mt-1"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg></span>
            <div>
              <span class="block text-xs uppercase tracking-widest font-semibold text-brand-gray-500 mb-1">Phone / WhatsApp</span>
              <a href="#" class="text-brand-charcoal-900 text-lg hover:text-brand-gold-500 transition">[Phone Number]</a>
            </div>
          </div>
        </div>
        
        <div class="w-full aspect-video bg-brand-gray-100 flex items-center justify-center border border-brand-gray-200">
          <span class="text-brand-gray-400 text-xs uppercase tracking-widest font-semibold">Map Placeholder</span>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-white border border-brand-gray-200 p-8 lg:p-12 shadow-sm">
        <h2 class="text-2xl font-medium text-brand-charcoal-900 tracking-tight mb-8">Send a Message</h2>
        <form class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold text-brand-charcoal-900 uppercase tracking-widest mb-2">Full Name</label>
              <input type="text" class="w-full border-b border-brand-gray-200 py-3 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-gold-500 transition-colors" placeholder="John Doe">
            </div>
            <div>
              <label class="block text-xs font-semibold text-brand-charcoal-900 uppercase tracking-widest mb-2">Email Address</label>
              <input type="email" class="w-full border-b border-brand-gray-200 py-3 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-gold-500 transition-colors" placeholder="john@example.com">
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-brand-charcoal-900 uppercase tracking-widest mb-2">Subject</label>
            <input type="text" class="w-full border-b border-brand-gray-200 py-3 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-gold-500 transition-colors" placeholder="How can we help?">
          </div>
          <div>
            <label class="block text-xs font-semibold text-brand-charcoal-900 uppercase tracking-widest mb-2">Message</label>
            <textarea rows="4" class="w-full border-b border-brand-gray-200 py-3 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-gold-500 transition-colors" placeholder="Your message here..."></textarea>
          </div>
          <div class="pt-4">
            <button type="button" class="w-full px-8 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors">
              Send Message
            </button>
          </div>
        </form>
      </div>
      
    </div>
  </div>
</div>
