<% content_for :title, t("contact.page_title") %>

<div class="bg-white min-h-screen">
  
  <!-- Hero Section -->
  <div class="pt-16 lg:pt-24 pb-16 border-b border-brand-gray-200/50 bg-[#faf9f6]">
    <div class="container-main">
      <%= render "shared/components/section_heading",
                 eyebrow: t("contact.eyebrow"),
                 title: t("contact.title"),
                 description: t("contact.description"),
                 as_h1: true %>
    </div>
  </div>

  <div class="container-main py-10 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-24">
      
      <!-- Contact Information -->
      <div class="flex flex-col justify-between">
        <div>
          <h2 class="text-2xl font-medium text-brand-charcoal-900 tracking-tight mb-6"><%= t("contact.agency_info") %></h2>
          <p class="text-brand-charcoal-600 font-light leading-relaxed mb-8">
            <%= t("contact.agency_info_desc") %>
          </p>

          <div class="space-y-6 mb-10 border-t border-brand-gray-200/60 pt-6">
            <div>
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 block mb-1"><%= t("contact.agency_label") %></span>
              <p class="text-brand-charcoal-900 font-medium">61 EDİZ TRAVEL</p>
              <p class="text-sm text-brand-charcoal-600 font-light">LAZ TUR TURİZM İNŞAAT TİCARET LİMİTED ŞİRKETİ</p>
              <p class="text-sm text-brand-charcoal-600 font-light"><%= t("common.tursab_full_document_no") %></p>
            </div>
            <div>
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 block mb-1"><%= t("contact.location_label") %></span>
              <p class="text-brand-charcoal-900 font-medium"><%= t("contact.location_value") %></p>
              <p class="text-sm text-brand-charcoal-600 font-light"><%= t("contact.region_value") %></p>
            </div>
            <div>
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 block mb-1"><%= t("contact.trip_inquiries_label") %></span>
              <p class="text-sm text-brand-charcoal-600 font-light mb-2"><%= t("contact.trip_inquiries_desc") %></p>
              <%= link_to plan_your_trip_path, class: "text-sm font-semibold text-brand-charcoal-900 hover:text-brand-green-700 uppercase tracking-wider inline-flex items-center gap-1" do %>
                <%= t("contact.plan_your_trip") %> <span class="inline-block rtl:rotate-180">&rarr;</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-white border border-brand-gray-200 p-8 lg:p-12 shadow-sm">
  <h2 class="text-2xl font-medium text-brand-charcoal-900 tracking-tight mb-8"><%= t("contact.send_message_title") %></h2>
  
  <% if notice %>
    <div class="bg-green-50 text-green-800 p-4 mb-6 text-sm border-s-4 border-green-500">
      <%= notice %>
    </div>
  <% end %>
  <% if alert %>
    <div class="bg-red-50 text-red-800 p-4 mb-6 text-sm border-s-4 border-red-500">
      <%= alert %>
    </div>
  <% end %>

  <%= form_with model: ContactMessage.new, url: contact_messages_path, local: true, class: "space-y-6" do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :name, t("contact.full_name"), class: "block text-xs font-semibold text-brand-charcoal-900 uppercase tracking-widest mb-2" %>
        <%= f.text_field :name, required: true, class: "w-full border-b border-brand-gray-200 py-3 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-gold-500 transition-colors", placeholder: t("contact.full_name_placeholder") %>
      </div>
      <div>
        <%= f.label :email, t("contact.email_address"), class: "block text-xs font-semibold text-brand-charcoal-900 uppercase tracking-widest mb-2" %>
        <%= f.email_field :email, required: true, class: "w-full border-b border-brand-gray-200 py-3 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-gold-500 transition-colors", placeholder: t("contact.email_placeholder") %>
      </div>
    </div>
    <div>
      <%= f.label :subject, t("contact.subject"), class: "block text-xs font-semibold text-brand-charcoal-900 uppercase tracking-widest mb-2" %>
      <%= f.text_field :subject, class: "w-full border-b border-brand-gray-200 py-3 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-gold-500 transition-colors", placeholder: t("contact.subject_placeholder") %>
    </div>
    <div>
      <%= f.label :message, t("contact.message"), class: "block text-xs font-semibold text-brand-charcoal-900 uppercase tracking-widest mb-2" %>
      <%= f.text_area :message, required: true, rows: 4, class: "w-full border-b border-brand-gray-200 py-3 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-gold-500 transition-colors", placeholder: t("contact.message_placeholder") %>
    </div>
    <div class="pt-4">
      <%= f.submit t("contact.send_message_button"), class: "w-full px-8 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>

      
    </div>
  </div>
</div>
