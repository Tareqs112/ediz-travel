<div class="bg-white min-h-screen border-t border-brand-gray-200/50">
  
  <!-- Hero Section -->
  <div class="pt-16 lg:pt-28 pb-16 lg:pb-24 border-b border-brand-gray-200/50">
    <div class="container-main max-w-4xl">
      <div class="mb-6 inline-flex items-center gap-4">
        <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
        <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase">Trabzon &bull; Eastern Black Sea</span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.1] mb-8">
        More Than a Day.<br>A Complete Journey.
      </h1>
      <p class="text-lg lg:text-xl text-brand-charcoal-600 font-light leading-relaxed mb-10 max-w-2xl">
        Discover the Eastern Black Sea through thoughtfully arranged multi-day travel experiences.
      </p>
      <div>
        <%= link_to "Plan Your Trip", plan_your_trip_path, class: "inline-block px-10 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors" %>
      </div>
    </div>
  </div>

  <!-- Features Section (Light) -->
  <div class="bg-[#faf9f6] py-16 lg:py-24 border-b border-brand-gray-200/60">
    <div class="container-main">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-24">
        
        <div class="lg:w-1/3">
          <h2 class="text-3xl lg:text-4xl font-medium text-brand-charcoal-900 tracking-tight">Travel, Fully Arranged.</h2>
        </div>
        
        <div class="lg:w-2/3">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12 lg:gap-y-16">
            
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-3">01</span>
              <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3">Multi-Day Experiences</h3>
              <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
                Journeys designed to explore more than one destination.
              </p>
            </div>
            
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-3">02</span>
              <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3">Thoughtful Planning</h3>
              <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
                A clear itinerary built around your travel dates and interests.
              </p>
            </div>
            
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-3">03</span>
              <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3">Comfortable Stays</h3>
              <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
                Accommodation can be part of the journey when requested.
              </p>
            </div>
            
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-3">04</span>
              <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3">Seamless Travel</h3>
              <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
                Tours, transfers, and other travel arrangements can be combined into one trip.
              </p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Packages List -->
  <div class="py-16 lg:py-28 bg-white">
    <div class="container-main">
      <div class="mb-16">
        <h2 class="text-3xl lg:text-4xl font-medium text-brand-charcoal-900 tracking-tight">Choose Your Journey</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Package Card 1 -->
        <div class="group flex flex-col h-full border border-brand-gray-200/60 p-4">
          <div class="relative w-full aspect-[4/3] bg-brand-gray-100 overflow-hidden mb-6 flex items-center justify-center border border-brand-gray-200/50">
            <div class="text-brand-gray-400 flex flex-col items-center">
              <span class="text-xs uppercase tracking-widest font-semibold mb-2 text-brand-gray-500">Image Asset Pending</span>
              <span class="text-xs font-mono">Escape Placeholder</span>
            </div>
          </div>
          <div class="flex-grow flex flex-col">
            <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-2">[DEVELOPMENT PLACEHOLDER]</span>
            <h3 class="text-2xl font-medium text-brand-charcoal-900 mb-3">Eastern Black Sea Escape</h3>
            <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm mb-6 line-clamp-3">
              A carefully arranged multi-day journey covering the essential highlights of the region.
            </p>
            <div class="mt-auto pt-4 border-t border-brand-gray-200/60">
              <a href="#" class="inline-block font-medium text-brand-charcoal-900 hover:text-brand-green-700 transition-colors uppercase tracking-widest text-sm">
                View Package &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Package Card 2 -->
        <div class="group flex flex-col h-full border border-brand-gray-200/60 p-4">
          <div class="relative w-full aspect-[4/3] bg-brand-gray-100 overflow-hidden mb-6 flex items-center justify-center border border-brand-gray-200/50">
            <div class="text-brand-gray-400 flex flex-col items-center">
              <span class="text-xs uppercase tracking-widest font-semibold mb-2 text-brand-gray-500">Image Asset Pending</span>
              <span class="text-xs font-mono">Journey Placeholder</span>
            </div>
          </div>
          <div class="flex-grow flex flex-col">
            <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-2">[DEVELOPMENT PLACEHOLDER]</span>
            <h3 class="text-2xl font-medium text-brand-charcoal-900 mb-3">Trabzon &amp; Uzungöl Journey</h3>
            <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm mb-6 line-clamp-3">
              Experience the bustling city and the tranquil highlands together in this focused itinerary.
            </p>
            <div class="mt-auto pt-4 border-t border-brand-gray-200/60">
              <a href="#" class="inline-block font-medium text-brand-charcoal-900 hover:text-brand-green-700 transition-colors uppercase tracking-widest text-sm">
                View Package &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Package Card 3 -->
        <div class="group flex flex-col h-full border border-brand-gray-200/60 p-4">
          <div class="relative w-full aspect-[4/3] bg-brand-gray-100 overflow-hidden mb-6 flex items-center justify-center border border-brand-gray-200/50">
            <div class="text-brand-gray-400 flex flex-col items-center">
              <span class="text-xs uppercase tracking-widest font-semibold mb-2 text-brand-gray-500">Image Asset Pending</span>
              <span class="text-xs font-mono">Discovery Placeholder</span>
            </div>
          </div>
          <div class="flex-grow flex flex-col">
            <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 mb-2">[DEVELOPMENT PLACEHOLDER]</span>
            <h3 class="text-2xl font-medium text-brand-charcoal-900 mb-3">Black Sea Discovery</h3>
            <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm mb-6 line-clamp-3">
              An extended journey through lush valleys, historic monasteries, and vibrant coastlines.
            </p>
            <div class="mt-auto pt-4 border-t border-brand-gray-200/60">
              <a href="#" class="inline-block font-medium text-brand-charcoal-900 hover:text-brand-green-700 transition-colors uppercase tracking-widest text-sm">
                View Package &rarr;
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="bg-brand-green-900 py-16 lg:py-24 text-center text-white border-t border-brand-green-800">
    <div class="container-main max-w-2xl mx-auto flex flex-col items-center">
      <h2 class="text-3xl lg:text-5xl font-sans font-medium tracking-tight mb-6">Your Journey Starts Here.</h2>
      <p class="text-lg text-white/80 font-light leading-relaxed mb-10 max-w-xl">
        Tell us what you want to experience, and we'll help shape the right trip for you.
      </p>
      <%= link_to "Plan Your Trip", plan_your_trip_path, class: "inline-block px-10 py-4 bg-white text-brand-green-900 hover:bg-brand-gray-100 font-medium text-sm tracking-widest uppercase transition-colors" %>
    </div>
  </div>

</div>
