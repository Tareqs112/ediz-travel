<div class="bg-white min-h-screen border-t border-brand-gray-200/50">
  
  <!-- Hero Section -->
  <div class="pt-16 lg:pt-24 pb-12 lg:pb-16">
    <div class="container-main text-center max-w-4xl mx-auto">
      <div class="mb-6 inline-flex items-center justify-center gap-4">
        <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
        <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase">Trabzon Airport</span>
        <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.1] mb-6">
        A Smooth Start to Your Journey.
      </h1>
      <p class="text-lg lg:text-xl text-brand-charcoal-600 font-light leading-relaxed mb-10 max-w-3xl mx-auto">
        Begin and end your time in the Eastern Black Sea with ease. We provide comfortable, private transfers directly between Trabzon Airport and your accommodation.
      </p>
      <div class="flex justify-center">
        <%= link_to "Plan Your Transfer", plan_your_trip_path, class: "inline-block px-10 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors" %>
      </div>
    </div>
  </div>

  <!-- Image Placeholder -->
  <div class="container-main mb-16 lg:mb-24">
    <div class="w-full aspect-[16/9] lg:aspect-[21/9] bg-[#faf9f6] flex flex-col items-center justify-center text-brand-gray-400 border border-brand-gray-200/50">
      <svg class="w-12 h-12 mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
      </svg>
      <span class="text-xs uppercase tracking-widest font-semibold mb-2">Image Asset Pending</span>
      <span class="text-xs font-mono">Airport Transfer</span>
    </div>
  </div>

  <!-- Service Highlights -->
  <div class="bg-[#faf9f6] py-16 lg:py-24 border-y border-brand-gray-200/60">
    <div class="container-main">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 divide-y sm:divide-y-0 lg:divide-x divide-brand-gray-200/60">
        
        <div class="pt-8 sm:pt-0 sm:px-4 lg:px-8 text-center flex flex-col items-center">
          <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3">Private Transfer</h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            Dedicated vehicles reserved exclusively for you and your travel companions.
          </p>
        </div>
        
        <div class="pt-8 sm:pt-0 sm:px-4 lg:px-8 text-center flex flex-col items-center lg:border-l lg:border-brand-gray-200/60">
          <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3">Hotel Pickup</h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            Seamless connection directly to or from your chosen accommodation.
          </p>
        </div>
        
        <div class="pt-8 sm:pt-0 sm:px-4 lg:px-8 text-center flex flex-col items-center sm:border-t sm:border-brand-gray-200/60 lg:border-t-0 lg:border-l lg:border-brand-gray-200/60">
          <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3">Comfortable Vehicles</h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            Well-maintained, spacious seating ensuring a relaxing ride after your flight.
          </p>
        </div>
        
        <div class="pt-8 sm:pt-0 sm:px-4 lg:px-8 text-center flex flex-col items-center sm:border-t sm:border-brand-gray-200/60 lg:border-t-0 lg:border-l lg:border-brand-gray-200/60">
          <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3">Professional Service</h3>
          <p class="text-brand-charcoal-600 font-light leading-relaxed text-sm">
            Experienced, polite drivers dedicated to a safe and smooth journey.
          </p>
        </div>

      </div>
    </div>
  </div>

  <!-- Simple Transfer Flow -->
  <div class="py-16 lg:py-24 bg-white border-b border-brand-gray-200/50">
    <div class="container-main max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4 text-center">
        
        <div class="flex flex-col items-center w-32">
          <div class="w-14 h-14 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-4">1</div>
          <span class="text-lg font-medium text-brand-charcoal-900">Airport</span>
        </div>
        
        <div class="hidden md:block flex-grow h-[1px] bg-brand-gray-200/60 relative top-[-1.5rem]"></div>
        <div class="md:hidden w-[1px] h-10 bg-brand-gray-200/60"></div>
        
        <div class="flex flex-col items-center w-32">
          <div class="w-14 h-14 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-4">2</div>
          <span class="text-lg font-medium text-brand-charcoal-900">Pickup</span>
        </div>
        
        <div class="hidden md:block flex-grow h-[1px] bg-brand-gray-200/60 relative top-[-1.5rem]"></div>
        <div class="md:hidden w-[1px] h-10 bg-brand-gray-200/60"></div>

        <div class="flex flex-col items-center w-32">
          <div class="w-14 h-14 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-4">3</div>
          <span class="text-lg font-medium text-brand-charcoal-900">Journey</span>
        </div>
        
        <div class="hidden md:block flex-grow h-[1px] bg-brand-gray-200/60 relative top-[-1.5rem]"></div>
        <div class="md:hidden w-[1px] h-10 bg-brand-gray-200/60"></div>

        <div class="flex flex-col items-center w-32">
          <div class="w-14 h-14 rounded-full bg-brand-green-50 flex items-center justify-center text-brand-green-700 font-medium text-xl mb-4">4</div>
          <span class="text-lg font-medium text-brand-charcoal-900">Destination</span>
        </div>

      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="bg-brand-green-900 py-16 lg:py-24 text-center text-white border-t border-brand-green-800">
    <div class="container-main max-w-2xl mx-auto">
      <h2 class="text-3xl lg:text-5xl font-sans font-medium tracking-tight mb-8">Arrive Relaxed.</h2>
      <%= link_to "Plan Your Transfer", plan_your_trip_path, class: "inline-block px-10 py-4 bg-white text-brand-green-900 hover:bg-brand-gray-100 font-medium text-sm tracking-widest uppercase transition-colors" %>
    </div>
  </div>

</div>
