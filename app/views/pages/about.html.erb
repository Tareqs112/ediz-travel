<% content_for :title, t("about.page_title") %>
<% content_for :meta_description, t("about.description") %>

<div class="bg-white min-h-screen">
  
  <div class="pt-16 lg:pt-24 pb-16 lg:pb-32">
    <div class="container-main max-w-4xl">
      <%= render "shared/components/section_heading",
                 eyebrow: t("about.eyebrow"),
                 title: t("about.title"),
                 description: t("about.description"),
                 as_h1: true %>
    </div>
    
    <div class="container-main mt-8 lg:mt-12">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-24">
        <div>
          <h2 class="text-3xl font-medium text-brand-charcoal-900 tracking-tight mb-6"><%= t("about.mission_title") %></h2>
          <p class="text-base lg:text-lg text-brand-charcoal-600 font-light leading-relaxed mb-6">
            <%= t("about.mission_desc") %>
          </p>
        </div>
        <div>
          <h2 class="text-3xl font-medium text-brand-charcoal-900 tracking-tight mb-6"><%= t("about.why_choose_us") %></h2>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <span class="text-brand-gold-500 mt-1"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              <div>
                <strong class="block text-brand-charcoal-900 font-medium mb-1"><%= t("about.local_expertise") %></strong>
                <span class="text-brand-charcoal-600 font-light"><%= t("about.local_expertise_desc") %></span>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-brand-gold-500 mt-1"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              <div>
                <strong class="block text-brand-charcoal-900 font-medium mb-1"><%= t("about.tursab_licensed") %></strong>
                <span class="text-brand-charcoal-600 font-light"><%= t("about.tursab_licensed_desc") %></span>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-brand-gold-500 mt-1"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              <div>
                <strong class="block text-brand-charcoal-900 font-medium mb-1"><%= t("about.tailored_experiences") %></strong>
                <span class="text-brand-charcoal-600 font-light"><%= t("about.tailored_experiences_desc") %></span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  
  <!-- CTA Section -->
  <div class="bg-brand-green-900 py-10 lg:py-24 text-center text-white border-t border-brand-green-800">
    <div class="container-main max-w-2xl mx-auto flex flex-col items-center">
      <h2 class="text-2xl lg:text-4xl font-sans font-medium tracking-tight mb-8"><%= t("about.ready_to_explore") %></h2>
      <%= link_to t("about.plan_your_trip"), plan_your_trip_path, class: "inline-block px-10 py-4 bg-white text-brand-green-900 hover:bg-brand-gray-100 font-medium text-sm tracking-widest uppercase transition-colors" %>
    </div>
  </div>

</div>
