<div class="bg-white min-h-screen">
  
  <div class="pt-16 lg:pt-24 pb-16 lg:pb-32">
    <div class="container-main max-w-4xl">
      <%= render "shared/components/section_heading",
                 eyebrow: "About Us",
                 title: "Our Story",
                 description: "61 EDİZ TRAVEL was founded to share the profound beauty, culture, and hospitality of Trabzon and the Eastern Black Sea with the world." %>
    </div>
    
    <div class="container-main mt-8">
      <div class="relative w-full aspect-[21/9] bg-brand-gray-100 flex items-center justify-center border border-brand-gray-200/50 mb-16 lg:mb-24">
        <span class="text-brand-gray-400 text-xs uppercase tracking-widest font-semibold">Hero Image Pending</span>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 lg:gap-24">
        <div>
          <h2 class="text-3xl font-medium text-brand-charcoal-900 tracking-tight mb-6">Our Mission</h2>
          <p class="text-lg text-brand-charcoal-600 font-light leading-relaxed mb-6">
            We aim to deliver premium, carefully tailored travel experiences that connect our guests with the authentic spirit of the Black Sea. 
            By prioritizing comfort, flexibility, and local expertise, we ensure every journey is memorable.
          </p>
        </div>
        <div>
          <h2 class="text-3xl font-medium text-brand-charcoal-900 tracking-tight mb-6">Why Choose Us?</h2>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <span class="text-brand-gold-500 mt-1"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              <div>
                <strong class="block text-brand-charcoal-900 font-medium mb-1">Local Expertise</strong>
                <span class="text-brand-charcoal-600 font-light">Deep roots in Trabzon with unparalleled regional knowledge.</span>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-brand-gold-500 mt-1"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              <div>
                <strong class="block text-brand-charcoal-900 font-medium mb-1">TÜRSAB Licensed</strong>
                <span class="text-brand-charcoal-600 font-light">A certified travel agency ensuring safety and professionalism (No: 15956).</span>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-brand-gold-500 mt-1"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              <div>
                <strong class="block text-brand-charcoal-900 font-medium mb-1">Tailored Experiences</strong>
                <span class="text-brand-charcoal-600 font-light">Flexible itineraries designed around your specific interests.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  
  <!-- CTA Section -->
  <div class="bg-brand-green-900 py-16 lg:py-24 text-center text-white border-t border-brand-green-800">
    <div class="container-main max-w-2xl mx-auto flex flex-col items-center">
      <h2 class="text-3xl lg:text-4xl font-sans font-medium tracking-tight mb-8">Ready to explore?</h2>
      <%= link_to "Plan Your Trip", plan_your_trip_path, class: "inline-block px-10 py-4 bg-white text-brand-green-900 hover:bg-brand-gray-100 font-medium text-sm tracking-widest uppercase transition-colors" %>
    </div>
  </div>

</div>
