<div class="bg-white min-h-screen border-t border-brand-gray-200/50">
  <div class="container-main py-16 lg:py-24">
    
    <!-- Intro Block -->
    <div class="max-w-3xl mb-16 lg:mb-20">
      <div class="mb-6 inline-flex items-center gap-4">
        <span class="w-12 h-[1px] bg-brand-gold-500 opacity-80"></span>
        <span class="text-brand-gold-500 font-semibold tracking-[0.2em] text-xs sm:text-sm uppercase">Plan Your Journey</span>
      </div>
      <h1 class="text-4xl lg:text-5xl font-sans font-medium text-brand-charcoal-900 tracking-tight leading-[1.1] mb-6">
        Let's Plan Your Trip.
      </h1>
      <p class="text-lg text-brand-charcoal-600 font-light leading-relaxed max-w-2xl">
        Tell us about your trip and the experiences you are looking for across Trabzon and the Eastern Black Sea.
      </p>
    </div>

    <!-- Main Layout -->
    <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">
      
      <!-- Left: Form -->
      <div class="w-full lg:w-2/3">
        <%= form_with url: "#", method: :post, class: "space-y-10" do |f| %>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Full Name -->
            <div class="flex flex-col">
              <%= f.label :full_name, "Full Name", class: "text-sm font-medium text-brand-charcoal-900 mb-2" %>
              <%= f.text_field :full_name, class: "w-full border-b border-brand-gray-200 py-3 px-0 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-green-700 transition-colors placeholder:text-brand-gray-300 font-light", placeholder: "e.g. Jane Doe" %>
            </div>

            <!-- Email -->
            <div class="flex flex-col">
              <%= f.label :email, "Email Address", class: "text-sm font-medium text-brand-charcoal-900 mb-2" %>
              <%= f.email_field :email, class: "w-full border-b border-brand-gray-200 py-3 px-0 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-green-700 transition-colors placeholder:text-brand-gray-300 font-light", placeholder: "e.g. jane@example.com" %>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Travel Date -->
            <div class="flex flex-col">
              <%= f.label :travel_date, "Travel Date", class: "text-sm font-medium text-brand-charcoal-900 mb-2" %>
              <%= f.date_field :travel_date, class: "w-full border-b border-brand-gray-200 py-3 px-0 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-green-700 transition-colors font-light" %>
            </div>

            <!-- Number of Travelers -->
            <div class="flex flex-col">
              <%= f.label :travelers, "Number of Travelers", class: "text-sm font-medium text-brand-charcoal-900 mb-2" %>
              <%= f.number_field :travelers, min: 1, class: "w-full border-b border-brand-gray-200 py-3 px-0 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-green-700 transition-colors placeholder:text-brand-gray-300 font-light", placeholder: "e.g. 2" %>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Preferred Language -->
            <div class="flex flex-col">
              <%= f.label :language, "Preferred Language", class: "text-sm font-medium text-brand-charcoal-900 mb-2" %>
              <%= f.select :language, ["English", "Arabic", "Turkish"], { prompt: "Select language" }, class: "w-full border-b border-brand-gray-200 py-3 px-0 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-green-700 transition-colors font-light appearance-none" %>
            </div>

            <!-- Trip Type -->
            <div class="flex flex-col">
              <%= f.label :trip_type, "Trip Type", class: "text-sm font-medium text-brand-charcoal-900 mb-2" %>
              <%= f.select :trip_type, ["Private Tour", "Airport Transfer", "Custom Trip", "Travel Package"], { prompt: "Select trip type" }, class: "w-full border-b border-brand-gray-200 py-3 px-0 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-green-700 transition-colors font-light appearance-none" %>
            </div>
          </div>

          <!-- Destinations -->
          <div class="flex flex-col">
            <%= f.label :destinations, "Destinations / Places You Want to Visit", class: "text-sm font-medium text-brand-charcoal-900 mb-2" %>
            <%= f.text_area :destinations, rows: 2, class: "w-full border-b border-brand-gray-200 py-3 px-0 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-green-700 transition-colors placeholder:text-brand-gray-300 font-light resize-none", placeholder: "Tell us what you'd like to see..." %>
          </div>

          <!-- Additional Notes -->
          <div class="flex flex-col">
            <%= f.label :notes, "Additional Notes", class: "text-sm font-medium text-brand-charcoal-900 mb-2" %>
            <%= f.text_area :notes, rows: 4, class: "w-full border-b border-brand-gray-200 py-3 px-0 bg-transparent text-brand-charcoal-900 focus:outline-none focus:border-brand-green-700 transition-colors placeholder:text-brand-gray-300 font-light resize-none", placeholder: "Any special requirements or questions?" %>
          </div>

          <!-- Submit Button -->
          <div class="pt-6">
            <%= f.submit "Send Inquiry", class: "inline-block px-10 py-4 bg-brand-charcoal-900 hover:bg-brand-green-800 text-white font-medium text-sm tracking-widest uppercase transition-colors cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <!-- Right: Side Panel -->
      <div class="w-full lg:w-1/3">
        <div class="sticky top-32">
          <div class="bg-[#faf9f6] border border-brand-gray-200/60 p-8 lg:p-10 flex flex-col">
            <h3 class="text-xl font-medium text-brand-charcoal-900 mb-4">Travel Your Way</h3>
            <p class="text-brand-charcoal-600 font-light leading-relaxed mb-8">
              Whether you are looking for a perfectly planned private tour or a fully customized itinerary shaped around your pace, our travel specialists are here to design an experience unique to you.
            </p>
            <div class="border-t border-brand-gray-200/60 pt-6">
              <span class="text-xs uppercase tracking-widest font-semibold text-brand-gold-500 block mb-2">Need immediate assistance?</span>
              <p class="text-sm text-brand-charcoal-500 font-light">Please submit your inquiry, and we will follow up with direct contact options.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
