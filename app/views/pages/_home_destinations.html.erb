<section class="bg-[#faf9f6] py-24 lg:py-32 border-t border-brand-gray-200/50">
  <div class="container-main">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16 lg:mb-24">
      <%= render "shared/components/section_heading", 
                 eyebrow: "Explore The Region", 
                 title: "Places Worth Discovering", 
                 description: "Discover the landscapes, mountains, lakes, valleys, and cultural landmarks that make the Eastern Black Sea unforgettable." %>
      <div class="hidden md:block pb-2">
        <%= link_to "View All Destinations &rarr;".html_safe, destinations_path, class: "inline-block font-medium text-brand-gold-500 hover:text-brand-gold-600 transition-colors uppercase tracking-widest text-sm" %>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Destination 1 -->
      <a href="/destinations/uzungol" class="group relative block aspect-[3/4] overflow-hidden bg-brand-charcoal-900">
        <div class="absolute inset-0 bg-brand-gray-200 flex flex-col items-center justify-center text-brand-gray-400">
          <span class="text-xs uppercase tracking-widest font-semibold mb-2">Image Pending</span>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal-900/90 via-brand-charcoal-900/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full p-6">
          <span class="text-xs font-semibold text-brand-gold-500 uppercase tracking-widest block mb-1 transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">Çaykara, Trabzon</span>
          <h3 class="text-2xl font-medium text-white transform group-hover:-translate-y-1 transition-transform duration-500">Uzungöl</h3>
        </div>
      </a>
      
      <!-- Destination 2 -->
      <a href="/destinations/sumela" class="group relative block aspect-[3/4] overflow-hidden bg-brand-charcoal-900">
        <div class="absolute inset-0 bg-brand-gray-200 flex flex-col items-center justify-center text-brand-gray-400">
          <span class="text-xs uppercase tracking-widest font-semibold mb-2">Image Pending</span>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal-900/90 via-brand-charcoal-900/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full p-6">
          <span class="text-xs font-semibold text-brand-gold-500 uppercase tracking-widest block mb-1 transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">Maçka, Trabzon</span>
          <h3 class="text-2xl font-medium text-white transform group-hover:-translate-y-1 transition-transform duration-500">Sümela</h3>
        </div>
      </a>
      
      <!-- Destination 3 -->
      <a href="/destinations/ayder" class="group relative block aspect-[3/4] overflow-hidden bg-brand-charcoal-900">
        <div class="absolute inset-0 bg-brand-gray-200 flex flex-col items-center justify-center text-brand-gray-400">
          <span class="text-xs uppercase tracking-widest font-semibold mb-2">Image Pending</span>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal-900/90 via-brand-charcoal-900/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full p-6">
          <span class="text-xs font-semibold text-brand-gold-500 uppercase tracking-widest block mb-1 transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">Çamlıhemşin, Rize</span>
          <h3 class="text-2xl font-medium text-white transform group-hover:-translate-y-1 transition-transform duration-500">Ayder</h3>
        </div>
      </a>
      
      <!-- Destination 4 -->
      <a href="/destinations/trabzon" class="group relative block aspect-[3/4] overflow-hidden bg-brand-charcoal-900">
        <div class="absolute inset-0 bg-brand-gray-200 flex flex-col items-center justify-center text-brand-gray-400">
          <span class="text-xs uppercase tracking-widest font-semibold mb-2">Image Pending</span>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal-900/90 via-brand-charcoal-900/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full p-6">
          <span class="text-xs font-semibold text-brand-gold-500 uppercase tracking-widest block mb-1 transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">City Center</span>
          <h3 class="text-2xl font-medium text-white transform group-hover:-translate-y-1 transition-transform duration-500">Trabzon</h3>
        </div>
      </a>
    </div>
    
    <div class="mt-10 md:hidden text-center">
      <%= link_to "View All Destinations &rarr;".html_safe, destinations_path, class: "inline-block font-medium text-brand-gold-500 hover:text-brand-gold-600 transition-colors uppercase tracking-widest text-sm" %>
    </div>
  </div>
</section>
