<section class="bg-white py-24 lg:py-32 border-t border-brand-gray-200/50">
  <div class="container-main">
    <%= render "shared/components/section_heading",
               center: true,
               eyebrow: "Our Guests",
               title: "Experiences to Remember",
               description: "See what our travelers say about their journeys through the Eastern Black Sea." %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      
      <!-- Testimonial 1 -->
      <div class="p-8 border border-brand-gray-200/60 bg-[#faf9f6]">
        <div class="flex text-brand-gold-500 mb-6">
          <% 5.times do %>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          <% end %>
        </div>
        <p class="text-brand-charcoal-600 font-light leading-relaxed mb-8">
          "The private tour to Uzungöl was perfectly arranged. Our driver was professional, and we could enjoy the scenery completely at our own pace."
        </p>
        <div>
          <p class="font-medium text-brand-charcoal-900 text-sm uppercase tracking-widest">Sarah M.</p>
          <p class="text-brand-charcoal-600 text-sm font-light">Family Trip</p>
        </div>
      </div>

      <!-- Testimonial 2 -->
      <div class="p-8 border border-brand-gray-200/60 bg-[#faf9f6]">
        <div class="flex text-brand-gold-500 mb-6">
          <% 5.times do %>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          <% end %>
        </div>
        <p class="text-brand-charcoal-600 font-light leading-relaxed mb-8">
          "From airport pickup to our departure, 61 EDİZ TRAVEL took care of every detail. Highly recommended for exploring Trabzon."
        </p>
        <div>
          <p class="font-medium text-brand-charcoal-900 text-sm uppercase tracking-widest">Ahmed K.</p>
          <p class="text-brand-charcoal-600 text-sm font-light">Private Transfer</p>
        </div>
      </div>

      <!-- Testimonial 3 -->
      <div class="p-8 border border-brand-gray-200/60 bg-[#faf9f6]">
        <div class="flex text-brand-gold-500 mb-6">
          <% 5.times do %>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          <% end %>
        </div>
        <p class="text-brand-charcoal-600 font-light leading-relaxed mb-8">
          "An unforgettable journey through Ayder. The vehicle was exceptionally comfortable, and the itinerary was flawless."
        </p>
        <div>
          <p class="font-medium text-brand-charcoal-900 text-sm uppercase tracking-widest">Elena R.</p>
          <p class="text-brand-charcoal-600 text-sm font-light">Custom Package</p>
        </div>
      </div>
    </div>
    
  </div>
</section>
