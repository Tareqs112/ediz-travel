<div class="bg-[#faf9f6] min-h-screen">
  
  <div class="pt-16 lg:pt-24 pb-16 border-b border-brand-gray-200/50">
    <div class="container-main max-w-4xl">
      <%= render "shared/components/section_heading",
                 eyebrow: "Help Center",
                 title: "Frequently Asked Questions",
                 description: "Find answers to common questions about our tours, booking process, and travel policies." %>
    </div>
  </div>

  <div class="container-main py-16 lg:py-24">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <!-- Category 1 -->
      <div>
        <h2 class="text-2xl font-medium text-brand-charcoal-900 tracking-tight mb-8">Tours & Activities</h2>
        <div class="space-y-4">
          <div class="bg-white border border-brand-gray-200 p-6">
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-3">Are your tours private or shared?</h3>
            <p class="text-brand-charcoal-600 font-light leading-relaxed">We specialize in private tours tailored to your group, but we also offer select shared group experiences. You can specify your preference when requesting a booking.</p>
          </div>
          <div class="bg-white border border-brand-gray-200 p-6">
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-3">What languages do your guides speak?</h3>
            <p class="text-brand-charcoal-600 font-light leading-relaxed">We currently offer services in English, Arabic, and Turkish. Please let us know your preferred language so we can arrange the right guide for your journey.</p>
          </div>
        </div>
      </div>

      <!-- Category 2 -->
      <div>
        <h2 class="text-2xl font-medium text-brand-charcoal-900 tracking-tight mb-8">Booking & Payments</h2>
        <div class="space-y-4">
          <div class="bg-white border border-brand-gray-200 p-6">
            <h3 class="text-lg font-medium text-brand-charcoal-900 mb-3">How do I book a tour?</h3>
            <p class="text-brand-charcoal-600 font-light leading-relaxed">You can browse our tours and submit a booking request. Our team will review your request, confirm availability, and send you a secure payment link or instructions.</p>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>
