<% content_for :title, t("faq.page_title") %>
<% content_for :meta_description, t("faq.description") %>
<% content_for :head do %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "<%= j t('faq.q1') %>",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "<%= j t('faq.a1') %>"
        }
      },
      {
        "@type": "Question",
        "name": "<%= j t('faq.q2') %>",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "<%= j t('faq.a2') %>"
        }
      },
      {
        "@type": "Question",
        "name": "<%= j t('faq.q3') %>",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "<%= j t('faq.a3') %>"
        }
      }
    ]
  }
  </script>
<% end %>

<div class="bg-[#faf9f6] min-h-screen">
  
  <div class="pt-16 lg:pt-24 pb-16 border-b border-brand-gray-200/50">
    <div class="container-main max-w-4xl">
      <%= render "shared/components/section_heading",
                 eyebrow: t("faq.eyebrow"),
                 title: t("faq.title"),
                 description: t("faq.description"),
                 as_h1: true %>
    </div>
  </div>

  <div class="container-main py-10 lg:py-24">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <!-- Category 1 -->
      <div>
        <h2 class="text-2xl font-medium text-brand-charcoal-900 tracking-tight mb-8"><%= t("faq.category_1") %></h2>
        <div class="space-y-4">
          <details class="bg-white border border-brand-gray-200 group [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-medium text-brand-charcoal-900 text-lg">
              <span><%= t("faq.q1") %></span>
              <span class="transition duration-300 group-open:-rotate-180">
                <svg class="w-5 h-5 text-brand-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-brand-charcoal-600 font-light leading-relaxed border-t border-brand-gray-100 mt-2 pt-4">
              <%= t("faq.a1") %>
            </div>
          </details>

          <details class="bg-white border border-brand-gray-200 group [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-medium text-brand-charcoal-900 text-lg">
              <span><%= t("faq.q2") %></span>
              <span class="transition duration-300 group-open:-rotate-180">
                <svg class="w-5 h-5 text-brand-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-brand-charcoal-600 font-light leading-relaxed border-t border-brand-gray-100 mt-2 pt-4">
              <%= t("faq.a2") %>
            </div>
          </details>
        </div>
      </div>

      <!-- Category 2 -->
      <div>
        <h2 class="text-2xl font-medium text-brand-charcoal-900 tracking-tight mb-8"><%= t("faq.category_2") %></h2>
        <div class="space-y-4">
          <details class="bg-white border border-brand-gray-200 group [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-medium text-brand-charcoal-900 text-lg">
              <span><%= t("faq.q3") %></span>
              <span class="transition duration-300 group-open:-rotate-180">
                <svg class="w-5 h-5 text-brand-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-brand-charcoal-600 font-light leading-relaxed border-t border-brand-gray-100 mt-2 pt-4">
              <%= t("faq.a3") %>
            </div>
          </details>
        </div>
      </div>

      <!-- Still have questions CTA -->
      <div class="border-t border-brand-gray-200/60 pt-12 text-center">
        <h3 class="text-xl font-medium text-brand-charcoal-900 mb-3"><%= t("faq.have_question_title") %></h3>
        <p class="text-brand-charcoal-600 font-light mb-6"><%= t("faq.have_question_desc") %></p>
        <div class="flex justify-center gap-4 flex-wrap">
          <%= link_to t("faq.contact_us"), contact_path, class: "btn-primary" %>
          <%= link_to t("faq.plan_your_trip"), plan_your_trip_path, class: "px-6 py-3 border border-brand-charcoal-900 text-brand-charcoal-900 font-medium text-sm tracking-widest uppercase hover:bg-brand-charcoal-900 hover:text-white transition" %>
        </div>
      </div>
      
    </div>
  </div>
</div>
