<!DOCTYPE html>
<html lang="en" class="h-full antialiased bg-gray-50">
  <head>
    <title>Admin - 61 EDİZ TRAVEL</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="flex min-h-screen font-sans text-gray-900 bg-gray-100">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-gray-900 text-white flex-shrink-0 flex flex-col">
      <div class="h-16 flex items-center px-6 border-b border-gray-800">
        <span class="text-lg font-bold tracking-widest text-brand-gold-500 uppercase">EDIZ Admin</span>
      </div>
      <nav class="flex-1 overflow-y-auto py-4">
        <ul class="space-y-1 px-3">
          <li><a href="/admin" class="block px-3 py-2 rounded-md hover:bg-gray-800 transition">Dashboard</a></li>
          <li><a href="/admin/tours" class="block px-3 py-2 rounded-md hover:bg-gray-800 transition">Tours</a></li>
          <li><a href="/admin/destinations" class="block px-3 py-2 rounded-md hover:bg-gray-800 transition">Destinations</a></li>
          <li><a href="/admin/bookings" class="block px-3 py-2 rounded-md hover:bg-gray-800 transition">Bookings</a></li>
          <li><a href="/admin/customers" class="block px-3 py-2 rounded-md hover:bg-gray-800 transition">Customers</a></li>
        </ul>
      </nav>
      <div class="p-4 border-t border-gray-800 text-sm">
        <a href="/" class="text-gray-400 hover:text-white">&larr; Back to Website</a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-8">
        <h1 class="text-xl font-semibold text-gray-800"><%= content_for(:title) || "Dashboard" %></h1>
        <div class="flex items-center gap-4">
          <span class="text-sm font-medium text-gray-600">Admin User</span>
        </div>
      </header>
      
      <main class="flex-1 overflow-y-auto p-8 bg-gray-50">
        <div class="max-w-7xl mx-auto">
          <%= yield %>
        </div>
      </main>
    </div>

  </body>
</html>
