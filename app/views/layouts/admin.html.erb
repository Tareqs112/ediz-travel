<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>" class="h-full antialiased bg-gray-50">
  <head>
    <title>Admin - 61 EDİZ TRAVEL</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="flex min-h-screen font-sans text-gray-900 bg-gray-100" data-controller="sidebar">

    <%# Mobile overlay backdrop %>
    <div data-sidebar-target="overlay"
         class="hidden fixed inset-0 z-20 bg-black/50 md:hidden"
         data-action="click->sidebar#close"></div>

    <%# Sidebar — off-screen on mobile by default, always visible md+ %>
    <aside data-sidebar-target="sidebar"
           class="fixed inset-y-0 start-0 z-30 w-64 bg-gray-900 text-white flex-shrink-0 flex flex-col
                  transform <%= rtl? ? 'translate-x-full' : '-translate-x-full' %> transition-transform duration-200 ease-in-out
                  md:relative md:translate-x-0 md:transform-none md:transition-none">
      <div class="h-16 flex items-center px-6 border-b border-gray-800">
        <span class="text-lg font-bold tracking-widest text-brand-gold-500 uppercase">EDIZ Admin</span>
      </div>
      <nav class="flex-1 overflow-y-auto py-4">
        <ul class="space-y-1 px-3">
          <li><%= link_to "Dashboard", admin_root_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md hover:bg-gray-800 transition #{current_page?(admin_root_path) ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "⚡ Quick Booking", new_admin_quick_booking_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/quick_bookings') ? 'bg-brand-gold-500 text-gray-900 font-bold' : 'text-brand-gold-400 hover:bg-gray-800 font-bold'}" %></li>
          <li><%= link_to "Daily Operations", admin_operations_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/operations') ? 'bg-gray-800 text-white font-semibold' : 'text-gray-400 hover:bg-gray-800 font-medium'}" %></li>
          <li><%= link_to "Tours", admin_tours_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/tours') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Packages", admin_packages_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/packages') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Accommodations", admin_accommodations_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/accommodations') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Travel Guides", admin_travel_guides_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/travel_guides') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Customers", admin_customers_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/customers') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Bookings", admin_bookings_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/bookings') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Drivers", admin_drivers_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/drivers') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Fleet (Operational)", admin_vehicles_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/vehicles') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Commercial Vehicles", admin_commercial_vehicles_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/commercial_vehicles') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Destinations", admin_destinations_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/destinations') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Booking Requests", admin_booking_requests_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/booking_requests') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Trip Inquiries", admin_trip_inquiries_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/trip_inquiries') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Contact Messages", admin_contact_messages_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/contact_messages') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
        </ul>
        <div class="mt-8 mb-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">System</div>
        <ul class="space-y-1 px-3">
          <li><%= link_to "Business Information", edit_admin_business_setting_path, data: { action: "click->sidebar#close" }, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/business_setting') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
        </ul>
      </nav>
      <div class="p-4 border-t border-gray-800 text-sm">
        <a href="/" class="text-gray-400 hover:text-white">&larr; Back to Website</a>
      </div>
    </aside>

    <%# Main Content Area %>
    <div class="flex-1 flex flex-col overflow-hidden min-w-0">
      <header class="h-14 md:h-16 bg-white border-b border-gray-200 flex items-center justify-between px-4 md:px-8 flex-shrink-0">
        <%# Hamburger — mobile only %>
        <button class="md:hidden p-2 -ms-2 rounded-md text-gray-600 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-green-500"
                aria-label="Open menu"
                data-action="click->sidebar#toggle">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>

        <h1 class="text-base md:text-xl font-semibold text-gray-800 truncate mx-2 md:mx-0"><%= content_for(:title) || "Dashboard" %></h1>

        <div class="flex items-center gap-2 md:gap-4 flex-shrink-0">
          <span class="hidden sm:block text-sm font-medium text-gray-600"><%= Current.user&.email_address || "Admin User" %></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "text-sm text-brand-charcoal-600 hover:text-brand-charcoal-900 font-medium" %>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-4 md:p-8 bg-gray-50">
        <div class="max-w-7xl mx-auto mb-4">
          <% flash.each do |key, message| %>
            <div class="p-4 rounded-md <%= key.to_s == 'notice' ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800' %>">
              <%= message %>
            </div>
          <% end %>
        </div>
        <div class="max-w-7xl mx-auto">
          <%= yield %>
        </div>
      </main>
    </div>

  </body>
</html>
