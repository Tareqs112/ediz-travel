<!DOCTYPE html>
<html lang="en" class="h-full antialiased bg-gray-50">
  <head>
    <title>Admin - 61 EDİZ TRAVEL</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="flex min-h-screen font-sans text-gray-900 bg-gray-100">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-gray-900 text-white flex-shrink-0 flex flex-col">
      <div class="h-16 flex items-center px-6 border-b border-gray-800">
        <span class="text-lg font-bold tracking-widest text-brand-gold-500 uppercase">EDIZ Admin</span>
      </div>
      <nav class="flex-1 overflow-y-auto py-4">
        <ul class="space-y-1 px-3">
          <li><%= link_to "Dashboard", admin_root_path, class: "block px-3 py-2 rounded-md hover:bg-gray-800 transition #{current_page?(admin_root_path) ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Tours", admin_tours_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/tours') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Packages", admin_packages_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/packages') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Accommodations", admin_accommodations_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/accommodations') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Travel Guides", admin_travel_guides_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/travel_guides') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Customers", admin_customers_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/customers') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Bookings", admin_bookings_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/bookings') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Drivers", admin_drivers_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/drivers') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Vehicles", admin_vehicles_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/vehicles') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Destinations", admin_destinations_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/destinations') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Booking Requests", admin_booking_requests_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/booking_requests') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Trip Inquiries", admin_trip_inquiries_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/trip_inquiries') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
          <li><%= link_to "Contact Messages", admin_contact_messages_path, class: "block px-3 py-2 rounded-md transition #{request.path.start_with?('/admin/contact_messages') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800'}" %></li>
        </ul>
      </nav>
      <div class="p-4 border-t border-gray-800 text-sm">
        <a href="/" class="text-gray-400 hover:text-white">&larr; Back to Website</a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-8">
        <h1 class="text-xl font-semibold text-gray-800"><%= content_for(:title) || "Dashboard" %></h1>
        <div class="flex items-center gap-4">
          <span class="text-sm font-medium text-gray-600"><%= Current.user&.email_address || "Admin User" %></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "text-sm text-brand-charcoal-600 hover:text-brand-charcoal-900 ms-4 font-medium" %>
        </div>
      </header>
      
      <main class="flex-1 overflow-y-auto p-8 bg-gray-50">
<div class="max-w-7xl mx-auto mb-4">
  <% flash.each do |key, message| %>
    <div class="p-4 rounded-md <%= key.to_s == 'notice' ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800' %>">
      <%= message %>
    </div>
  <% end %>
</div>
        <div class="max-w-7xl mx-auto">
          <%= yield %>
        </div>
      </main>
    </div>

  </body>
</html>
