<!DOCTYPE html>
<html lang="en" class="h-full antialiased bg-brand-gray-50">
  <head>
    <title>My Account - 61 EDİZ TRAVEL</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="flex flex-col min-h-screen font-sans text-brand-charcoal-900 bg-brand-gray-50">
    
    <%= render "shared/navbar" %>
    
    <div class="container-main py-12 flex-grow flex flex-col md:flex-row gap-8 lg:gap-12">
      <!-- Customer Sidebar -->
      <aside class="w-full md:w-64 flex-shrink-0">
        <nav class="bg-white border border-brand-gray-200 rounded-xl p-4 shadow-sm">
          <ul class="space-y-2">
            <li><a href="/account" class="block px-4 py-2.5 rounded-lg hover:bg-brand-gray-50 font-medium transition-colors">Dashboard</a></li>
            <li><a href="/account/bookings" class="block px-4 py-2.5 rounded-lg hover:bg-brand-gray-50 font-medium transition-colors">My Bookings</a></li>
            <li><a href="/account/profile" class="block px-4 py-2.5 rounded-lg hover:bg-brand-gray-50 font-medium transition-colors">Profile</a></li>
            <li><a href="/account/settings" class="block px-4 py-2.5 rounded-lg hover:bg-brand-gray-50 font-medium transition-colors">Settings</a></li>
          </ul>
        </nav>
      </aside>

      <!-- Customer Main Content -->
      <main class="flex-1">
        <%= yield %>
      </main>
    </div>

    <%= render "shared/footer" %>

  </body>
</html>
